{
 "schema": "vocabulary/1",
 "vocabulary": "1.0",
 "note": "The interaction contract of the lesson player (package web_os_live_player v5, 02 §10). Every verb here with implemented:true has a handler in player/animated_player.js and every handler is declared here; every event type the player emits is in events. A reserved verb answers not-supported. No verb writes the animation spec (A8).",
 "verbs": {
  "playback.play": {"implemented": true, "args": {}, "events": ["playback.state"]},
  "playback.pause": {"implemented": true, "args": {}, "events": ["playback.state"]},
  "playback.seek": {"implemented": true, "args": {"t": "number"}, "events": ["playback.state", "playback.time"]},
  "lesson.load": {"implemented": true, "args": {"source": "object", "params": "object?"}, "events": ["lifecycle"]},
  "params.set": {"implemented": true, "args": {"speech": "string?", "subs": "array?", "mode": "string?"}, "events": ["params.changed"]},
  "ui.set": {"implemented": true, "args": {"strips": "object?", "panes": "object?", "size": "string?"}, "events": ["ui.changed"]},
  "permissions.set": {"implemented": true, "args": {"ownAgent": "boolean?", "modelDownload": "boolean?", "localNetwork": "boolean?", "storage": "boolean?", "viewerCamera": "boolean?", "select": "boolean?", "exportPersonal": "boolean?"}, "events": ["permissions.changed"]},
  "camera.set": {"implemented": true, "args": {"view": "string?", "mode": "string?", "off": "array?", "yaw": "number?", "pitch": "number?", "zoom": "number?", "roll": "number?"}, "events": ["camera.changed"]},
  "camera.reset": {"implemented": true, "args": {}, "events": ["camera.changed"]},
  "lifecycle.suspend": {"implemented": true, "args": {}, "events": ["lifecycle"]},
  "lifecycle.resume": {"implemented": true, "args": {}, "events": ["lifecycle"]},
  "interaction.set": {"implemented": true, "args": {"select": "boolean"}, "events": ["interaction.changed"]},
  "scene.select": {"implemented": true, "args": {"subject": "object?", "point": "object?"}, "events": ["scene.selected", "scene.deselected"], "note": "kind object implemented; kind actor reserved (not-supported)"},
  "context.set": {"implemented": true, "args": {"user": "object?", "greet": "boolean?"}, "events": ["context.changed", "custom.changed"], "note": "an alias of custom.set"},
  "audio.set": {"implemented": true, "args": {"audible": "boolean?", "volume": "number?"}, "events": ["audio.changed"]},
  "custom.set": {"implemented": true, "args": {"values": "object", "enable": "array"}, "events": ["custom.changed"]},
  "custom.clear": {"implemented": true, "args": {"slots": "array?"}, "events": ["custom.changed"]},
  "custom.record": {"implemented": true, "args": {}, "events": []},
  "custom.apply": {"implemented": true, "args": {"record": "object"}, "events": ["custom.changed"]},
  "scene.highlight": {"implemented": false, "args": {"subject": "object", "on": "boolean"}, "events": ["scene.highlighted"], "note": "reserved: a view-layer effect"},
  "scene.focus": {"implemented": false, "args": {"subject": "object"}, "events": ["camera.changed"], "note": "reserved: frame a subject with the viewer camera"},
  "ask.question": {"implemented": false, "args": {"text": "string"}, "events": ["ask.answered"], "note": "reserved: the host asks through the AI pane"}
 },
 "events": ["lifecycle", "ui.changed", "params.changed", "permissions.changed", "camera.changed", "playback.state",
            "playback.time", "playback.ended", "view.hidden", "view.shown", "cue.line", "cue.card", "cue.shot", "error",
            "interaction.changed", "scene.selected", "scene.deselected", "context.changed", "custom.changed", "slot.shown",
            "greeting.shown", "audio.changed"],
 "reservedEvents": ["scene.highlighted", "surface.written", "ask.answered"],
 "subjects": ["actor", "object", "line", "card", "shot", "surface", "slot"],
 "errors": ["unknown-verb", "not-supported", "denied", "bad-args", "no-subject", "stale-record", "disposed"],
 "values": ["user.userId", "user.firstName", "user.lastName", "org.name"]
}
