dend", "10.0%", "10.0%"]], [["Item", "Data", "Answer"], ["Value of a bond", "4 years, 1,000 par, 5% coupon, required 6%; annuity factor 3.4651, PV factor 0.7921", "________"], ["Value of a preferred share", "Dividend 4.00, required 10%", "________"], ["Modified duration", "Macaulay 3.72 years, required return 6%", "________"], ["Price fall on a one-point rise", "On a price of 965.40", "________"], ["After-tax cost of a 7% bond", "Tax rate 25%", "________"], ["Refinancing payback", "Saves 90,000 a year after tax, costs 270,000 after tax", "________"]], [["English (exam term)", "العربية", "Français"], ["tax shield", "الوفر الضريبي", "économie d'impôt"], ["financial distress", "العسر المالي", "difficultés financières"], ["amortisation of issue costs", "إطفاء تكاليف الإصدار", "amortissement des frais d'émission"], ["after-tax cost", "التكلفة بعد الضريبة", "coût après impôt"]], [["Item", "Answer"], ["Value of a bond", "965.35: the coupons are 50 × 3.4651 = 173.26 and the principal 1,000 × 0.7921 = 792.10, so 173.26 + 792.10 = 965.36, which rounds to 965.35 on unrounded factors."], ["Value of a preferred share", "40.00: 4.00 ÷ 0.10 = 40.00."], ["Modified duration", "3.51: 3.72 ÷ 1.06 = 3.51."], ["Price fall on a one-point rise", "About 33.88: 965.40 × 0.0351 = 33.89, so the price falls to about 931.50."], ["After-tax cost of a 7% bond", "5.25 per cent: 7.0 × 0.75 = 5.25."], ["Refinancing payback", "3.00 years: 270,000 ÷ 90,000 = 3.00."], ["What it tells you", "Each line is the same idea in a different dress: money arriving later is worth less, and how much less depends on the rate. The refinancing is worth doing only if more than three years remain, and the bond loses about three and a half per cent of its value for every point rates rise."]]], "figures": {"F604-01": 0, "F604-02": 2, "F604-03": 4, "F604-04": 6, "F604-05": 8, "F604-06": 10, "F604-07": 11, "F604-08": 13}, "tsec": {"0": "", "1": "", "2": "4.1", "3": "4.1", "4": "4.2", "5": "4.2", "6": "4.3", "7": "4.3", "8":