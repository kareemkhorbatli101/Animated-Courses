 (exam term)", "العربية", "Français"], ["liquidity tranche", "شريحة السيولة", "tranche de liquidité"], ["matched instrument", "أداة مطابقة", "placement adossé"], ["overnight", "ليلة واحدة", "au jour le jour"], ["return on effort", "العائد على الجهد", "rendement de l'effort"]], [["Instrument", "Answer"], ["Treasury bill, period return", "1.52 per cent: the gain is 500,000 − 492,500 = 7,500, and 7,500 ÷ 492,500 = 1.52 per cent."], ["The same bill, annualised", "About 6.17 per cent: there are 365 ÷ 90 = 4.0556 periods in a year, and 1.52 × 4.0556 = 6.17 per cent."], ["Municipal, tax-equivalent yield", "4.80 per cent: 3.6 ÷ 0.75 = 4.80 per cent."], ["Commercial paper, after-tax yield", "3.825 per cent: 5.1 × 0.75 = 3.825 per cent."], ["Which to buy for a payment in 90 days", "The treasury bill: it matures exactly when the money is needed, carries no credit risk, and on these figures its annualised 6.17 per cent beats both alternatives on a comparable basis."], ["Return on a 4,402,100 surplus at 4 per cent", "176,084: 4,402,100 × 0.04 = 176,084."]]], "figures": {"F615-01": 0, "F615-02": 3, "F615-03": 5, "F615-04": 8, "F615-05": 10}, "tsec": {"0": "", "1": "", "2": "15.1", "3": "15.2", "4": "15.2", "5": "15.3", "6": "15.3", "7": "15.4", "8": "15.5", "9": "15.5", "10": "15.5"}}