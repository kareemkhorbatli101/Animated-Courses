":14.686,"text":{"en":"Four sentences. Each has exactly one mistake.","ar":"أربع جمل. في كلّ واحدة خطأ واحد بالضبط."},"id":"L003"},{"actor":"khaled","start":19.572,"text":{"en":"The oak table is more bigger than the pine one.","ar":"صحّح هذه الجملة: «The oak table is more bigger than the pine one.»"},"subHold":9.053,"id":"L004"},{"actor":"khaled","start":28.625,"text":{"en":"The oak table is bigger than the pine one. Never more with E-R.","ar":"The oak table is bigger than the pine one. لا تجمع more مع E-R أبداً."},"id":"L005"},{"actor":"khaled","start":33.727,"text":{"en":"This is the most cheapest sofa.","ar":"صحّح هذه الجملة: «This is the most cheapest sofa.»"},"subHold":7.463,"id":"L006"},{"actor":"khaled","start":41.19,"text":{"en":"This is the cheapest sofa. Never most with E-S-T.","ar":"This is the cheapest sofa. لا تجمع most مع E-S-T أبداً."},"id":"L007"},{"actor":"khaled","start":45.956,"text":{"en":"A wardrobe is taller that a cabinet.","ar":"صحّح هذه الجملة: «A wardrobe is taller that a cabinet.»"},"subHold":8.118,"id":"L008"},{"actor":"khaled","start":54.074,"text":{"en":"A wardrobe is taller than a cabinet. The word is than, not that.","ar":"A wardrobe is taller than a cabinet. الكلمة than وليست that."},"id":"L009"},{"actor":"khaled","start":59.488,"text":{"en":"Leather is expensiver than fabric.","ar":"صحّح هذه الجملة: «Leather is expensiver than fabric.»"},"subHold":7.856,"id":"L010"},{"actor":"khaled","start":67.344,"text":{"en":"Leather is more expensive than fabric. Expensive is too long for E-R.","ar":"Leather is more expensive than fabric. Expensive أطول من أن تأخذ E-R."},"id":"L011"},{"actor":"sami","start":73.286,"text":{"en":"Two mistakes were doubling: more with E-R, most with E-S-T.","ar":"خطآن كانا ازدواجاً: more مع E-R، و most مع E-S-T."},"id":"L012"},{"actor":"sami","start":78.316,"text":{"en":"Use one or the other. Never both.","ar":"استخدم واحدة أو الأخرى. لا الاثنتين أبداً."},"id":"L013"},{"actor":"sami","start":82.386,"text":{"en":"Now two questions. Which sentence is correct?","ar":"الآن سؤالان. أيّ جملة صحيحة؟"},"id":"L014"},{"actor":"sami","start":87.104,"text":{"en":"Which of the four on screen is correct?","ar":"أيّ جملة من الأربع على الشاشة صحيحة؟"},"subHold":8.366,"id":"L015"},{"actor":"sami","start":95.47,"text":{"en":"B. This chair is cheaper than that one.","ar":"ب. This chair is cheaper than that one."},"id":"L016"},{"actor":"sami","start":98.94,"text":{"en":"And which of these four is correct?","ar":"وأيّ جملة من هذه الأربع صحيحة؟"},"subHold":7.747,"id":"L017"},{"actor":"sami","start":106.687,"text":{"en":"C. It is the biggest wardrobe.","ar":"ج. It is the biggest wardrobe."},"id":"L018"},{"actor":"sami","start":109.941,"text":{"en":"Short word, E-R and E-S-T. Long word, more and most.","ar":"الكلمة القصيرة: E-R و E-S-T. الكلمة الطويلة: more و most."},"id":"L019"},{"actor":"sami","start":115.115,"text":{"en":"That is the whole rule.","ar":"تلك هي القاعدة كلّها."},"id":"L020"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"24304ca5f9bc6dab","bytes":40176,"sha":"3fcae9176d710c6c","address":"lines/24304ca5f9bc6dab.mp3"},{"key":"c3909604555750c0","bytes":41040,"sha":"7728cff7b2a8499c","address":"lines/c3909604555750c0.mp3"},{"key":"13718a1fc5711ca8","bytes":27216,"sha":"96f77a738e14a9af","address":"lines/13718a1fc5711ca8.mp3"},{"key":"81de9bb735559143","bytes":19728,"sha":"e3ad2c857bb7f510","address":"lines/81de9bb735559143.mp3"},{"key":"302b1a27378878e0","bytes":28512,"sha":"03a4178d8fdc97f4","address":"lines/302b1a27378878e0.mp3"},{"key":"bdf0aa9700118350","bytes":15840,"sha":"c5ebcb833d26034f","address":"lines/bdf0aa9700118350.mp3"},{"key":"3e53793e3af89004","bytes":26496,"sha":"57ab73ddf6007245","address":"lines/3e53793e3af89004.mp3"},{"key":"0cfd78c58a2b8150","bytes":18000,"sha":"7859770cbefd60bb","address":"lines/0cfd78c58a2b8150.mp3