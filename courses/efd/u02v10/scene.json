dur":1.944},{"i":0,"at":75.027,"dur":3.264},{"i":0,"at":82.292,"dur":1.968},{"i":0,"at":84.61,"dur":3.192},{"i":0,"at":91.802,"dur":1.968},{"i":0,"at":94.12,"dur":3.288},{"i":0,"at":101.525,"dur":1.872},{"i":1,"at":103.747,"dur":3.432},{"i":0,"at":107.529,"dur":3.576}],"speech":[{"actor":"nour","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 2, Materials and Wood.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الثانية، المواد والخشب."},"id":"L001"},{"actor":"nour","start":7.472,"text":{"en":"This is Part 3, Ordering from the Supplier. You will hear a manager order this month's materials.","ar":"هذا الجزء الثالث، الطلب من المورِّد. ستسمع مديرة تطلب موادّ هذا الشهر."},"id":"L002"},{"actor":"nour","start":15.07,"text":{"en":"What does a manager ask a supplier?","ar":"ماذا يسأل المدير المورِّد؟"},"id":"L003"},{"actor":"nour","start":18.372,"text":{"en":"This is Abu Fares. He brings our wood and our foam.","ar":"هذا أبو فارس. يجلب لنا خشبنا وإسفنجنا."},"id":"L004"},{"actor":"nour","start":23.57,"text":{"en":"Hello, this is Nour from Cham Furniture.","ar":"مرحباً، أنا نور من أثاث الشام."},"id":"L005"},{"actor":"nour","start":27.232,"text":{"en":"Do you have any oak boards?","ar":"هل لديك أيّ ألواح بلّوط؟"},"id":"L006"},{"actor":"omar","start":29.958,"text":{"en":"Yes, we have some. How many do you need?","ar":"نعم، لدينا بعضها. كم تحتاجين؟"},"id":"L007"},{"actor":"nour","start":33.284,"text":{"en":"We need twenty boards. Do you have any walnut too?","ar":"نحتاج عشرين لوحاً. هل لديك أيّ جوز أيضاً؟"},"id":"L008"},{"actor":"omar","start":38.314,"text":{"en":"I'm sorry, there isn't any walnut this week.","ar":"آسف، لا يوجد أيّ جوز هذا الأسبوع."},"id":"L009"},{"actor":"nour","start":42.048,"text":{"en":"That's OK. Please send twenty oak boards.","ar":"لا بأس. أرسل عشرين لوح بلّوط من فضلك."},"id":"L010"},{"actor":"nour","start":46.79,"text":{"en":"Do you have soft foam?","ar":"هل لديك إسفنج ناعم؟"},"id":"L011"},{"actor":"omar","start":49.3,"text":{"en":"Yes, we have a lot.","ar":"نعم، لدينا الكثير."},"id":"L012"},{"actor":"nour","start":51.522,"text":{"en":"Please add ten pieces.","ar":"أضف عشر قطع من فضلك."},"id":"L013"},{"actor":"omar","start":54.344,"text":{"en":"No problem. We can deliver on Sunday.","ar":"لا مشكلة. نستطيع التوصيل يوم الأحد."},"id":"L014"},{"actor":"nour","start":57.838,"text":{"en":"Now match each item with its detail.","ar":"الآن طابِق كلّ صنف مع تفصيله."},"id":"L015"},{"actor":"nour","start":61.236,"text":{"en":"The first is done: he can deliver on Sunday.","ar":"الأوّل محلول: يستطيع التوصيل يوم الأحد."},"id":"L016"},{"actor":"nour","start":65.162,"text":{"en":"Oak boards. How many?","ar":"ألواح البلّوط. كم عددها؟"},"subHold":7.571,"id":"L017"},{"actor":"nour","start":72.733,"text":{"en":"Twenty boards.","ar":"عشرون لوحاً."},"id":"L018"},{"actor":"nour","start":75.027,"text":{"en":"Walnut. How much?","ar":"الجوز. كم كمّيّته؟"},"subHold":7.265,"id":"L019"},{"actor":"nour","start":82.292,"text":{"en":"None this week.","ar":"لا شيء هذا الأسبوع."},"id":"L020"},{"actor":"nour","start":84.61,"text":{"en":"Foam. How much?","ar":"الإسفنج. كم كمّيّته؟"},"subHold":7.192,"id":"L021"},{"actor":"nour","start":91.802,"text":{"en":"Ten pieces.","ar":"عشر قطع."},"id":"L022"},{"actor":"nour","start":94.12,"text":{"en":"Delivery day. When?","ar":"يوم التوصيل. متى؟"},"subHold":7.405,"id":"L023"},{"actor":"nour","start":101.525,"text":{"en":"On Sunday.","ar":"يوم الأحد."},"id":"L024"},{"actor":"omar","start":103.747,"text":{"en":"One detail was not needed: in the blue box.","ar":"بقي تفصيل لم نحتجه: في الصندوق الأزرق."},"id":"L025"},{"actor":"nour","start":107.529,"text":{"en":"That belongs in the workshop, not in an order.","ar":"ذاك مكانه الورشة، لا طلبيّة الشراء."},"id":"L026"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"cdb0366087686