:118.065,"dur":3.648}],"speech":[{"actor":"sami","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 3, Tools and the Workshop.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الثالثة، الأدوات والورشة."},"id":"L001"},{"actor":"sami","start":7.304,"text":{"en":"This is Part 4, Safety Briefing Role Play. You will take the new worker's part, then be refused safely.","ar":"هذا الجزء الرابع، لعب أدوار في إحاطة السلامة. ستأخذ دور العامل الجديد، ثمّ يُرفض طلبك بأمان."},"id":"L002"},{"actor":"sami","start":15.334,"text":{"en":"Listen to the briefing once. Then you take Khaled's part.","ar":"استمع إلى الإحاطة مرّة. ثمّ خذ دور خالد."},"id":"L003"},{"actor":"sami","start":20.436,"text":{"en":"Welcome, Khaled. First, always wear your goggles.","ar":"أهلاً بك يا خالد. أوّلاً، ارتدِ نظّاراتك الواقية دائماً."},"id":"L004"},{"actor":"khaled","start":25.97,"text":{"en":"OK, Ustaz.","ar":"حسناً يا أستاذ."},"id":"L005"},{"actor":"sami","start":28.48,"text":{"en":"Keep your area clean, and ask me before you use a machine.","ar":"أبقِ منطقتك نظيفة، واسألني قبل أن تستخدم آلة."},"id":"L006"},{"actor":"khaled","start":33.054,"text":{"en":"Yes. What do I do first?","ar":"نعم. ماذا أفعل أوّلاً؟"},"id":"L007"},{"actor":"sami","start":36.812,"text":{"en":"Today, watch Rana and learn.","ar":"اليوم، راقب رنا وتعلّم."},"id":"L008"},{"actor":"sami","start":40.066,"text":{"en":"Now your turn. You are the new worker.","ar":"الآن دورك. أنت العامل الجديد."},"id":"L009"},{"actor":"sami","start":44.352,"text":{"en":"Greet me, and ask where the tools are.","ar":"حيّني، واسأل أين الأدوات."},"subHold":8.283,"id":"L010"},{"actor":"sami","start":52.635,"text":{"en":"Good morning, Ustaz. Where are the tools?","ar":"صباح الخير يا أستاذ. أين الأدوات؟"},"id":"L011"},{"actor":"sami","start":57.281,"text":{"en":"Repeat my three rules in your own words.","ar":"كرّر قواعدي الثلاث بكلماتك."},"subHold":8.761,"id":"L012"},{"actor":"sami","start":66.042,"text":{"en":"Wear goggles. Keep my area clean. Ask before a machine.","ar":"ارتدِ النظّارات. أبقِ منطقتي نظيفة. اسأل قبل الآلة."},"id":"L013"},{"actor":"sami","start":72.56,"text":{"en":"Ask me what to do today.","ar":"اسألني ماذا أفعل اليوم."},"subHold":6.764,"id":"L014"},{"actor":"sami","start":79.324,"text":{"en":"What do I do first today?","ar":"ماذا أفعل أوّلاً اليوم؟"},"id":"L015"},{"actor":"sami","start":82.218,"text":{"en":"Good. Now the hard one.","ar":"جيّد. الآن الصعبة."},"id":"L016"},{"actor":"khaled","start":85.832,"text":{"en":"Ustaz, may I use the big saw today?","ar":"أستاذ، هل أستطيع استخدام المنشار الكبير اليوم؟"},"id":"L017"},{"actor":"sami","start":89.374,"text":{"en":"How do I say no, explain why, and give a safe first task?","ar":"كيف أرفض، وأشرح السبب، وأعطي مهمّة أولى آمنة؟"},"subHold":11.129,"id":"L018"},{"actor":"sami","start":100.503,"text":{"en":"Not today. The big saw is dangerous. Today, sand these edges.","ar":"ليس اليوم. المنشار الكبير خطر. اليوم، اصنفر هذه الحواف."},"id":"L019"},{"actor":"sami","start":107.693,"text":{"en":"Three moves. No. Because. Instead.","ar":"ثلاث حركات. لا. لأنّ. بدلاً من ذلك."},"id":"L020"},{"actor":"sami","start":113.923,"text":{"en":"A no with no task is how a new worker gets bored.","ar":"«لا» بلا مهمّة هي كيف يملّ العامل الجديد."},"id":"L021"},{"actor":"sami","start":118.065,"text":{"en":"A bored worker near a machine is the next accident.","ar":"والعامل الملول قرب آلة هو الحادث التالي."},"id":"L022"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"7b4273a3ab1f1334","bytes":39024,"sha":"be6d55a057c7a091","address":"lines/7b4273a3ab1f1334.mp3"},{"key":"21cbffc0a0a6939f","bytes":46080,"sha":"3613e0ded5b76417","address":"lines/21cbffc0a0a6939f.mp3"},{"key":"3052e91416d0e4b5","bytes":28512,"sha":"58d33bdfdd47f9ef","address":"lines/3052e91416d0e4b5.mp3"},{"key":"5ceb32250b63d3f0","bytes