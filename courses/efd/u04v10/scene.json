rdrobe?. You will hear three wardrobes compared by size and price.","ar":"هذا الجزء الثالث، أيّ خزانة؟. ستسمع مقارنة بين ثلاث خزائن بالمقاس والسعر."},"id":"L002"},{"actor":"nour","start":15.046,"text":{"en":"For a small bedroom, is a big or a small wardrobe better?","ar":"لغرفة نوم صغيرة، أيّهما أفضل: خزانة كبيرة أم صغيرة؟"},"id":"L003"},{"actor":"customer","start":19.524,"text":{"en":"I need a wardrobe for a small bedroom. Which is the smallest?","ar":"أحتاج خزانة لغرفة نوم صغيرة. أيّها الأصغر؟"},"id":"L004"},{"actor":"nour","start":24.866,"text":{"en":"This white one is the smallest, ninety centimetres wide.","ar":"هذه البيضاء هي الأصغر، عرضها تسعون سنتيمتراً."},"id":"L005"},{"actor":"nour","start":29.608,"text":{"en":"The brown one is wider, one hundred and twenty.","ar":"البنّيّة أعرض، مئة وعشرون."},"id":"L006"},{"actor":"nour","start":33.51,"text":{"en":"And the big oak one is the widest, one hundred and fifty.","ar":"وخزانة البلّوط الكبيرة هي الأعرض، مئة وخمسون."},"id":"L007"},{"actor":"customer","start":37.916,"text":{"en":"Is the white one tall?","ar":"هل البيضاء عالية؟"},"id":"L008"},{"actor":"nour","start":40.45,"text":{"en":"Yes, it is the tallest, two hundred and ten centimetres.","ar":"نعم، هي الأعلى، مئتان وعشرة سنتيمترات."},"id":"L009"},{"actor":"nour","start":45.144,"text":{"en":"So it holds a lot.","ar":"لذا تتّسع لأشياء كثيرة."},"id":"L010"},{"actor":"customer","start":47.678,"text":{"en":"And the price?","ar":"والسعر؟"},"id":"L011"},{"actor":"nour","start":49.9,"text":{"en":"The white one is the cheapest. The oak one is the most expensive.","ar":"البيضاء هي الأرخص. وخزانة البلّوط هي الأغلى."},"id":"L012"},{"actor":"customer","start":55.602,"text":{"en":"I will take the white one. It is the smallest and the cheapest.","ar":"سآخذ البيضاء. هي الأصغر والأرخص."},"id":"L013"},{"actor":"nour","start":60.752,"text":{"en":"A good choice for a small room.","ar":"اختيار جيّد لغرفة صغيرة."},"id":"L014"},{"actor":"nour","start":63.814,"text":{"en":"Now match each wardrobe with the right description.","ar":"الآن طابق كلّ خزانة مع الوصف الصحيح."},"id":"L015"},{"actor":"nour","start":67.788,"text":{"en":"The white wardrobe.","ar":"الخزانة البيضاء."},"subHold":6.254,"id":"L016"},{"actor":"nour","start":74.042,"text":{"en":"The smallest, tallest and cheapest.","ar":"الأصغر والأعلى والأرخص."},"id":"L017"},{"actor":"nour","start":77.68,"text":{"en":"The brown wardrobe.","ar":"الخزانة البنّيّة."},"subHold":6.205,"id":"L018"},{"actor":"nour","start":83.885,"text":{"en":"One hundred and twenty centimetres wide.","ar":"عرضها مئة وعشرون سنتيمتراً."},"id":"L019"},{"actor":"nour","start":87.452,"text":{"en":"The oak wardrobe.","ar":"خزانة البلّوط."},"subHold":6.088,"id":"L020"},{"actor":"nour","start":93.54,"text":{"en":"The widest and most expensive.","ar":"الأعرض والأغلى."},"id":"L021"},{"actor":"nour","start":96.746,"text":{"en":"The advice for a small room.","ar":"النصيحة لغرفة صغيرة."},"subHold":7.191,"id":"L022"},{"actor":"nour","start":103.937,"text":{"en":"Choose the smallest and cheapest.","ar":"اختر الأصغر والأرخص."},"id":"L023"},{"actor":"customer","start":107.023,"text":{"en":"One description was not needed: the heaviest to lift.","ar":"بقي وصف لم نحتجه: الأثقل رفعاً."},"id":"L024"},{"actor":"nour","start":111.357,"text":{"en":"Weight matters when you move it, not when you choose it.","ar":"الوزن يهمّ حين تنقلها، لا حين تختارها."},"id":"L025"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"fd4031d5d6ac5342","bytes":41040,"sha":"2a3e449c6229b11f","address":"lines/fd4031d5d6ac5342.mp3"},{"key":"997d4ebd8a780a74","bytes":42336,"sha":"8c1fb2323df17a59","address":"lines/997d4ebd8a780a74.mp3"},{"key":"8f51bd3dbe3d7fcf","bytes":24768,"sha":"6785fb03d56b5935","address":"lines/8f51bd3dbe3d7fcf.mp3"},{"key":"7c4973bd6cf013fd","bytes":29952,"sha":"941317cab3eb728e","address":"lines/7c4