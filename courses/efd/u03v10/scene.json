"text":{"en":"Ustaz Sami, where is the drill?","ar":"أستاذ سامي، أين المثقاب؟"},"id":"L004"},{"actor":"sami","start":21.482,"text":{"en":"It is on the workbench, next to the clamps.","ar":"إنّه على طاولة العمل، بجانب المشابك."},"id":"L005"},{"actor":"khaled","start":25.12,"text":{"en":"Thanks. And do we have any long screws?","ar":"شكراً. وهل لدينا براغٍ طويلة؟"},"id":"L006"},{"actor":"sami","start":29.334,"text":{"en":"Yes, there are some in the blue box.","ar":"نعم، يوجد بعضها في الصندوق الأزرق."},"id":"L007"},{"actor":"khaled","start":32.756,"text":{"en":"What do I do first?","ar":"ماذا أفعل أوّلاً؟"},"id":"L008"},{"actor":"sami","start":35.266,"text":{"en":"First, measure the wood.","ar":"أوّلاً، قِس الخشب."},"id":"L009"},{"actor":"sami","start":38.04,"text":{"en":"Then make a hole with the drill.","ar":"ثمّ اصنع ثقباً بالمثقاب."},"id":"L010"},{"actor":"sami","start":40.886,"text":{"en":"Next, put in the screws.","ar":"بعد ذلك، ضع البراغي."},"id":"L011"},{"actor":"sami","start":43.948,"text":{"en":"Finally, check that it is straight.","ar":"أخيراً، تحقّق من أنّه مستقيم."},"id":"L012"},{"actor":"sami","start":47.322,"text":{"en":"And remember, wear your goggles.","ar":"وتذكّر، ارتدِ نظّاراتك الواقية."},"id":"L013"},{"actor":"khaled","start":50.552,"text":{"en":"OK, Ustaz.","ar":"حسناً يا أستاذ."},"id":"L014"},{"actor":"sami","start":53.062,"text":{"en":"Now put the steps in order. Step one is measure the wood.","ar":"الآن رتّب الخطوات. الخطوة الأولى قياس الخشب."},"id":"L015"},{"actor":"khaled","start":58.308,"text":{"en":"Which step is second?","ar":"ما الخطوة الثانية؟"},"subHold":6.419,"id":"L016"},{"actor":"khaled","start":64.727,"text":{"en":"Make a hole with the drill.","ar":"صنع ثقب بالمثقاب."},"id":"L017"},{"actor":"khaled","start":67.309,"text":{"en":"Which step is third?","ar":"ما الخطوة الثالثة؟"},"subHold":6.193,"id":"L018"},{"actor":"khaled","start":73.502,"text":{"en":"Put in the screws.","ar":"وضع البراغي."},"id":"L019"},{"actor":"khaled","start":75.844,"text":{"en":"Which step is fourth?","ar":"ما الخطوة الرابعة؟"},"subHold":6.371,"id":"L020"},{"actor":"khaled","start":82.215,"text":{"en":"Check that it is straight.","ar":"التحقّق من أنّه مستقيم."},"id":"L021"},{"actor":"sami","start":84.797,"text":{"en":"Measure, drill, screw, check.","ar":"قِس، اثقب، ابرغِ، تحقّق."},"id":"L022"},{"actor":"sami","start":88.363,"text":{"en":"The check is a step, not an afterthought.","ar":"التحقّق خطوة، لا فكرة لاحقة."},"id":"L023"},{"actor":"khaled","start":91.905,"text":{"en":"And where do I find a tool?","ar":"وأين أجد أداة؟"},"id":"L024"},{"actor":"sami","start":94.703,"text":{"en":"Ask. On the workbench, next to, in the blue box.","ar":"اسأل. على طاولة العمل، بجانب، في الصندوق الأزرق."},"id":"L025"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"7b4273a3ab1f1334","bytes":39024,"sha":"be6d55a057c7a091","address":"lines/7b4273a3ab1f1334.mp3"},{"key":"6ab3d5988e19602b","bytes":39888,"sha":"336f204255f53419","address":"lines/6ab3d5988e19602b.mp3"},{"key":"1d9f60f3fab2033f","bytes":20592,"sha":"f458393ff995fc50","address":"lines/1d9f60f3fab2033f.mp3"},{"key":"c74f43da577a4f06","bytes":18288,"sha":"2dd9efa518376e17","address":"lines/c74f43da577a4f06.mp3"},{"key":"b24e2dd95748460b","bytes":19728,"sha":"c3aff65b77ddb5f7","address":"lines/b24e2dd95748460b.mp3"},{"key":"130fd0805f8d0cc6","bytes":23184,"sha":"0f1338748d26a0f6","address":"lines/130fd0805f8d0cc6.mp3"},{"key":"b61e636315880b83","bytes":18432,"sha":"93d1e76e835c584f","address":"lines/b61e636315880b83.mp3"},{"key":"387ba5d319d0d098","bytes":12960,"sha":"11637c6258b45a07","address":"lines/387ba5d319d0d098.mp3"},{"key":"4097989077465ad7","bytes":14544,"sha":"f45bdbb9d83343ad","address":"lines/4097989077465ad7.mp3"},{"key":"8a2e29d1e51d341e","bytes":14976,"sha":"ed90935768ca4a1f","address":"lines/8a2e29d1e51d341e.mp3"},{"key"