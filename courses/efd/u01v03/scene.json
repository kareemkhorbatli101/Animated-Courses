:8.016},{"i":0,"at":8.816,"dur":6.768},{"i":0,"at":15.934,"dur":6.0},{"i":0,"at":22.284,"dur":7.152},{"i":0,"at":29.786,"dur":6.936},{"i":0,"at":37.072,"dur":6.6},{"i":0,"at":44.022,"dur":7.632},{"i":0,"at":52.004,"dur":7.728},{"i":0,"at":60.082,"dur":7.248},{"i":0,"at":67.68,"dur":5.064},{"i":1,"at":73.094,"dur":4.2},{"i":1,"at":83.588,"dur":4.44},{"i":0,"at":88.378,"dur":5.424}],"speech":[{"actor":"layla","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 1, Introduction to Furniture and Design.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الأولى، مقدّمة في الأثاث والتصميم."},"id":"L001"},{"actor":"layla","start":8.816,"text":{"en":"This is Part 1, Pronunciation. You will practise the stress in six words.","ar":"هذا الجزء الأوّل، النطق. ستتدرّب على النبر في ستّ كلمات."},"id":"L002"},{"actor":"layla","start":15.934,"text":{"en":"Six words from this unit. Stress the loud syllable in each one.","ar":"ستّ كلمات من هذه الوحدة. شدّد على المقطع القويّ في كلّ واحدة."},"id":"L003"},{"actor":"layla","start":22.284,"text":{"en":"Furniture. FUR-ni-ture. Three syllables, and the first is loud.","ar":"Furniture. الأثاث. ثلاثة مقاطع، والأوّل هو القويّ."},"id":"L004"},{"actor":"layla","start":29.786,"text":{"en":"Armchair. ARM-chair. Two syllables, and the first is loud.","ar":"Armchair. الكرسي الوثير. مقطعان، والأوّل هو القويّ."},"id":"L005"},{"actor":"layla","start":37.072,"text":{"en":"Design. de-SIGN. Two syllables, and the SECOND is loud.","ar":"Design. التصميم. مقطعان، والثاني هو القويّ."},"id":"L006"},{"actor":"layla","start":44.022,"text":{"en":"Material. ma-TE-ri-al. Four syllables, and the second is loud.","ar":"Material. المادّة. أربعة مقاطع، والثاني هو القويّ."},"id":"L007"},{"actor":"layla","start":52.004,"text":{"en":"Upholstery. up-HOL-ster-y. Four syllables, and the second is loud.","ar":"Upholstery. التنجيد. أربعة مقاطع، والثاني هو القويّ."},"id":"L008"},{"actor":"layla","start":60.082,"text":{"en":"Prototype. PRO-to-type. Three syllables, and the first is loud.","ar":"Prototype. النموذج الأوّلي. ثلاثة مقاطع، والأوّل هو القويّ."},"id":"L009"},{"actor":"layla","start":67.68,"text":{"en":"Three of the six stress the first syllable. Three do not.","ar":"ثلاث من الستّ تُشدّد على المقطع الأوّل. وثلاث لا تفعل."},"id":"L010"},{"actor":"khaled","start":73.094,"text":{"en":"Which syllable is loud in design, and which in material?","ar":"أيّ مقطع هو القويّ في design، وأيّه في material؟"},"subHold":10.494,"id":"L011"},{"actor":"khaled","start":83.588,"text":{"en":"The second in both. de-SIGN, and ma-TE-ri-al.","ar":"الثاني في كلتيهما. de-SIGN، و ma-TE-ri-al."},"id":"L012"},{"actor":"layla","start":88.378,"text":{"en":"Say all six again. Tap the loud syllable with your hand.","ar":"قل الستّ مرّة أخرى. واطرق على المقطع القويّ بيدك."},"id":"L013"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"deb6abf99d6a8dd7","bytes":48096,"sha":"0ead9e7be9cdd769","address":"lines/deb6abf99d6a8dd7.mp3"},{"key":"fd5ec087a83cf8e3","bytes":40608,"sha":"04eba5b4db635c5f","address":"lines/fd5ec087a83cf8e3.mp3"},{"key":"3fc0756221772b70","bytes":36000,"sha":"5be48b218d74c178","address":"lines/3fc0756221772b70.mp3"},{"key":"4484cba7ad5db924","bytes":42912,"sha":"d1280aca6d097467","address":"lines/4484cba7ad5db924.mp3"},{"key":"016681ed2819f074","bytes":41616,"sha":"13cc9970a5b00c3a","address":"lines/016681ed2819f074.mp3"},{"key":"583b5c1c6bd67b48","bytes":39600,"sha":"87a412695783d685","address":"lines/583b5c1c6bd67b48.mp3"},{"key":"fb03ea1b11cc553e","bytes":45792,"sha":"006a0f5e6ef45fd7","address":"lines/fb03ea1b11cc553e.mp3"},{"key":"c95b3b496bc0d105","bytes":46368,"sha":"dedf8137cc73daa1","address":"lines/c95b3b496bc0d105.mp3"},{"key":"48ffe1bb41d7cd30","bytes":43488,"sha":"f2ee402fd9f4abc9","address":"lines/48ffe1bb41d7cd30.mp3"},{"key":"4b03584b68b8177c","bytes