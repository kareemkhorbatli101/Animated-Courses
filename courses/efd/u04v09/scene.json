":1,"at":58.984,"dur":2.88},{"i":1,"at":62.214,"dur":2.4},{"i":1,"at":69.438,"dur":2.928},{"i":1,"at":72.716,"dur":2.544},{"i":1,"at":79.848,"dur":2.64},{"i":0,"at":82.838,"dur":3.72},{"i":0,"at":86.908,"dur":4.368}],"speech":[{"actor":"sami","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 4, Measuring and Dimensions.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الرابعة، القياس والأبعاد."},"id":"L001"},{"actor":"sami","start":7.496,"text":{"en":"This is Part 3, Checking Sizes. You will hear a board checked against the cutting list.","ar":"هذا الجزء الثالث، التحقّق من المقاسات. ستسمع لوحاً يُقارن بقائمة القصّ."},"id":"L002"},{"actor":"sami","start":14.35,"text":{"en":"What is the rule, measure twice, cut once?","ar":"ما قاعدة: قِس مرّتين واقطع مرّة؟"},"id":"L003"},{"actor":"sami","start":18.444,"text":{"en":"Khaled, measure this board, please.","ar":"خالد، قِس هذا اللوح من فضلك."},"id":"L004"},{"actor":"khaled","start":21.986,"text":{"en":"It is one hundred and twenty centimetres long, and forty wide.","ar":"طوله مئة وعشرون سنتيمتراً، وعرضه أربعون."},"id":"L005"},{"actor":"sami","start":27.04,"text":{"en":"Good. The cutting list says one hundred and eighteen.","ar":"جيّد. قائمة القصّ تقول مئة وثمانية عشر."},"id":"L006"},{"actor":"sami","start":31.902,"text":{"en":"So it is a little too long.","ar":"إذاً هو أطول قليلاً ممّا يجب."},"id":"L007"},{"actor":"khaled","start":34.772,"text":{"en":"Shall I cut two centimetres?","ar":"هل أقطع سنتيمترين؟"},"id":"L008"},{"actor":"sami","start":37.762,"text":{"en":"Yes, but measure twice first.","ar":"نعم، لكن قِس مرّتين أوّلاً."},"id":"L009"},{"actor":"sami","start":40.992,"text":{"en":"Remember: measure twice, cut once.","ar":"تذكّر: قِس مرّتين، واقطع مرّة."},"id":"L010"},{"actor":"khaled","start":44.75,"text":{"en":"OK, Ustaz.","ar":"حسناً يا أستاذ."},"id":"L011"},{"actor":"sami","start":47.26,"text":{"en":"The first question is done. I asked him to measure a board.","ar":"السؤال الأوّل محلول. طلبت منه قياس لوح."},"id":"L012"},{"actor":"khaled","start":52.506,"text":{"en":"How long is the board?","ar":"كم طول اللوح؟"},"subHold":6.478,"id":"L013"},{"actor":"khaled","start":58.984,"text":{"en":"One hundred and twenty centimetres.","ar":"مئة وعشرون سنتيمتراً."},"id":"L014"},{"actor":"khaled","start":62.214,"text":{"en":"What does the cutting list say?","ar":"ماذا تقول قائمة القصّ؟"},"subHold":7.224,"id":"L015"},{"actor":"khaled","start":69.438,"text":{"en":"One hundred and eighteen centimetres.","ar":"مئة وثمانية عشر سنتيمتراً."},"id":"L016"},{"actor":"khaled","start":72.716,"text":{"en":"What rule does Sami repeat?","ar":"ما القاعدة التي يكرّرها سامي؟"},"subHold":7.132,"id":"L017"},{"actor":"khaled","start":79.848,"text":{"en":"Measure twice, cut once.","ar":"قِس مرّتين، واقطع مرّة."},"id":"L018"},{"actor":"sami","start":82.838,"text":{"en":"Two centimetres is a small number and a big problem.","ar":"سنتيمتران رقم صغير ومشكلة كبيرة."},"id":"L019"},{"actor":"sami","start":86.908,"text":{"en":"You can cut wood shorter. You cannot cut it longer.","ar":"تستطيع أن تقصّ الخشب أقصر. ولا تستطيع أن تقصّه أطول."},"id":"L020"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"24304ca5f9bc6dab","bytes":40176,"sha":"3fcae9176d710c6c","address":"lines/24304ca5f9bc6dab.mp3"},{"key":"7395a23967c807c2","bytes":39024,"sha":"955dd972be7b16b8","address":"lines/7395a23967c807c2.mp3"},{"key":"19aa6f030a8c8d09","bytes":22464,"sha":"65e9f7f87682b4cd","address":"lines/19aa6f030a8c8d09.mp3"},{"key":"41728b2061bf4090","bytes":19152,"sha":"3f4da01c9310fee2","address":"lines/41728b2061bf4090.mp3"},{"key":"2bef5ed46322777c","bytes":28224,"sha":"bf3c91bf86ed09dc","address":"lines/2bef5ed46322777c.mp3"},{"key":"69605398ec1d2350","bytes":27072,"sha":"528e32356270b823","address":"lines/69605398ec1d2350.mp3"},{"key":"ce0c4cf982c33e