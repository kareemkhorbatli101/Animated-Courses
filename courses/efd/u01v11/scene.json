":3.912},{"i":0,"at":45.513,"dur":4.416},{"i":0,"at":50.279,"dur":3.384},{"i":0,"at":59.369,"dur":5.856},{"i":0,"at":65.575,"dur":6.768},{"i":1,"at":72.693,"dur":5.352},{"i":1,"at":78.395,"dur":6.696},{"i":1,"at":85.441,"dur":7.344},{"i":1,"at":93.135,"dur":3.96},{"i":1,"at":102.742,"dur":4.656},{"i":1,"at":107.748,"dur":5.184},{"i":1,"at":119.756,"dur":5.16},{"i":0,"at":125.266,"dur":5.16},{"i":0,"at":130.776,"dur":5.832},{"i":0,"at":143.784,"dur":5.4}],"speech":[{"actor":"nour","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 1, Introduction to Furniture and Design.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الأولى، مقدّمة في الأثاث والتصميم."},"id":"L001"},{"actor":"nour","start":8.264,"text":{"en":"This is Part 4, Discussing Furniture and Design. Two sofas, and three differences.","ar":"هذا الجزء الرابع، مناقشة الأثاث والتصميم. كنبتان، وثلاثة فروق."},"id":"L002"},{"actor":"nour","start":15.646,"text":{"en":"Three questions for a partner. Answer each one aloud before I do.","ar":"ثلاثة أسئلة لزميل. أجب عن كلّ واحد بصوت عالٍ قبلي."},"id":"L003"},{"actor":"nour","start":21.564,"text":{"en":"What furniture do you have in your living room?","ar":"أيّ أثاث لديك في غرفة الجلوس؟"},"subHold":8.789,"id":"L004"},{"actor":"nour","start":30.353,"text":{"en":"For example: I have a sofa, two armchairs and a coffee table.","ar":"مثلاً: لديّ كنبة وكرسيّان وثيران وطاولة قهوة."},"id":"L005"},{"actor":"nour","start":35.719,"text":{"en":"Do you like modern or classic furniture, and why?","ar":"هل تحبّ الأثاث الحديث أم الكلاسيكي، ولماذا؟"},"subHold":9.794,"id":"L006"},{"actor":"nour","start":45.513,"text":{"en":"For example: I like modern furniture because it is simple.","ar":"مثلاً: أحبّ الأثاث الحديث لأنّه بسيط."},"id":"L007"},{"actor":"nour","start":50.279,"text":{"en":"Can you describe your favourite chair or sofa?","ar":"هل تستطيع وصف كرسيّك أو كنبتك المفضّلة؟"},"subHold":9.09,"id":"L008"},{"actor":"nour","start":59.369,"text":{"en":"For example: my favourite chair is brown. It is made of wood and leather.","ar":"مثلاً: كرسيّي المفضّل بنّي. مصنوع من الخشب والجلد."},"id":"L009"},{"actor":"nour","start":65.575,"text":{"en":"Four phrases for this. I have, I like because, my favourite is, it is made of.","ar":"أربع عبارات لهذا. I have، و I like because، و my favourite is، و it is made of."},"id":"L010"},{"actor":"khaled","start":72.693,"text":{"en":"Now the pair task. Two sofas, and neither of you shows your card.","ar":"الآن مهمّة الزوج. كنبتان، ولا يُظهر أيّ منكما بطاقته."},"id":"L011"},{"actor":"khaled","start":78.395,"text":{"en":"Sofa A is grey. It has an oak frame. It is small, and costs two million.","ar":"الكنبة A رمادية. هيكلها بلّوط. صغيرة، وسعرها مليونان."},"id":"L012"},{"actor":"khaled","start":85.441,"text":{"en":"Sofa B is blue. It has a pine frame. It is big, and costs two and a half million.","ar":"الكنبة B زرقاء. هيكلها صنوبر. كبيرة، وسعرها مليونان ونصف."},"id":"L013"},{"actor":"khaled","start":93.135,"text":{"en":"Ask about the frames. What is the difference?","ar":"اسأل عن الهياكل. ما الفرق؟"},"subHold":9.607,"id":"L014"},{"actor":"khaled","start":102.742,"text":{"en":"Sofa A has an oak frame, and sofa B has a pine frame.","ar":"الكنبة A هيكلها بلّوط، والكنبة B هيكلها صنوبر."},"id":"L015"},{"actor":"khaled","start":107.748,"text":{"en":"Now ask about size and price. What are the other two differences?","ar":"الآن اسأل عن الحجم والسعر. ما الفرقان الآخران؟"},"subHold":12.008,"id":"L016"},{"actor":"khaled","start":119.756,"text":{"en":"A is small and cheaper. B is big and costs half a million more.","ar":"A صغيرة وأرخص. و B كبيرة وتكلّف نصف مليون أكثر."},"id":"L017"},{"actor":"nour","start":125.266,"text":{"en":"Now your own opinion. There is no single right answer here.","ar":"الآن رأيك الخاصّ. لا جواب واحد صحيح هنا."},"id":"L018"},{"actor":"nour","start":130.776,"text":{"en":"A small room and a big family. Which sofa would you sell them, and why?","ar":"غرفة صغيرة وعائلة كبيرة. أيّ كنبة تبيعهم، ولماذا؟"},"subHold":13.008,"id":"L019"},{"actor":"nour","start":143.784,"text":{"en":"For example: the small one, because a big sofa makes the room feel smaller.","ar":"مثلاً: الصغيرة، لأنّ الكنبة الكبيرة تجعل الغرفة تبدو أصغر."},"id":"L020"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"a40a62c2fa8b2a6b","bytes":44784,"sha":"3d4cb038a3219780","address":"lines/a40a62c2fa8b2a6b.mp3"},{"key":"83833eac75814d39","bytes":42192,"sha":"0b851a56d28d81d7","address":"lines/83833eac75814d39.mp3"},{"key":"23b81cde7b4f2dff","bytes":33408,"sha":"b9369336a31f63ab","address":"lines/23b81cde7b4f2dff.mp3"},{"key":"54c84363cba8aae7","bytes":18144,"sha":"edf634b2f42cab60","address":"lines/54c84363cba8aae7.mp3"},{"key":"2d8aede7941c9424","bytes":30096,"sha":"57749e57a335cf9b","address":"lines/2d8aede7941c9424.mp3"},{"key":"a0ef683597dabea8","bytes":23472,"sha":"00d442ad8ed8558a","address":"lines/a0ef683597dabea8.mp3"},{"key":"63654c5694748741","bytes":26496,"sha":"7e3f1be94bf22b93","address":"lines/63654c5694748741.mp3"},{"key":"233cc58056b62796","bytes":20304,"sha":"56d6f7d3803ce559","address":"lines/233cc58056b62796.mp3"},{"key":"5d0aa6280bc139b4","bytes":35136,"sha":"e14537c1c6b270d4","address":"lines/5d0aa6280bc139b4.mp3"},{"key":"3966e08a433729f6","bytes":40608,"sha":"bbb55b22f8a089e1","address":"lines/3966e08a433729f6.mp3"},{"key":"7906d0d1138ff073","bytes":32112,"sha":"bd9e41796ff4e863","address":"lines/7906d0d1138ff073.mp3"},{"key":"504bc031ed77d789","bytes":40176,"sha":"b2de017ef0ce5c8b","address":"lines/504bc031ed77d789.mp3"},{"key":"6c194289980b68bd","bytes":44064,"sha":"f36153a6354574bc","address":"lines/6c194289980b68bd.mp3"},{"key":"72568c34b32d2bdc","bytes":23760,"sha":"0ecc5e863458bf3c","address":"lines/72568c34b32d2bdc.mp3"},{"key":"e8a48dea08c8eab4","bytes":27936,"sha":"8f9c374136540ab7","address":"li