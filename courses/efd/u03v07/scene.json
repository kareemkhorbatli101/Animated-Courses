"khaled","start":30.28,"text":{"en":"Don't touches the blade.","ar":"صحّح هذه الجملة: «Don't touches the blade.»"},"subHold":6.499,"id":"L006"},{"actor":"khaled","start":36.779,"text":{"en":"Don't touch the blade. After don't, the verb never changes.","ar":"Don't touch the blade. بعد don't لا يتغيّر الفعل."},"id":"L007"},{"actor":"khaled","start":42.025,"text":{"en":"You keep the floor clean.","ar":"صحّح هذه الجملة: «You keep the floor clean.»"},"subHold":6.631,"id":"L008"},{"actor":"khaled","start":48.656,"text":{"en":"Keep the floor clean. An instruction has no subject.","ar":"Keep the floor clean. التعليمة بلا فاعل."},"id":"L009"},{"actor":"khaled","start":53.59,"text":{"en":"Please to ask before you use a machine.","ar":"صحّح هذه الجملة: «Please to ask before you use a machine.»"},"subHold":8.222,"id":"L010"},{"actor":"khaled","start":61.812,"text":{"en":"Please ask before you use a machine. No to after please.","ar":"Please ask before you use a machine. لا to بعد please."},"id":"L011"},{"actor":"sami","start":66.866,"text":{"en":"Three mistakes were the same mistake.","ar":"ثلاثة أخطاء كانت الخطأ نفسه."},"id":"L012"},{"actor":"sami","start":70.072,"text":{"en":"Somebody added something in front of the verb.","ar":"أحدهم أضاف شيئاً أمام الفعل."},"id":"L013"},{"actor":"sami","start":73.734,"text":{"en":"An s, a subject, or a to. The verb wants none of them.","ar":"حرف s، أو فاعل، أو to. الفعل لا يريد أيّاً منها."},"id":"L014"},{"actor":"sami","start":79.388,"text":{"en":"Now two questions. Choose the correct sentence.","ar":"الآن سؤالان. اختر الجملة الصحيحة."},"id":"L015"},{"actor":"sami","start":84.202,"text":{"en":"Which is a correct safety rule, of the four on screen?","ar":"أيّ قاعدة سلامة صحيحة من الأربع على الشاشة؟"},"subHold":10.161,"id":"L016"},{"actor":"sami","start":94.363,"text":{"en":"B. Wear your goggles.","ar":"ب. Wear your goggles."},"id":"L017"},{"actor":"sami","start":97.065,"text":{"en":"Which shows the correct order, of the four on screen?","ar":"أيّها يبيّن الترتيب الصحيح من الأربعة على الشاشة؟"},"subHold":9.933,"id":"L018"},{"actor":"sami","start":106.998,"text":{"en":"C. First measure. Then cut. Finally sand.","ar":"ج. First measure. Then cut. Finally sand."},"id":"L019"},{"actor":"sami","start":112.844,"text":{"en":"First always comes first. Finally always comes last.","ar":"First تأتي أوّلاً دائماً. Finally تأتي أخيراً دائماً."},"id":"L020"},{"actor":"sami","start":118.45,"text":{"en":"If they are not in that order, the sentence is wrong.","ar":"إن لم تكونا بذلك الترتيب، فالجملة خطأ."},"id":"L021"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"7b4273a3ab1f1334","bytes":39024,"sha":"be6d55a057c7a091","address":"lines/7b4273a3ab1f1334.mp3"},{"key":"c3909604555750c0","bytes":41040,"sha":"7728cff7b2a8499c","address":"lines/c3909604555750c0.mp3"},{"key":"13718a1fc5711ca8","bytes":27216,"sha":"96f77a738e14a9af","address":"lines/13718a1fc5711ca8.mp3"},{"key":"9960a64d2c0f379c","bytes":12096,"sha":"a2c341f989da9da7","address":"lines/9960a64d2c0f379c.mp3"},{"key":"1ba1d2902e8e77e6","bytes":26496,"sha":"eb2e7377fc38727b","address":"lines/1ba1d2902e8e77e6.mp3"},{"key":"e13cf11cc3f46616","bytes":12528,"sha":"a5078eea1c9d9be2","address":"lines/e13cf11cc3f46616.mp3"},{"key":"2cd54155b8145fb0","bytes":29376,"sha":"ed11d92a14f4764b","address":"lines/2cd54155b8145fb0.mp3"},{"key":"bee3d0d0891074bb","bytes":12960,"sha":"7441070c69b7d418","address":"lines/bee3d0d0891074bb.mp3"},{"key":"25398a6c8cce19d6","bytes":27504,"sha":"85c6928bf3804d29","address":"lines/25398a6c8cce19d6.mp3"},{"key":"044dfec6f46ceef7","bytes":17568,"sha":"39fbf9de8b1bf7c7","address":"lines/044dfec6f46ceef7.mp3"},{"key":"08a09466f1527d01","bytes":28224,"sha":"b6860897da269ded","address":"lines/08a09466f1527d01.mp3"},{"key":"3d131b6af3366adc","bytes":17136,"sha":"fb4e05688972468f","address":"lines/3d