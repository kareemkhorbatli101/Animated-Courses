صيغة الأمر، المثبتة والمنفيّة."},"id":"L005"},{"actor":"nour","start":27.712,"text":{"en":"Word bank: wear, keep, don't touch, don't use, always ask.","ar":"بنك الكلمات: ارتدِ، أبقِ، لا تلمس، لا تستخدم، اسأل دائماً."},"id":"L006"},{"actor":"sami","start":33.294,"text":{"en":"What must those five rules include?","ar":"ماذا يجب أن تتضمّن تلك القواعد الخمس؟"},"subHold":8.107,"id":"L007"},{"actor":"sami","start":41.401,"text":{"en":"Both forms. Some positive, some negative.","ar":"كلتا الصيغتين. بعضها مثبت، وبعضها منفيّ."},"id":"L008"},{"actor":"nour","start":46.263,"text":{"en":"Second: how to join two pieces of wood.","ar":"ثانياً: كيف تصل قطعتين من الخشب."},"id":"L009"},{"actor":"nour","start":49.973,"text":{"en":"The plan is four lines. First blank. Then blank.","ar":"الخطّة أربعة أسطر. أوّلاً ـــ. ثمّ ـــ."},"id":"L010"},{"actor":"nour","start":56.347,"text":{"en":"Next blank. Finally blank.","ar":"بعد ذلك ـــ. أخيراً ـــ."},"id":"L011"},{"actor":"sami","start":60.561,"text":{"en":"What makes those four lines instructions and not a story?","ar":"ما الذي يجعل تلك الأسطر تعليمات لا قصّة؟"},"subHold":10.337,"id":"L012"},{"actor":"sami","start":70.898,"text":{"en":"The sequencers, and a base verb with no subject.","ar":"كلمات الترتيب، وفعل مجرّد بلا فاعل."},"id":"L013"},{"actor":"nour","start":74.896,"text":{"en":"Check: sequencers used? Clear steps? Fifty to seventy words?","ar":"تحقّق: كلمات ترتيب؟ خطوات واضحة؟ خمسون إلى سبعون كلمة؟"},"id":"L014"},{"actor":"nour","start":82.038,"text":{"en":"Third: an email to a new worker about safety.","ar":"ثالثاً: رسالة إلى عامل جديد عن السلامة."},"id":"L015"},{"actor":"sami","start":86.204,"text":{"en":"What three things does that email need?","ar":"ما الأمور الثلاثة التي تحتاجها تلك الرسالة؟"},"subHold":8.27,"id":"L016"},{"actor":"sami","start":94.474,"text":{"en":"A greeting and close, two or three safety rules, fifty to seventy words.","ar":"تحيّة وخاتمة، قاعدتان أو ثلاث للسلامة، خمسون إلى سبعون كلمة."},"id":"L017"},{"actor":"nour","start":100.2,"text":{"en":"Fourth: a reflection about one tool you like.","ar":"رابعاً: تأمّل عن أداة واحدة تحبّها."},"id":"L018"},{"actor":"nour","start":104.198,"text":{"en":"Say what you use it for. Forty to sixty words.","ar":"قل فيمَ تستخدمها. أربعون إلى ستّون كلمة."},"id":"L019"},{"actor":"sami","start":109.348,"text":{"en":"What does that reflection need?","ar":"ماذا يحتاج ذلك التأمّل؟"},"subHold":7.296,"id":"L020"},{"actor":"sami","start":116.644,"text":{"en":"A tool named, and what you use it for.","ar":"أداة مسمّاة، وفيمَ تستخدمها."},"id":"L021"},{"actor":"nour","start":120.21,"text":{"en":"Now write. The video stops here, and your pen starts.","ar":"الآن اكتب. الفيديو يتوقّف هنا، وقلمك يبدأ."},"id":"L022"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"82316d9806351f83","bytes":41616,"sha":"a0b3f8feeebeeb08","address":"lines/82316d9806351f83.mp3"},{"key":"5c5f5ca5094904bf","bytes":36720,"sha":"d92c3cca45212e3c","address":"lines/5c5f5ca5094904bf.mp3"},{"key":"3f02689da7376c2e","bytes":29952,"sha":"f7fa19c77de96f68","address":"lines/3f02689da7376c2e.mp3"},{"key":"4bc7486ba614f1f7","bytes":23616,"sha":"26e7df3de5003aad","address":"lines/4bc7486ba614f1f7.mp3"},{"key":"8c55d4280cb0905e","bytes":21168,"sha":"ef006fba3ee994f2","address":"lines/8c55d4280cb0905e.mp3"},{"key":"e725b74586711d2a","bytes":31392,"sha":"4b9525661bfbf27f","address":"lines/e725b74586711d2a.mp3"},{"key":"1859121969d4e508","bytes":18288,"sha":"1350fbba61197062","address":"lines/1859121969d4e508.mp3"},{"key":"1b33b59ee463e8e5","bytes":27072,"sha":"16e9a9df59380f16","address":"lines/1b33b59ee463e8e5.mp3"},{"key":"63313b65d5366f21","bytes":20160,"sha":"f2b4b498a2e578c1","address":"lines/63313b65d5366f21.mp3"},{"key":"eff5b25f98b7b992","bytes":36144,"sha":"bf257cf8fcc01c7f","address":"lines/eff5b25f98b7b992.mp3"},{"key":"dfce502594ee4ae7"