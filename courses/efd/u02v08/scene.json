:1,"at":39.428,"dur":4.776},{"i":0,"at":44.554,"dur":3.024},{"i":0,"at":47.928,"dur":3.432},{"i":1,"at":51.71,"dur":3.864},{"i":0,"at":55.924,"dur":2.928},{"i":1,"at":59.202,"dur":5.088},{"i":1,"at":64.64,"dur":2.136},{"i":1,"at":71.306,"dur":3.768},{"i":1,"at":75.424,"dur":2.976},{"i":1,"at":83.4,"dur":5.208},{"i":1,"at":88.958,"dur":2.808},{"i":1,"at":96.824,"dur":4.824},{"i":0,"at":101.998,"dur":3.12},{"i":0,"at":105.468,"dur":5.4}],"speech":[{"actor":"layla","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 2, Materials and Wood.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الثانية، المواد والخشب."},"id":"L001"},{"actor":"layla","start":7.784,"text":{"en":"This is Part 3, Choosing Materials. You will hear a designer and a foreman choose for an armchair.","ar":"هذا الجزء الثالث، اختيار المواد. ستسمع مصمّمة ورئيس عمّال يختاران لكرسيّ وثير."},"id":"L002"},{"actor":"sami","start":16.102,"text":{"en":"Which do you choose first for a sofa, the frame or the cover?","ar":"أيّهما تختار أوّلاً للكنبة، الهيكل أم الغطاء؟"},"id":"L003"},{"actor":"sami","start":20.772,"text":{"en":"Listen. Layla and I choose for a new armchair.","ar":"استمع. أنا وليلى نختار لكرسيّ وثير جديد."},"id":"L004"},{"actor":"layla","start":25.538,"text":{"en":"Sami, we need materials for the new armchair.","ar":"سامي، نحتاج موادّ للكرسيّ الوثير الجديد."},"id":"L005"},{"actor":"sami","start":29.896,"text":{"en":"OK. There is some oak in the store for the frame.","ar":"حسناً. يوجد بعض البلّوط في المستودع للهيكل."},"id":"L006"},{"actor":"layla","start":34.614,"text":{"en":"Good. Is there any soft foam for the cushions?","ar":"جيّد. هل يوجد أيّ إسفنج ناعم للوسائد؟"},"id":"L007"},{"actor":"sami","start":39.428,"text":{"en":"Yes, there is a lot of foam. But there isn't much leather.","ar":"نعم، يوجد الكثير من الإسفنج. لكن لا يوجد الكثير من الجلد."},"id":"L008"},{"actor":"layla","start":44.554,"text":{"en":"Then let's use velvet for the cover.","ar":"إذاً لنستخدم المخمل للغطاء."},"id":"L009"},{"actor":"layla","start":47.928,"text":{"en":"Right now, I am finishing the design.","ar":"في هذه اللحظة، أنا أُنهي التصميم."},"id":"L010"},{"actor":"sami","start":51.71,"text":{"en":"Good. How many armchairs do we make?","ar":"جيّد. كم كرسيّاً وثيراً نصنع؟"},"id":"L011"},{"actor":"layla","start":55.924,"text":{"en":"Just one prototype first.","ar":"نموذجاً أوّليّاً واحداً فقط في البداية."},"id":"L012"},{"actor":"sami","start":59.202,"text":{"en":"Three sentences now. True, False, or Not Given?","ar":"ثلاث جمل الآن. صحيح، خطأ، أم غير مذكور؟"},"id":"L013"},{"actor":"sami","start":64.64,"text":{"en":"There is a lot of leather.","ar":"يوجد الكثير من الجلد."},"subHold":6.666,"id":"L014"},{"actor":"sami","start":71.306,"text":{"en":"False. I said there isn't much leather.","ar":"خطأ. قلتُ إنّه لا يوجد الكثير من الجلد."},"id":"L015"},{"actor":"sami","start":75.424,"text":{"en":"Layla is finishing the design now.","ar":"ليلى تُنهي التصميم الآن."},"subHold":7.976,"id":"L016"},{"actor":"sami","start":83.4,"text":{"en":"True. She said: right now, I am finishing the design.","ar":"صحيح. قالت: في هذه اللحظة، أنا أُنهي التصميم."},"id":"L017"},{"actor":"sami","start":88.958,"text":{"en":"They will make ten armchairs first.","ar":"سيصنعون عشرة كراسٍ وثيرة أوّلاً."},"subHold":7.866,"id":"L018"},{"actor":"sami","start":96.824,"text":{"en":"False. Layla said just one prototype first.","ar":"خطأ. قالت ليلى نموذجاً أوّليّاً واحداً فقط."},"id":"L019"},{"actor":"layla","start":101.998,"text":{"en":"Three phrases carry that whole talk.","ar":"ثلاث عبارات تحمل ذلك الحديث كلّه."},"id":"L020"},{"actor":"layla","start":105.468,"text":{"en":"There is some. Is there any? There isn't much.","ar":"يوجد بعض. هل يوجد أيّ؟ لا يوجد الكثير."},"id":"L021"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d4356d448138cf87","b