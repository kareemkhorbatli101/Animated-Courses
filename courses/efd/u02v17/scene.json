في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الثانية، المواد والخشب."},"id":"L001"},{"actor":"nour","start":7.472,"text":{"en":"This is Part 7, Completing the Order. You will complete an order form and phone the supplier.","ar":"هذا الجزء السابع، إكمال الطلبيّة. ستكمل استمارة طلب وتتّصل بالمورِّد."},"id":"L002"},{"actor":"nour","start":14.662,"text":{"en":"Now complete the order form from that stock check.","ar":"الآن أكمل استمارة الطلب من ذلك الجرد."},"id":"L003"},{"actor":"nour","start":18.708,"text":{"en":"The first is done: oak boards, fifteen.","ar":"الأوّل محلول: ألواح بلّوط، خمسة عشر."},"id":"L004"},{"actor":"nour","start":22.658,"text":{"en":"Clamps. More, or none?","ar":"المشابك. المزيد، أم لا شيء؟"},"subHold":8.062,"id":"L005"},{"actor":"nour","start":30.72,"text":{"en":"More. We are low on clamps.","ar":"المزيد. المشابك عندنا قليلة."},"id":"L006"},{"actor":"nour","start":34.838,"text":{"en":"Foam. Some, or none?","ar":"الإسفنج. بعضه، أم لا شيء؟"},"subHold":7.777,"id":"L007"},{"actor":"nour","start":42.615,"text":{"en":"None, because there is enough foam.","ar":"لا شيء، لأنّ الإسفنج كافٍ."},"id":"L008"},{"actor":"nour","start":45.941,"text":{"en":"Order what is low. Do not order what is enough.","ar":"اطلب ما قلّ. لا تطلب ما يكفي."},"id":"L009"},{"actor":"nour","start":50.803,"text":{"en":"Now the role play. Abu Fares, let us take the order.","ar":"الآن لعب الأدوار. أبا فارس، لنأخذ الطلب."},"id":"L010"},{"actor":"nour","start":56.265,"text":{"en":"Do you have any oak boards?","ar":"هل لديك أيّ ألواح بلّوط؟"},"id":"L011"},{"actor":"omar","start":58.991,"text":{"en":"Yes, how many?","ar":"نعم، كم تحتاجين؟"},"id":"L012"},{"actor":"nour","start":61.213,"text":{"en":"Fifteen, please. And do you have clamps?","ar":"خمسة عشر، من فضلك. وهل لديك مشابك؟"},"id":"L013"},{"actor":"omar","start":66.003,"text":{"en":"Yes, a lot.","ar":"نعم، الكثير."},"id":"L014"},{"actor":"nour","start":68.225,"text":{"en":"Please add ten. When can you deliver?","ar":"أضف عشرة من فضلك. متى تستطيع التوصيل؟"},"id":"L015"},{"actor":"omar","start":72.583,"text":{"en":"On Sunday.","ar":"يوم الأحد."},"id":"L016"},{"actor":"nour","start":74.805,"text":{"en":"Your turn. You are me, and he is the supplier.","ar":"دورك. أنت مكاني، وهو المورِّد."},"id":"L017"},{"actor":"nour","start":79.883,"text":{"en":"Ask for the oak boards.","ar":"اطلب ألواح البلّوط."},"subHold":6.705,"id":"L018"},{"actor":"nour","start":86.588,"text":{"en":"Do you have any oak boards?","ar":"هل لديك أيّ ألواح بلّوط؟"},"id":"L019"},{"actor":"nour","start":89.314,"text":{"en":"Say the amount.","ar":"قل الكمّيّة."},"subHold":6.016,"id":"L020"},{"actor":"nour","start":95.33,"text":{"en":"Fifteen, please.","ar":"خمسة عشر، من فضلك."},"id":"L021"},{"actor":"nour","start":97.984,"text":{"en":"Ask the delivery day.","ar":"اسأل عن يوم التوصيل."},"subHold":6.587,"id":"L022"},{"actor":"nour","start":104.571,"text":{"en":"When can you deliver?","ar":"متى تستطيع التوصيل؟"},"id":"L023"},{"actor":"omar","start":107.033,"text":{"en":"Now a harder one. I have no clamps this week.","ar":"الآن واحدة أصعب. ليس لديّ مشابك هذا الأسبوع."},"id":"L024"},{"actor":"nour","start":110.863,"text":{"en":"How do you agree a plan for later, politely?","ar":"كيف تتّفق على خطّة لاحقة، بلباقة؟"},"subHold":8.924,"id":"L025"},{"actor":"nour","start":119.787,"text":{"en":"That's OK. Can you send them next week?","ar":"لا بأس. هل تستطيع إرسالها الأسبوع القادم؟"},"id":"L026"},{"actor":"omar","start":124.289,"text":{"en":"Yes. I will send them on Sunday.","ar":"نعم. سأرسلها يوم الأحد."},"id":"L027"},{"actor":"nour","start":127.279,"text":{"en":"Say that's OK, ask for a new day, then thank him.","ar":"قل لا بأس، اطلب يوماً جديداً، ثمّ اشكره."},"id":"L028"},{"actor":"nour","start":131.685,"text":{"en":"A no with a date is not a no. It is a later yes.","ar":"«لا» مع تاريخ ليست «لا». إنّها «نعم» مؤجّلة."},"id":"L029"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016"