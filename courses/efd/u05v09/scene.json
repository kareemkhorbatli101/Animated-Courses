":7.608},{"i":0,"at":8.408,"dur":6.768},{"i":0,"at":15.526,"dur":3.096},{"i":0,"at":18.972,"dur":2.592},{"i":1,"at":21.914,"dur":4.584},{"i":0,"at":26.848,"dur":1.872},{"i":1,"at":29.07,"dur":2.496},{"i":0,"at":31.916,"dur":2.856},{"i":0,"at":35.122,"dur":2.952},{"i":0,"at":38.424,"dur":2.784},{"i":1,"at":41.558,"dur":3.144},{"i":0,"at":45.052,"dur":3.216},{"i":0,"at":48.618,"dur":4.656},{"i":1,"at":53.624,"dur":2.136},{"i":1,"at":60.113,"dur":2.928},{"i":1,"at":63.391,"dur":1.944},{"i":1,"at":69.512,"dur":2.496},{"i":1,"at":72.358,"dur":3.696},{"i":1,"at":82.171,"dur":3.384},{"i":0,"at":85.905,"dur":3.84},{"i":0,"at":90.095,"dur":3.48}],"speech":[{"actor":"sami","start":0.45,"text":{"en":"Welcome to English for Furniture Designers. This is Unit 5, Making a Piece: Steps and Process.","ar":"أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الخامسة، صناعة القطعة: الخطوات والعمليّة."},"id":"L001"},{"actor":"sami","start":8.408,"text":{"en":"This is Part 3, A Problem on the Line. You will hear a frame stopped before it moves on.","ar":"هذا الجزء الثالث، مشكلة على الخطّ. ستسمع هيكلاً يُوقَف قبل أن ينتقل."},"id":"L002"},{"actor":"sami","start":15.526,"text":{"en":"What can go wrong when a frame is made?","ar":"ما الذي قد يسوء حين يُصنع هيكل؟"},"id":"L003"},{"actor":"sami","start":18.972,"text":{"en":"Khaled, is the frame ready?","ar":"خالد، هل الهيكل جاهز؟"},"id":"L004"},{"actor":"khaled","start":21.914,"text":{"en":"Yes, it is assembled and sanded. But there is a problem.","ar":"نعم، جُمِّع وصُنفر. لكن هناك مشكلة."},"id":"L005"},{"actor":"sami","start":26.848,"text":{"en":"What is it?","ar":"ما هي؟"},"id":"L006"},{"actor":"khaled","start":29.07,"text":{"en":"One leg is not straight.","ar":"إحدى الأرجل ليست مستقيمة."},"id":"L007"},{"actor":"sami","start":31.916,"text":{"en":"Then it can't go to upholstery yet.","ar":"إذاً لا يمكن أن يذهب إلى التنجيد بعد."},"id":"L008"},{"actor":"sami","start":35.122,"text":{"en":"First, the leg must be fixed.","ar":"أوّلاً، يجب إصلاح الرجل."},"id":"L009"},{"actor":"sami","start":38.424,"text":{"en":"After that, it is checked again.","ar":"بعد ذلك، يُفحص مرّة أخرى."},"id":"L010"},{"actor":"khaled","start":41.558,"text":{"en":"OK. I will fix it now.","ar":"حسناً. سأصلحها الآن."},"id":"L011"},{"actor":"sami","start":45.052,"text":{"en":"Good. Quality first.","ar":"جيّد. الجودة أوّلاً."},"id":"L012"},{"actor":"sami","start":48.618,"text":{"en":"The first question is done. I asked about the frame.","ar":"السؤال الأوّل محلول. سألت عن الهيكل."},"id":"L013"},{"actor":"khaled","start":53.624,"text":{"en":"Is the frame assembled?","ar":"هل الهيكل مُجمَّع؟"},"subHold":6.489,"id":"L014"},{"actor":"khaled","start":60.113,"text":{"en":"Yes, it is assembled and sanded.","ar":"نعم، مُجمَّع ومصنفر."},"id":"L015"},{"actor":"khaled","start":63.391,"text":{"en":"What is the problem?","ar":"ما المشكلة؟"},"subHold":6.121,"id":"L016"},{"actor":"khaled","start":69.512,"text":{"en":"One leg is not straight.","ar":"إحدى الأرجل ليست مستقيمة."},"id":"L017"},{"actor":"khaled","start":72.358,"text":{"en":"What must happen before the frame goes to upholstery?","ar":"ماذا يجب أن يحدث قبل أن يذهب الهيكل إلى التنجيد؟"},"subHold":9.813,"id":"L018"},{"actor":"khaled","start":82.171,"text":{"en":"The leg must be fixed, and checked again.","ar":"يجب إصلاح الرجل، وفحصها مرّة أخرى."},"id":"L019"},{"actor":"sami","start":85.905,"text":{"en":"A bad frame under good fabric is still a bad sofa.","ar":"هيكل سيّئ تحت قماش جيّد يبقى كنبة سيّئة."},"id":"L020"},{"actor":"sami","start":90.095,"text":{"en":"That is why the line stops here and not later.","ar":"لهذا يتوقّف الخطّ هنا لا لاحقاً."},"id":"L021"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"0e26e57277f8155a","bytes":45648,"sha":"4e08f774ceb8aed3","address":"lines/0e26e57277f8155a.mp3"},{"key":"b6babc8297ffff24","bytes":40608,"sha":"d0eb9