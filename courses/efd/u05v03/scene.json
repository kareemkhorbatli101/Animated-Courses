":"Quality. ثلاثة مقاطع: QUAL-i-ty."},"id":"L017"},{"actor":"khaled","start":90.924,"text":{"en":"Which part of quality is loud?","ar":"أيّ مقطع في quality هو العالي؟"},"subHold":7.429,"id":"L018"},{"actor":"khaled","start":98.353,"text":{"en":"The first. QUAL-i-ty.","ar":"الأوّل. QUAL-i-ty."},"id":"L019"},{"actor":"sami","start":101.943,"text":{"en":"Process. Two parts: PRO-cess.","ar":"Process. مقطعان: PRO-cess."},"id":"L020"},{"actor":"khaled","start":106.469,"text":{"en":"Which part of process is loud?","ar":"أيّ مقطع في process هو العالي؟"},"subHold":7.453,"id":"L021"},{"actor":"khaled","start":113.922,"text":{"en":"The first. PRO-cess.","ar":"الأوّل. PRO-cess."},"id":"L022"},{"actor":"sami","start":117.296,"text":{"en":"Four are loud on the second part. Two are loud on the first.","ar":"أربع عالية في المقطع الثاني. واثنتان في الأوّل."},"id":"L023"},{"actor":"sami","start":122.71,"text":{"en":"Production and process look alike and sound different.","ar":"Production و process تتشابهان شكلاً وتختلفان صوتاً."},"id":"L024"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"0e26e57277f8155a","bytes":45648,"sha":"4e08f774ceb8aed3","address":"lines/0e26e57277f8155a.mp3"},{"key":"251a829c190c4943","bytes":38016,"sha":"7d4b78e90aeee7c4","address":"lines/251a829c190c4943.mp3"},{"key":"2cd60bb22b39e79b","bytes":26208,"sha":"8d1cd22f516326fe","address":"lines/2cd60bb22b39e79b.mp3"},{"key":"54a48a975ce40196","bytes":25200,"sha":"b87558283c365f87","address":"lines/54a48a975ce40196.mp3"},{"key":"7813a3dee8df9214","bytes":15696,"sha":"5d48f4bc35378b32","address":"lines/7813a3dee8df9214.mp3"},{"key":"54b6ec6c1c7a4082","bytes":19296,"sha":"8f0ea47b4ddc7ab5","address":"lines/54b6ec6c1c7a4082.mp3"},{"key":"ad0fba9018f3536b","bytes":26784,"sha":"f86aa9fc8750b6ea","address":"lines/ad0fba9018f3536b.mp3"},{"key":"443392e1d2a133f2","bytes":