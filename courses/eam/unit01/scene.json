n":"Yes, Ustaz.","ar":"نعم يا أستاذ."},"id":"L006"},{"actor":"maher","start":33.558,"text":{"en":"If you are not sure, ask us. We work as a team here.","ar":"إن لم تكن متأكداً، اسألنا. نحن نعمل كفريق هنا."},"id":"L007"},{"actor":"tarek","start":39.904,"text":{"en":"Thank you. I am happy to be here.","ar":"شكراً. أنا سعيد بوجودي هنا."},"id":"L008"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"869228648f58b442","bytes":27792,"sha":"475e6c036d8f484c","address":"lines/869228648f58b442.mp3"},{"key":"843eda6ce8bc1ed4","bytes":27792,"sha":"9479aba70168d3ed","address":"lines/843eda6ce8bc1ed4.mp3"},{"key":"830346376dd5b717","bytes":21168,"sha":"c73753ee055dc780","address":"lines/830346376dd5b717.mp3"},{"key":"6e6a554e64673f10","bytes":26928,"sha":"7d8c000e707259e7","address":"lines/6e6a554e64673f10.mp3"},{"key":"bc7c9108dafeea80","bytes":32832,"sha":"03b7571d60e665a5","address":"lines/bc7c9108dafeea80.mp3"},{"key":"d4ed987e2dd9f0cc","bytes":14256,"sha":"24e60f580cdbbc70","address":"lines/d4ed987e2dd9f0cc.mp3"},{"key":"ac06b9d823cfa3b4","bytes":30096,"sha":"b48cc9ea35462f48","address":"lines/ac06b9d823cfa3b4.mp3"},{"key":"6db4a4a8f3346247","bytes":22896,"sha":"37f4afba220a7f94","address":"lines/6db4a4a8f3346247.mp3"}],"music":{"enabled":false},"duck":[{"start":0.45,"dur":4.632},{"start":6.412,"dur":4.632},{"start":12.374,"dur":3.528},{"start":17.232,"dur":4.488},{"start":23.05,"dur":5.472},{"start":29.852,"dur":2.376},{"start":33.558,"dur":5.016},{"start":39.904,"dur":3.816}]},"timeline":{"audio":"audio.m4a","subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"vocab":{"cards":[{"lemma":"garage","at":"5.463","hold":"2.00","label":"garage","ar":"كراج","emoji":"🛠️"},{"lemma":"goggles","at":"24.410","hold":"2.00","label":"safety glasses","ar":"نظارات السلامة","emoji":"🥽"},{"lemma":"workshop","at":"27.051","hold":"2.00","label":"workshop /