:8.31,"id":"L013"},{"actor":"maher","start":74.162,"text":{"en":"BAT-ter-y. Three syllables. The first is loud.","ar":"ثلاثة مقاطع، والمقطع الأوّل هو الأقوى."},"id":"L014"},{"actor":"maher","start":80.32,"text":{"en":"SER-vice. Say it after me.","ar":"كلمة «صيانة». قلها بعدي."},"subHold":8.311,"id":"L015"},{"actor":"maher","start":88.631,"text":{"en":"SER-vice. Two syllables. The first is loud.","ar":"مقطعان، والمقطع الأوّل هو الأقوى."},"id":"L016"},{"actor":"maher","start":94.717,"text":{"en":"CUS-to-mer. Say it after me.","ar":"كلمة «زبون». قلها بعدي."},"subHold":8.465,"id":"L017"},{"actor":"maher","start":103.182,"text":{"en":"CUS-to-mer. Three syllables. The first is loud.","ar":"ثلاثة مقاطع، والمقطع الأوّل هو الأقوى."},"id":"L018"},{"actor":"maher","start":109.437,"text":{"en":"Well done. Say the loud part a little longer and stronger.","ar":"أحسنت. قل الجزء القويّ أطول قليلاً وأقوى."},"id":"L019"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d151f5932f8958b3","bytes":19296,"sha":"dfbb827359f21582","address":"lines/d151f5932f8958b3.mp3"},{"key":"f1c2ccfa9de7d37e","bytes":21744,"sha":"efc2fd8f1a9a102d","address":"lines/f1c2ccfa9de7d37e.mp3"},{"key":"5a6596fc7be1008b","bytes":18576,"sha":"0b0fefc83ecac630","address":"lines/5a6596fc7be1008b.mp3"},{"key":"76af305fcb4aa622","bytes":21168,"sha":"caa651c8e7e7353d","address":"lines/76af305fcb4aa622.mp3"},{"key":"d14b4d032e71bb80","bytes":18576,"sha":"78d00e4af6411090","address":"lines/d14b4d032e71bb80.mp3"},{"key":"3d81e4973fbab82b","bytes":21600,"sha":"8d1dfd0286766323","address":"lines/3d81e4973fbab82b.mp3"},{"key":"2ce7182e2d90ee7a","bytes":23184,"sha":"728eaa5f4ae9023e","address":"lines/2ce7182e2d90ee7a.mp3"},{"key":"c83893a6863d323b","bytes":34992,"sha":"9b977e0a409a5c87","address":"lines/c83893a6863d323b.mp3"},{"key":"378ba8ad024cf61f","bytes":22464,"sha":"60feff032fd41398","address":"l