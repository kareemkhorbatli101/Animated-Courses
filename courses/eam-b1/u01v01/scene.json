":"L006"},{"actor":"maher","start":38.25,"text":{"en":"This is the boot, at the back of the car.","ar":"هذا صندوق السيارة، في الخلف."},"id":"L007"},{"actor":"maher","start":42.886,"text":{"en":"This is the job card. The service advisor writes it for every car.","ar":"هذه بطاقة العمل. يكتبها مستشار الخدمة لكلّ سيارة."},"id":"L008"},{"actor":"maher","start":49.802,"text":{"en":"A person who repairs and checks cars. What is the word?","ar":"شخص يصلح ويفحص السيارات. ما الكلمة؟"},"id":"L009"},{"actor":"maher","start":61.053,"text":{"en":"A mechanic. A mechanic repairs and checks cars.","ar":"ميكانيكي. الميكانيكي يصلح ويفحص السيارات."},"id":"L010"},{"actor":"maher","start":67.105,"text":{"en":"The car comes in for this every year. What is it?","ar":"تأتي السيارة من أجله كلّ سنة. ما هو؟"},"id":"L011"},{"actor":"maher","start":77.476,"text":{"en":"A service. The car comes in for a service every year.","ar":"صيانة. تأتي السيارة للصيانة كلّ سنة."},"id":"L012"},{"actor":"tarek","start":83.672,"text":{"en":"Who writes the job card?","ar":"من يكتب بطاقة العمل؟"},"id":"L013"},{"actor":"tarek","start":90.484,"text":{"en":"The service advisor writes the job card.","ar":"مستشار الخدمة يكتب بطاقة العمل."},"id":"L014"},{"actor":"maher","start":95.12,"text":{"en":"Good. Today, find the engine and the battery on one car.","ar":"جيّد. اليوم، جد المحرّك والبطارية على سيارة واحدة."},"id":"L015"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d986a5df7aedf381","bytes":27072,"sha":"83d1fb44689bd148","address":"lines/d986a5df7aedf381.mp3"},{"key":"e9d2720053832944","bytes":33984,"sha":"1e5ec4e7986499af","address":"lines/e9d2720053832944.mp3"},{"key":"6244525ca7947613","bytes":25920,"sha":"0a1065b267dcdf20","address":"lines/6244525ca7947613.mp3"},{"key":"a4dcf33109260a84","bytes":33264,"sha":"3f867b4e9b756691","address":"lines/a4dcf33109260a84.mp3"},{"key":"339ed982f1d