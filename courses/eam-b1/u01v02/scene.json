n":"The battery. It stores electricity to start the car.","ar":"البطارية. تخزّن الكهرباء لتشغيل السيارة."},"id":"L010"},{"actor":"tarek","start":63.338,"text":{"en":"Ustaz, what do we call the cover over the engine?","ar":"أستاذ، ماذا نسمّي الغطاء فوق المحرّك؟"},"subHold":9.698,"id":"L011"},{"actor":"tarek","start":73.036,"text":{"en":"The bonnet. In American English they say hood. Both are correct.","ar":"غطاء المحرّك. في الإنجليزية الأمريكية يقولون hood. كلاهما صحيح."},"id":"L012"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"938fc56d525caf3a","bytes":40464,"sha":"2e7d8dc2035bbb8e","address":"lines/938fc56d525caf3a.mp3"},{"key":"7b0daae627f29a93","bytes":43776,"sha":"ec06bcf3188bc630","address":"lines/7b0daae627f29a93.mp3"},{"key":"02908170d2250803","bytes":28224,"sha":"7713b133c6bacd5b","address":"lines/02908170d2250803.mp3"},{"key":"481e44575148a0af","bytes":24192,"sha":"831e445611136d9e","address":"lines/481e44575148a0af.mp3"},{"key":"acf78915f7ea8fb6","bytes":20880,"sha":"0e60adc499fd050b","address":"lines/acf78915f7ea8fb6.mp3"},{"key":"f4085b11cb07535d","bytes":20592,"sha":"b2e73329f457806d","address":"lines/f4085b11cb07535d.mp3"},{"key":"6006277da7d2541e","bytes":28080,"sha":"068630ca7ff598b5","address":"lines/6006277da7d2541e.mp3"},{"key":"1515612f75e92b6e","bytes":26208,"sha":"156be3b54226c72c","address":"lines/1515612f75e92b6e.mp3"},{"key":"0fa174e2d8faada3","bytes":26208,"sha":"75c69a56b861c198","address":"lines/0fa174e2d8faada3.mp3"},{"key":"f4b8e445bb6a0788","bytes":30960,"sha":"5b28f6a93555b704","address":"lines/f4b8e445bb6a0788.mp3"},{"key":"7fb08c5660f01391","bytes":22896,"sha":"34a6728bc90a6203","address":"lines/7fb08c5660f01391.mp3"},{"key":"0b44e12f68bb737f","bytes":37584,"sha":"e26acd2cfdcf017c","address":"lines/0b44e12f68bb737f.mp3"}],"music":{"enabled":false},"duck":[{"start":0.45,"dur":6.744},{"start":7.544,"dur":7.