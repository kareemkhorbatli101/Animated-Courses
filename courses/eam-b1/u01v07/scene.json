":7.99,"text":{"en":"This is Part 2, Grammar Review.","ar":"هذا الجزء الثاني، مراجعة القواعد."},"id":"L003"},{"actor":"maher","start":11.364,"text":{"en":"Find the mistake, then choose the correct sentence.","ar":"جد الخطأ، ثمّ اختر الجملة الصحيحة."},"id":"L004"},{"actor":"maher","start":15.314,"text":{"en":"Each sentence has one mistake.","ar":"في كلّ جملة خطأ واحد."},"id":"L005"},{"actor":"maher","start":18.472,"text":{"en":"Find it in the quiet, then listen.","ar":"جده في الصمت، ثمّ استمع."},"id":"L006"},{"actor":"maher","start":21.75,"text":{"en":"The garage service many cars every day. What is wrong?","ar":"في هذه الجملة خطأ. ما هو؟"},"subHold":11.121,"id":"L007"},{"actor":"maher","start":32.871,"text":{"en":"The garage services many cars every day.","ar":"الكراج يصون سيارات كثيرة كلّ يوم."},"id":"L008"},{"actor":"maher","start":36.629,"text":{"en":"Look! Nabil change the oil now. What is wrong?","ar":"في هذه الجملة خطأ. ما هو؟"},"subHold":11.369,"id":"L009"},{"actor":"maher","start":47.998,"text":{"en":"Look! Nabil is changing the oil now.","ar":"انظر! نبيل يغيّر الزيت الآن."},"id":"L010"},{"actor":"maher","start":52.524,"text":{"en":"She check the brakes every service. What is wrong?","ar":"في هذه الجملة خطأ. ما هو؟"},"subHold":10.454,"id":"L011"},{"actor":"maher","start":62.978,"text":{"en":"She checks the brakes every service.","ar":"هي تفحص الفرامل في كلّ صيانة."},"id":"L012"},{"actor":"maher","start":66.208,"text":{"en":"We are repair the engine now. What is wrong?","ar":"في هذه الجملة خطأ. ما هو؟"},"subHold":9.98,"id":"L013"},{"actor":"maher","start":76.188,"text":{"en":"We are repairing the engine now.","ar":"نحن نصلح المحرّك الآن."},"id":"L014"},{"actor":"maher","start":79.274,"text":{"en":"Now, write two sentences about your work or study.","ar":"الآن، اكتب جملتين عن عملك أو دراستك."},"id":"L015"},{"actor":"maher","start":83.536,"text":{"en":"One about every day, and one about now.","ar":"واحدة عن كلّ يوم، وواحدة عن الآن."},"id":"L016"},{"actor":"maher","start":87.246,"text":{"en":"Pause the video, and write them now.","ar":"أوقف الفيديو، واكتبهما الآن."},"id":"L017"},{"actor":"maher","start":90.62,"text":{"en":"Here is an example. I check cars every day. Right now, I am learning English.","ar":"هذا مثال. أفحص السيارات كلّ يوم. الآن، أتعلّم الإنجليزية."},"id":"L018"},{"actor":"maher","start":98.314,"text":{"en":"Now choose the correct sentence.","ar":"الآن اختر الجملة الصحيحة."},"id":"L019"},{"actor":"maher","start":101.352,"text":{"en":"Which sentence is correct for now? A, B, C or D?","ar":"أيّ جملة صحيحة للآن؟ أ، ب، ج أم د؟"},"subHold":11.511,"id":"L020"},{"actor":"maher","start":112.863,"text":{"en":"B. Nabil is changing the oil.","ar":"ب. Nabil is changing the oil."},"id":"L021"},{"actor":"maher","start":116.069,"text":{"en":"Which sentence is correct for a routine? A, B, C or D?","ar":"أيّ جملة صحيحة لعمل يومي؟ أ، ب، ج أم د؟"},"subHold":12.153,"id":"L022"},{"actor":"maher","start":128.222,"text":{"en":"A. The garage services cars.","ar":"أ. The garage services cars."},"id":"L023"},{"actor":"maher","start":131.548,"text":{"en":"You will see these verbs again in the Part 5 reading.","ar":"سترى هذه الأفعال مرّة أخرى في قراءة الجزء الخامس."},"id":"L024"},{"actor":"maher","start":135.618,"text":{"en":"Watch for them.","ar":"انتبه لها."},"id":"L025"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d151f5932f8958b3","bytes":19296,"sha":"dfbb827359f21582","address":"lines/d151f5932f8958b3.mp3"},{"key":"f1c2ccfa9de7d37e","bytes":21744,"sha":"efc2fd8f1a9a102d","address":"lines/f1c2ccfa9de7d37e.mp3"},{"key":"9367688269687dab","bytes":18144,"sha":"f59f94c6e5c56056","address":"lines/9367688269687dab.mp3"},{"key":"3e7292622bea1b43","bytes":21600,"sha":"68c2d7168ace8fea","address":"lines/3e7292622bea1b43.mp3"},{"key":"f01bd03e971cbb5c","bytes":16848,"sha":"c23ad3da589a4636","address":"lines/f01bd0