:0,"at":144.471,"dur":4.44},{"i":0,"at":154.735,"dur":4.584},{"i":0,"at":159.669,"dur":4.32}],"speech":[{"actor":"maher","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل."},"id":"L001"},{"actor":"maher","start":4.016,"text":{"en":"This is Unit 1, Introduction to the Vehicle.","ar":"هذه الوحدة الأولى، مقدّمة إلى المركبة."},"id":"L002"},{"actor":"maher","start":7.99,"text":{"en":"This is Part 9, Syria in Focus. It is for practitioners.","ar":"هذا الجزء التاسع، سوريا في التركيز. إنّه للممارسين."},"id":"L003"},{"actor":"maher","start":14.196,"text":{"en":"A young mechanic opens her own workshop.","ar":"ميكانيكية شابّة تفتح ورشتها الخاصّة."},"id":"L004"},{"actor":"maher","start":17.762,"text":{"en":"Before you read. What problems can a young mechanic have in Damascus?","ar":"قبل أن تقرأ. ما المشكلات التي قد يواجهها ميكانيكي شاب في دمشق؟"},"subHold":12.675,"id":"L005"},{"actor":"maher","start":30.437,"text":{"en":"Money, rent and tools. Listen for them.","ar":"المال والإيجار والأدوات. استمع إليها."},"id":"L006"},{"actor":"","start":35.059,"text":{"en":"Lina studied to be a mechanic,","ar":"درست لينا لتصبح ميكانيكية،"},"speaker":"Narrator","id":"L007"},{"actor":"","start":38.025,"text":{"en":"and she wanted to open her own workshop in Damascus.","ar":"وأرادت أن تفتح ورشتها الخاصّة في دمشق."},"speaker":"Narrator","id":"L008"},{"actor":"","start":42.287,"text":{"en":"She had good skills but only a little money.","ar":"كانت لديها مهارات جيّدة لكن القليل من المال فقط."},"speaker":"Narrator","id":"L009"},{"actor":"","start":45.733,"text":{"en":"Rent for a big garage was expensive, and new tools cost a lot.","ar":"كان إيجار كراج كبير غالياً، والأدوات الجديدة تكلّف كثيراً."},"speaker":"Narrator","id":"L010"},{"actor":"","start":50.859,"text":{"en":"So Lina started small.","ar":"لذلك بدأت لينا صغيرة."},"speaker":"Narrator","id":"L011"},{"actor":"","start":53.753,"text":{"en":"She rented one bay and bought good second-hand tools.","ar":"استأجرت موقعاً واحداً واشترت أدوات مستعملة جيّدة."},"speaker":"Narrator","id":"L012"},{"actor":"","start":57.823,"text":{"en":"She worked hard and did honest work,","ar":"عملت بجدّ وقامت بعمل أمين،"},"speaker":"Narrator","id":"L013"},{"actor":"","start":61.077,"text":{"en":"and she always explained the problem to the customer clearly.","ar":"وكانت دائماً تشرح المشكلة للزبون بوضوح."},"speaker":"Narrator","id":"L014"},{"actor":"","start":65.171,"text":{"en":"Slowly, drivers came back, and they told their friends.","ar":"ببطء، عاد السائقون، وأخبروا أصدقاءهم."},"speaker":"Narrator","id":"L015"},{"actor":"","start":69.937,"text":{"en":"After one year, Lina was ready to rent a bigger workshop and hire one helper.","ar":"بعد سنة، كانت لينا مستعدّة لاستئجار ورشة أكبر وتوظيف مساعد واحد."},"speaker":"Narrator","id":"L016"},{"actor":"","start":75.615,"text":{"en":"She says:","ar":"تقول:"},"speaker":"Narrator","id":"L017"},{"actor":"lina","start":77.789,"text":{"en":"In Syria, people trust a mechanic who is honest and careful.","ar":"في سوريا، يثق الناس بالميكانيكي الأمين والحريص."},"id":"L018"},{"actor":"maher","start":82.531,"text":{"en":"Here is an example. What did Lina want to open? Her own workshop.","ar":"هذا مثال. ماذا أرادت لينا أن تفتح؟ ورشتها الخاصّة."},"id":"L019"},{"actor":"maher","start":89.553,"text":{"en":"What two problems did Lina have?","ar":"ما المشكلتان اللتان واجهتهما لينا؟"},"subHold":7.666,"id":"L020"},{"actor":"maher","start":97.219,"text":{"en":"Little money. Rent was expensive. New tools cost a lot.","ar":"مال قليل. كان الإيجار غالياً. الأدوات الجديدة تكلّف كثيراً."},"id":"L021"},{"actor":"maher","start":103.953,"text":{"en":"How did she start?","ar":"كيف بدأت؟"},"subHold":6.051,"id":"L022"},{"actor":"maher","start":110.004,"text":{"en":"She rented one bay and bought good second-hand tools.","ar":"استأجرت موقعاً واحداً واشترت أدوات مستعملة جيّدة."},"id":"L023"},{"actor":"maher","start":114.074,"text":{"en":"Why did customers come back?","ar":"لماذا عاد الزبائن؟"},"subHold":7.311,"id":"L024"},{"actor":"maher","start":121.385,"text":{"en":"She did honest work and explained the problem clearly.","ar":"قامت بعمل أمين وشرحت المشكلة بوضوح."},"id":"L025"},{"actor":"maher","start":125.335,"text":{"en":"Now Lina has a little more money. What should she do?","ar":"الآن لدى لينا مال أكثر قليلاً. ماذا يجب أن تفعل؟"},"id":"L026"},{"actor":"maher","start":130.413,"text":{"en":"A new diagnostic machine finds faults fast, but it costs a lot.","ar":"جهاز تشخيص جديد يجد الأعطال بسرعة، لكنّه يكلّف كثيراً."},"id":"L027"},{"actor":"maher","start":135.347,"text":{"en":"A bigger workshop means more cars, but the rent is higher.","ar":"ورشة أكبر تعني سيارات أكثر، لكنّ الإيجار أعلى."},"id":"L028"},{"actor":"maher","start":139.921,"text":{"en":"One helper means more work done, and Lina can teach someone.","ar":"مساعد واحد يعني عملاً أكثر، ويمكن للينا أن تعلّم أحداً."},"id":"L029"},{"actor":"maher","start":144.471,"text":{"en":"What do you think Lina should do? Use the frame.","ar":"ماذا تعتقد أن على لينا أن تفعل؟ استخدم العبارات."},"subHold":10.264,"id":"L030"},{"actor":"maher","start":154.735,"text":{"en":"One answer: she should hire a helper, because she can do more work.","ar":"جواب واحد: يجب أن توظّف مساعداً، لأنّها تستطيع القيام بعمل أكثر."},"id":"L031"},{"actor":"maher","start":159.669,"text":{"en":"Your answer can be different. Give your reasons.","ar":"جوابك يمكن أن يكون مختلفاً. أعطِ أسبابك."},"id":"L032"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d151f5932f8958b3","bytes":19296,"sha":"dfbb827359f21582","address":"lines/d151f5932f8958b3.mp3"},{"key":"f1c2ccfa9de7d37e","bytes":21744,"sha":"efc2fd8f1a9a102d","address":"lines/f1c2ccfa9de7d37e.mp3"},{"key":"68380f2d8a541043","bytes":35136,"sha":"9fce5628d2bb24b5","address":"lines/68380f2d8a541043.mp3"},{"key":"faa850f98dc505fc","byte