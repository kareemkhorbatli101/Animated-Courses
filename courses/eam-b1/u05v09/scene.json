08},{"i":0,"at":15.958,"dur":6.024},{"i":1,"at":22.332,"dur":3.312},{"i":0,"at":25.994,"dur":6.192},{"i":1,"at":32.536,"dur":2.352},{"i":0,"at":35.238,"dur":5.904},{"i":0,"at":41.492,"dur":2.472},{"i":1,"at":44.314,"dur":1.872},{"i":0,"at":46.536,"dur":2.712},{"i":0,"at":49.598,"dur":1.872},{"i":0,"at":55.705,"dur":1.872},{"i":0,"at":57.927,"dur":1.872},{"i":0,"at":63.976,"dur":1.872},{"i":0,"at":66.198,"dur":1.944},{"i":0,"at":72.73,"dur":1.872},{"i":0,"at":74.952,"dur":8.544},{"i":0,"at":83.846,"dur":7.464}],"speech":[{"actor":"rana","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1. This is Unit 5, The Service Process, from check-in to handover.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الخامسة، عمليّة الصيانة، من الاستقبال إلى التسليم."},"id":"L001"},{"actor":"rana","start":8.6,"text":{"en":"This is Part 3, Where Is the Car Now? You will hear a customer ask, and meet the passive in the past.","ar":"هذا الجزء الثالث، أين السيارة الآن؟ ستسمع عميلاً يسأل، وتلتقي بالمجهول في الماضي."},"id":"L002"},{"actor":"rana","start":15.958,"text":{"en":"Before you listen, think about this. What does a customer ask when the car is not ready?","ar":"قبل أن تستمع، فكّر في هذا. ماذا يسأل العميل عندما لا تكون السيارة جاهزة؟"},"id":"L003"},{"actor":"aboud","start":22.332,"text":{"en":"Hello. Is my car ready?","ar":"مرحباً. هل سيارتي جاهزة؟"},"id":"L004"},{"actor":"rana","start":25.994,"text":{"en":"Not yet, but let me check. It was booked in this morning, and now it is in the workshop.","ar":"ليس بعد، لكن دعني أتحقّق. سُجِّلت هذا الصباح، وهي الآن في الورشة."},"id":"L005"},{"actor":"aboud","start":32.536,"text":{"en":"How long will it take?","ar":"كم سيستغرق الأمر؟"},"id":"L006"},{"actor":"rana","start":35.238,"text":{"en":"The oil is changed, and the brakes are checked now. After that, it is road-tested.","ar":"الزيت قد غُيِّر، والمكابح تُفحَص الآن. وبعد ذلك، تُختبَر على الطريق."},"id":"L007"},{"actor":"rana","start":41.492,"text":{"en":"It will be ready at three o'clock.","ar":"ستكون جاهزة في الساعة الثالثة."},"id":"L008"},{"actor":"aboud","start":44.314,"text":{"en":"Good.","ar":"جيّد."},"id":"L009"},{"actor":"rana","start":46.536,"text":{"en":"We will call you when it is handed over.","ar":"سنتّصل بك عند تسليمها."},"id":"L010"},{"actor":"rana","start":49.598,"text":{"en":"Where is the car now?","ar":"أين السيارة الآن؟"},"subHold":6.107,"id":"L011"},{"actor":"rana","start":55.705,"text":{"en":"In the workshop.","ar":"في الورشة."},"id":"L012"},{"actor":"rana","start":57.927,"text":{"en":"What is checked now?","ar":"ما الذي يُفحَص الآن؟"},"subHold":6.049,"id":"L013"},{"actor":"rana","start":63.976,"text":{"en":"The brakes.","ar":"المكابح."},"id":"L014"},{"actor":"rana","start":66.198,"text":{"en":"When will the car be ready?","ar":"متى ستكون السيارة جاهزة؟"},"subHold":6.532,"id":"L015"},{"actor":"rana","start":72.73,"text":{"en":"At three o'clock.","ar":"في الساعة الثالثة."},"id":"L016"},{"actor":"rana","start":74.952,"text":{"en":"Notice one sentence in there. It was booked in this morning. That is the same passive, but in the past: was instead of is.","ar":"لاحظ جملة واحدة هناك. It was booked in this morning. هي المجهول نفسه، لكن في الماضي: was بدلاً من is."},"id":"L017"},{"actor":"rana","start":83.846,"text":{"en":"So a whole day of a car can be told in one form. It was booked in, it is being serviced, it will be handed over.","ar":"فيمكن حكاية يوم سيارة كامل بصيغة واحدة. سُجِّلت، وهي تُصان، وستُسلَّم."},"id":"L018"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"b58c8220566a6f9e","bytes":46800,"sha":"21328ed89a7743f6","address":"lines/b58c8220566a6f9e.mp3"},{"key":"103e9f57282a3085","bytes":42048,"sha":"72fc863986c0bc6e","address":"lines/103e9f57282a3085.mp3"},{"key":"93f039565ea0e7d8","bytes":36144,"sha":"780ba135400ecfc5","address":"lines/93f039565ea0e7d8.mp