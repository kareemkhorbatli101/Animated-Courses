},"subHold":6.299,"id":"L006"},{"actor":"nabil","start":36.201,"text":{"en":"It stops the engine getting too hot.","ar":"يمنع المحرّك من السخونة الشديدة."},"id":"L007"},{"actor":"nabil","start":39.647,"text":{"en":"What does brake fluid do?","ar":"ماذا يفعل زيت الفرامل؟"},"subHold":6.919,"id":"L008"},{"actor":"nabil","start":46.566,"text":{"en":"It makes the brakes work.","ar":"يجعل الفرامل تعمل."},"id":"L009"},{"actor":"nabil","start":49.268,"text":{"en":"What does washer fluid do?","ar":"ماذا يفعل سائل غسل الزجاج؟"},"subHold":7.001,"id":"L010"},{"actor":"nabil","start":56.269,"text":{"en":"It cleans the windscreen.","ar":"ينظّف الزجاج الأمامي."},"id":"L011"},{"actor":"nabil","start":58.995,"text":{"en":"What does the engine do with fuel?","ar":"ماذا يفعل المحرّك بالوقود؟"},"subHold":7.688,"id":"L012"},{"actor":"nabil","start":66.683,"text":{"en":"The engine burns it to make power.","ar":"يحرقه المحرّك لتوليد القدرة."},"id":"L013"},{"actor":"tarek","start":69.841,"text":{"en":"What does the alternator do: makes electricity, cools the engine, or cleans the oil?","ar":"ماذا يفعل الدينامو: يولّد الكهرباء، أم يبرّد المحرّك، أم ينظّف الزيت؟"},"subHold":14.085,"id":"L014"},{"actor":"tarek","start":83.926,"text":{"en":"It makes electricity while the engine runs.","ar":"يولّد الكهرباء أثناء دوران المحرّك."},"id":"L015"},{"actor":"tarek","start":87.708,"text":{"en":"What do you use a dipstick for?","ar":"لماذا تستخدم مقياس الزيت؟"},"subHold":7.392,"id":"L016"},{"actor":"tarek","start":95.1,"text":{"en":"To check the oil level.","ar":"لفحص مستوى الزيت."},"id":"L017"},{"actor":"tarek","start":97.826,"text":{"en":"And what does coolant do?","ar":"وماذا يفعل سائل التبريد؟"},"subHold":6.727,"id":"L018"},{"actor":"tarek","start":104.553,"text":{"en":"It stops the engine getting too hot.","ar":"يمنع المحرّك من السخونة الشديدة."},"id":"L019"},{"actor":"nabil","start":107.951,"text":{"en":"Last, four sentences. Choose oil, coolant, filter, or battery.","ar":"أخيراً، أربع جمل. اختر الزيت أو سائل التبريد أو الفلتر أو البطارية."},"id":"L020"},{"actor":"nabil","start":115.117,"text":{"en":"Check the engine blank with the dipstick.","ar":"افحص فراغ المحرّك بمقياس الزيت."},"subHold":8.291,"id":"L021"},{"actor":"nabil","start":123.408,"text":{"en":"Oil. Check the engine oil with the dipstick.","ar":"الزيت. افحص زيت المحرّك بمقياس الزيت."},"id":"L022"},{"actor":"nabil","start":127.91,"text":{"en":"The blank keeps the engine cool.","ar":"الفراغ يبقي المحرّك بارداً."},"subHold":7.571,"id":"L023"},{"actor":"nabil","start":135.481,"text":{"en":"The coolant keeps the engine cool.","ar":"سائل التبريد يبقي المحرّك بارداً."},"id":"L024"},{"actor":"nabil","start":138.591,"text":{"en":"The air blank cleans the air going into the engine.","ar":"فراغ الهواء ينظّف الهواء الداخل إلى المحرّك."},"subHold":9.696,"id":"L025"},{"actor":"nabil","start":148.287,"text":{"en":"The air filter cleans the air going into the engine.","ar":"فلتر الهواء ينظّف الهواء الداخل إلى المحرّك."},"id":"L026"},{"actor":"nabil","start":152.357,"text":{"en":"The blank stores electricity to start the car.","ar":"الفراغ يخزّن الكهرباء لتشغيل السيارة."},"subHold":9.186,"id":"L027"},{"actor":"nabil","start":161.543,"text":{"en":"The battery stores electricity to start the car.","ar":"البطارية تخزّن الكهرباء لتشغيل السيارة."},"id":"L028"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"083824c8d6aad25b","bytes":38016,"sha":"74f8de2430dfa199","address":"lines/083824c8d6aad25b.mp3"},{"key":"b4d14da76bf38a52","bytes":38016,"sha":"24749399c596bd0a","address":"lines/b4d14da76bf38a52.mp3"},{"key":"3458f18046f7fc2a","bytes":32400,"sha":"628c6279ccffbf66","address":"lines/3458f18046f7fc2a.mp3"},{"key":"6733e76f19e9c087","bytes":13536,"sha":"61d02aaee4545a58","address":"lines/6733e76f19e9c087.mp3"},{"key":"e2f96111fe104757","bytes":19872,"sha":"1e624ea7c7c81282","address":"lines/e2