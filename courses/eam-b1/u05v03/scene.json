dur":6.12},{"i":0,"at":15.142,"dur":5.904},{"i":0,"at":21.396,"dur":6.6},{"i":0,"at":28.346,"dur":7.128},{"i":0,"at":35.824,"dur":6.744},{"i":0,"at":42.918,"dur":7.08},{"i":0,"at":50.348,"dur":6.696},{"i":0,"at":57.394,"dur":6.648},{"i":0,"at":64.392,"dur":6.216},{"i":1,"at":70.958,"dur":2.976},{"i":1,"at":78.934,"dur":3.528},{"i":0,"at":82.812,"dur":9.696},{"i":1,"at":92.858,"dur":9.624},{"i":1,"at":110.482,"dur":7.968},{"i":0,"at":118.8,"dur":5.04}],"speech":[{"actor":"lina","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1. This is Unit 5, The Service Process, from check-in to handover.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الخامسة، عمليّة الصيانة، من الاستقبال إلى التسليم."},"id":"L001"},{"actor":"lina","start":8.672,"text":{"en":"This is Part 1, Pronunciation. You will practise the stress in six words.","ar":"هذا الجزء الأوّل، النطق. ستتدرّب على النبر في ستّ كلمات."},"id":"L002"},{"actor":"lina","start":15.142,"text":{"en":"Six words from this unit. Say each one aloud and stress the loud syllable.","ar":"ستّ كلمات من هذه الوحدة. انطق كلّ واحدة بصوت عالٍ وشدّد على المقطع القويّ."},"id":"L003"},{"actor":"lina","start":21.396,"text":{"en":"Inspect. in-SPECT. Two syllables, and the SECOND one is loud.","ar":"Inspect. يفحص. مقطعان، والثاني هو القويّ."},"id":"L004"},{"actor":"lina","start":28.346,"text":{"en":"Diagnose. DI-ag-nose. Three syllables, and the first one is loud.","ar":"Diagnose. يشخّص. ثلاثة مقاطع، والأوّل هو القويّ."},"id":"L005"},{"actor":"lina","start":35.824,"text":{"en":"Service. SER-vice. Two syllables, and the first one is loud.","ar":"Service. الصيانة. مقطعان، والأوّل هو القويّ."},"id":"L006"},{"actor":"lina","start":42.918,"text":{"en":"Quality. QUAL-i-ty. Three syllables, and the first one is loud.","ar":"Quality. الجودة. ثلاثة مقاطع، والأوّل هو القويّ."},"id":"L007"},{"actor":"lina","start":50.348,"text":{"en":"Invoice. IN-voice. Two syllables, and the first one is loud.","ar":"Invoice. الفاتورة. مقطعان، والأوّل هو القويّ."},"id":"L008"},{"actor":"lina","start":57.394,"text":{"en":"Handover. HAND-o-ver. Three syllables, and the first one is loud.","ar":"Handover. التسليم. ثلاثة مقاطع، والأوّل هو القويّ."},"id":"L009"},{"actor":"lina","start":64.392,"text":{"en":"Five of the six words stress the first syllable. Inspect is the one that does not.","ar":"خمس من الكلمات الستّ تُشدّد على المقطع الأوّل. وكلمة inspect هي التي تخالف ذلك."},"id":"L010"},{"actor":"tarek","start":70.958,"text":{"en":"Which syllable is loud in inspect?","ar":"أيّ مقطع هو القويّ في كلمة inspect؟"},"subHold":7.976,"id":"L011"},{"actor":"tarek","start":78.934,"text":{"en":"The second one. in-SPECT.","ar":"الثاني. in-SPECT."},"id":"L012"},{"actor":"lina","start":82.812,"text":{"en":"Now one pair that catches everybody. Hand over, as two words, is the action. Handover, as one word, is the thing.","ar":"الآن زوج يُخطئ فيه الجميع. hand over، بكلمتين، هي الفعل. و handover، بكلمة واحدة، هي الشيء."},"id":"L013"},{"actor":"tarek","start":92.858,"text":{"en":"We hand over the car at three o'clock. The handover is at three o'clock. Which one is the verb, and where is the stress in the other?","ar":"we hand over the car at three o'clock. و the handover is at three o'clock. أيّهما الفعل، وأين النبر في الأخرى؟"},"subHold":17.624,"id":"L014"},{"actor":"tarek","start":110.482,"text":{"en":"Hand over, as two words, is the verb. In handover, one word, the stress is on HAND.","ar":"hand over، بكلمتين، هي الفعل. وفي handover، بكلمة واحدة، النبر على HAND."},"id":"L015"},{"actor":"lina","start":118.8,"text":{"en":"Say all six again, and tap the loud syllable with your hand as you say it.","ar":"قل الستّ كلّها مرّة أخرى، واطرق على المقطع القويّ بيدك وأنت تنطقه."},"id":"L016"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"textMode":"wrapShrink","lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"458747d96a3552c5","bytes":47232,"sha":"21aadcfb37589