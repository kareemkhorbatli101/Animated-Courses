id":"L004"},{"actor":"nabil","start":29.162,"text":{"en":"Not touch the hot engine.","ar":"عدم لمس المحرّك الساخن."},"subHold":6.799,"id":"L005"},{"actor":"nabil","start":35.961,"text":{"en":"Don't touch the hot engine.","ar":"لا تلمس المحرّك الساخن."},"id":"L006"},{"actor":"nabil","start":38.615,"text":{"en":"Chock the wheels first.","ar":"وضع صادّات العجلات أوّلاً."},"subHold":6.585,"id":"L007"},{"actor":"nabil","start":45.2,"text":{"en":"Chock the wheels first.","ar":"ضع صادّات العجلات أوّلاً."},"id":"L008"},{"actor":"nabil","start":47.782,"text":{"en":"Not work under a car on a jack alone.","ar":"عدم العمل تحت سيارة على رافعة وحدها."},"subHold":8.44,"id":"L009"},{"actor":"nabil","start":56.222,"text":{"en":"Never work under a car on a jack alone.","ar":"لا تعمل أبداً تحت سيارة على رافعة وحدها."},"id":"L010"},{"actor":"nabil","start":59.908,"text":{"en":"Clean your area at the end.","ar":"تنظيف منطقتك في النهاية."},"subHold":7.156,"id":"L011"},{"actor":"nabil","start":67.064,"text":{"en":"Clean your area at the end.","ar":"نظّف منطقتك في النهاية."},"id":"L012"},{"actor":"tarek","start":69.982,"text":{"en":"Now put the lifting steps in the safe order. The book gives you step one: chock the wheels.","ar":"الآن رتّب خطوات الرفع بالترتيب الآمن. الكتاب يعطيك الخطوة الأولى: ضع صادّات العجلات."},"id":"L013"},{"actor":"tarek","start":77.172,"text":{"en":"After you chock the wheels, what is step two?","ar":"بعد وضع صادّات العجلات، ما الخطوة الثانية؟"},"subHold":9.151,"id":"L014"},{"actor":"tarek","start":86.323,"text":{"en":"Raise the car slowly with the jack.","ar":"ارفع السيارة ببطء بالرافعة."},"id":"L015"},{"actor":"tarek","start":89.793,"text":{"en":"What is step three?","ar":"ما الخطوة الثالثة؟"},"subHold":6.158,"id":"L016"},{"actor":"tarek","start":95.951,"text":{"en":"Put the axle stands under the car.","ar":"ضع حوامل المحور تحت السيارة."},"id":"L017"},{"actor":"tarek","start":99.229,"text":{"en":"And step four, before you start work?","ar":"والخطوة الرابعة، قبل أن تبدأ العمل؟"},"subHold":8.441,"id":"L018"},{"actor":"tarek","start":107.67,"text":{"en":"Check the car is steady before you work.","ar":"تأكّد أنّ السيارة ثابتة قبل أن تعمل."},"id":"L019"},{"actor":"nabil","start":111.116,"text":{"en":"Chock, raise, stands, check. In that order, every time.","ar":"صادّ، ثمّ رفع، ثمّ حوامل، ثمّ تأكّد. بهذا الترتيب، في كلّ مرّة."},"id":"L020"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"4408308ca3bf3994","bytes":41616,"sha":"110b2bef711b581e","address":"lines/4408308ca3bf3994.mp3"},{"key":"bcad88d715ec8e46","bytes":47088,"sha":"c0ebef3938bc86cb","address":"lines/bcad88d715ec8e46.mp3"},{"key":"946457f1c50a45ab","bytes":40464,"sha":"d736692e681130b1","address":"lines/946457f1c50a45ab.mp3"},{"key":"9c3e51c33cf9f0fd","bytes":34704,"sha":"f6df6731e76397bf","address":"lines/9c3e51c33cf9f0fd.mp3"},{"key":"7a66e6564598e059","bytes":13968,"sha":"39cb5851ccffc32b","address":"lines/7a66e6564598e059.mp3"},{"key":"73ad311bde93119c","bytes":13824,"sha":"0541dcffa6eb0144","address":"lines/73ad311bde93119c.mp3"},{"key":"1a0eac8db98f6bb1","bytes":13392,"sha":"3dc3616354e17dfc","address":"lines/1a0eac8db98f6bb1.mp3"},{"key":"1a0eac8db98f6bb1","bytes":13392,"sha":"3dc3616354e17dfc","address":"lines/1a0eac8db98f6bb1.mp3"},{"key":"fd066c6655f9564b","bytes":19584,"sha":"9cfaf9674052ae61","address":"lines/fd066c6655f9564b.mp3"},{"key":"f7fda8af6892ef52","bytes":20016,"sha":"891b4cb8e3bdadec","address":"lines/f7fda8af6892ef52.mp3"},{"key":"758119681a91219b","bytes":15408,"sha":"d6e95b6cef09a225","address":"lines/758119681a91219b.mp3"},{"key":"758119681a91219b","bytes":15408,"sha":"d6e95b6cef09a225","address":"lines/758119681a91219b.mp3"},{"key":"517afa67fe6f285d","bytes":41040,"sha":"bbda48cd65898cfb","address":"lines/517afa67fe6f285d.mp3"},{"key":"b4837b078146c9a3","bytes":21024,"sha":"c713942d37adac43","address":"lines/b4837b07