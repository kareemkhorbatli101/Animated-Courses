6.92,"dur":7.368},{"i":0,"at":14.638,"dur":4.032},{"i":0,"at":19.02,"dur":2.472},{"i":0,"at":26.021,"dur":3.888},{"i":0,"at":30.259,"dur":2.664},{"i":0,"at":37.747,"dur":3.768},{"i":0,"at":41.865,"dur":2.664},{"i":0,"at":49.353,"dur":4.128},{"i":0,"at":53.831,"dur":2.64},{"i":0,"at":61.353,"dur":3.336},{"i":0,"at":65.039,"dur":5.52},{"i":0,"at":70.909,"dur":11.04},{"i":1,"at":82.299,"dur":6.24},{"i":1,"at":88.889,"dur":6.0},{"i":0,"at":95.239,"dur":2.928},{"i":1,"at":98.517,"dur":3.336},{"i":1,"at":107.449,"dur":4.056},{"i":1,"at":116.045,"dur":2.76},{"i":0,"at":119.155,"dur":7.584},{"i":0,"at":127.089,"dur":5.808},{"i":0,"at":133.247,"dur":4.056},{"i":0,"at":137.653,"dur":3.72}],"speech":[{"actor":"maher","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1. This is Unit 2, Under the Bonnet.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الثانية، تحت غطاء المحرّك."},"id":"L001"},{"actor":"maher","start":6.92,"text":{"en":"This is Part 7, Completing the Order. You will choose much, many, some or any, then role-play.","ar":"هذا الجزء السابع، إكمال الطلب. ستختار much أو many أو some أو any، ثمّ تلعب الدور."},"id":"L002"},{"actor":"maher","start":14.638,"text":{"en":"Complete the order with much, many, some, or any.","ar":"أكمل الطلب بـ much أو many أو some أو any."},"id":"L003"},{"actor":"maher","start":19.02,"text":{"en":"There isn't blank coolant.","ar":"ليس هناك فراغ سائل تبريد."},"subHold":7.001,"id":"L004"},{"actor":"maher","start":26.021,"text":{"en":"Much. Coolant is uncountable.","ar":"Much. سائل التبريد غير معدود."},"id":"L005"},{"actor":"maher","start":30.259,"text":{"en":"There aren't blank oil filters.","ar":"ليس هناك فراغ فلاتر زيت."},"subHold":7.488,"id":"L006"},{"actor":"maher","start":37.747,"text":{"en":"Many. Filters are countable.","ar":"Many. الفلاتر معدودة."},"id":"L007"},{"actor":"maher","start":41.865,"text":{"en":"Please order blank air filters.","ar":"اطلب فراغ فلاتر هواء."},"subHold":7.488,"id":"L008"},{"actor":"maher","start":49.353,"text":{"en":"Some. It is a positive instruction.","ar":"Some. إنّه تعليم مثبت."},"id":"L009"},{"actor":"maher","start":53.831,"text":{"en":"Is there blank brake fluid left?","ar":"هل بقي فراغ زيت فرامل؟"},"subHold":7.522,"id":"L010"},{"actor":"maher","start":61.353,"text":{"en":"Any. It is a question.","ar":"Any. إنّه سؤال."},"id":"L011"},{"actor":"maher","start":65.039,"text":{"en":"Now the role play. One is the manager; one is the mechanic.","ar":"الآن لعب الأدوار. أحدكما المدير؛ والآخر الميكانيكي."},"id":"L012"},{"actor":"maher","start":70.909,"text":{"en":"The model: How much oil do we have? There is plenty. How many filters are there? Only two. Please order ten more.","ar":"النموذج: كم زيتاً لدينا؟ هناك وفير. كم فلتراً هناك؟ اثنان فقط. اطلب عشرة أخرى."},"id":"L013"},{"actor":"nabil","start":82.299,"text":{"en":"Card A, the manager: ask how much and how many of three items, then decide what to order.","ar":"البطاقة أ، المدير: اسأل كم من ثلاثة أصناف، ثمّ قرّر ما تطلبه."},"id":"L014"},{"actor":"nabil","start":88.889,"text":{"en":"Card B, the mechanic: report the amounts using some, any, much, and many.","ar":"البطاقة ب، الميكانيكي: أبلغ الكمّيات مستخدماً some و any و much و many."},"id":"L015"},{"actor":"maher","start":95.239,"text":{"en":"Listen to the two of them do it first.","ar":"استمع إليهما يفعلانها أوّلاً."},"id":"L016"},{"actor":"nabil","start":98.517,"text":{"en":"Tarek, how much engine oil do we have?","ar":"طارق، كم زيت محرّك لدينا؟"},"id":"L017"},{"actor":"","start":102.203,"text":{"en":"There is plenty, Ustaz. Four full bottles.","ar":"هناك وفير يا أستاذ. أربع عبوات ممتلئة."},"speaker":"Tarek","id":"L018"},{"actor":"nabil","start":107.449,"text":{"en":"Good. And how many air filters are there?","ar":"جيّد. وكم فلتر هواء هناك؟"},"id":"L019"},{"actor":"","start":111.855,"text":{"en":"Only two. There aren't many left.","ar":"اثنان فقط. لم يبقَ كثير."},"speaker":"Tarek","id":"L020"},{"actor":"nabil","start":116.045,"text":{"en":"Then please order ten more today.","ar":"إذاً اطلب عشرة أخرى اليوم."},"id":"L021"},{"actor":"maher","start":119.155,"text":{"en":"A harder one: money is tight this month. Decide which parts to order now and which can wait, and explain why.","ar":"واحدة أصعب: المال قليل هذا الشهر. قرّر أيّ القطع تطلبها الآن وأيّها يمكن أن تنتظر، واشرح لماذا."},"id":"L022"},{"actor":"maher","start":127.089,"text":{"en":"Last, you are the manager. Write a short order note to the supplier.","ar":"وأخيراً، أنت المدير. اكتب مذكّرة طلب قصيرة للمورّد."},"id":"L023"},{"actor":"maher","start":133.247,"text":{"en":"Give three items, how many of each, and the day you need them.","ar":"اذكر ثلاثة أصناف، وكم من كلّ واحد، واليوم الذي تحتاجها فيه."},"id":"L024"},{"actor":"maher","start":137.653,"text":{"en":"Pause the video, and write forty to sixty words.","ar":"أوقف الفيديو، واكتب من أربعين إلى ستّين كلمة."},"id":"L025"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"3d0412ca488b6fd5","bytes":36720,"sha":"28facc4f8be8ae5d","address":"lines/3d0412ca488b6fd5.mp3"},{"key":"a12fecd506e7553d","bytes":44208,"sha":"b965901e0edb379b","address":"lines/a12fecd506e7553d.mp3"},{"key":"9a4d3a5ee07bf909","bytes":24192,"sha":"ef07a286112465af","address":"lines/9a4d3a5ee07bf909.mp3"},{"key":"e9bf0849fce00e95","bytes":14832,"sha":"9f8e957b84f2dd70","address":"lines/e9bf0849fce00e95.mp3"},{"key":"55c18e8664b16ed7","bytes":23328,"sha":"55744079aa021482","address":"lines/55c18e8664b16ed7.mp3"},{"key":"3b7dd002ad123370","bytes":15984,"sha":"1b2dd5fadef78d8e","address":"lines/3b7dd002ad123370.mp3"},{"key":"c8d1fa92214afd52","bytes":22608,"sha":"72fce35fdbb7c3ec","address":"lines/c8d1fa92214afd52.mp3"},{"key":"da98e241e2ec5cbb","bytes":15984,"sha":"6ba16e6a6c860484","address":"lines/da98e241e2ec5cbb.mp3"},{"key":"9eeb7a9598f9646e","bytes":24768,"sha":"4f841326c26d607e","address":"lines/9eeb7a9598f9646