},"id":"L015"},{"actor":"tarek","start":88.355,"text":{"en":"There aren't blank clean filters.","ar":"ليس هناك فراغ فلاتر نظيفة."},"subHold":7.821,"id":"L016"},{"actor":"tarek","start":96.176,"text":{"en":"Many. Filters are countable.","ar":"Many. الفلاتر معدودة."},"id":"L017"},{"actor":"tarek","start":100.15,"text":{"en":"There isn't blank coolant left.","ar":"لم يتبقَّ فراغ سائل تبريد."},"subHold":7.56,"id":"L018"},{"actor":"tarek","start":107.71,"text":{"en":"Much. Coolant is uncountable.","ar":"Much. سائل التبريد غير معدود."},"id":"L019"},{"actor":"tarek","start":111.876,"text":{"en":"We have blank new spark plugs.","ar":"لدينا فراغ شمعات إشعال جديدة."},"subHold":7.692,"id":"L020"},{"actor":"tarek","start":119.568,"text":{"en":"Some. It is a positive sentence.","ar":"Some. إنّها جملة مثبتة."},"id":"L021"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"8de7bf4a5083966f","bytes":35424,"sha":"c703d4edde5446a8","address":"lines/8de7bf4a5083966f.mp3"},{"key":"58deec2c697104be","bytes":42336,"sha":"877b7958478e3981","address":"lines/58deec2c697104be.mp3"},{"key":"cde0ee0797f860d5","bytes":36144,"sha":"b18d5f7465d9b99c","address":"lines/cde0ee0797f860d5.mp3"},{"key":"36ef1e4033aa2818","bytes":33120,"sha":"a7147ca6f3f78fe9","address":"lines/36ef1e4033aa2818.mp3"},{"key":"e830434cfcb2890e","bytes":17856,"sha":"05303cdfa9eeaeef","address":"lines/e830434cfcb2890e.mp3"},{"key":"5a2665c3d2847561","bytes":27936,"sha":"7d05e3b60bb34f2b","address":"lines/5a2665c3d2847561.mp3"},{"key":"9e7d6500cab56035","bytes":13536,"sha":"2c647a42e178ef83","address":"lines/9e7d6500cab56035.mp3"},{"key":"fbe7cdc65fce9a51","bytes":23472,"sha":"a3fdb63826060820","address":"lines/fbe7cdc65fce9a51.mp3"},{"key":"0cec47ce30cd6278","bytes":15840,"sha":"df9517cf95fb82d5","address":"lines/0cec47ce30cd6278.mp3"},{"key":"78a9c479adc81165","bytes":14256,"sha":"d9db7069ff4d5b81","ad