":"هذا الجزء السابع، ملفّ الإدارة. إنّه اختياري."},"id":"L003"},{"actor":"maher","start":13.452,"text":{"en":"A manager welcomes a new apprentice.","ar":"مدير يرحّب بمتدرّب جديد."},"id":"L004"},{"actor":"maher","start":16.802,"text":{"en":"First, four things a manager says.","ar":"أوّلاً، أربعة أشياء يقولها المدير."},"id":"L005"},{"actor":"maher","start":20.248,"text":{"en":"Welcome to the team. What is it for?","ar":"أهلاً بك في الفريق. ما الغرض منها؟"},"subHold":9.222,"id":"L006"},{"actor":"maher","start":29.47,"text":{"en":"Greeting a new worker.","ar":"الترحيب بعامل جديد."},"id":"L007"},{"actor":"maher","start":32.076,"text":{"en":"Let me show you the workshop. What is it for?","ar":"دعني أريك الورشة. ما الغرض منها؟"},"subHold":10.135,"id":"L008"},{"actor":"maher","start":42.211,"text":{"en":"Showing someone around.","ar":"أخذ شخص في جولة."},"id":"L009"},{"actor":"maher","start":44.937,"text":{"en":"Always wear your safety glasses. What is it for?","ar":"ارتدِ نظّارات الأمان دائماً. ما الغرض منها؟"},"subHold":10.527,"id":"L010"},{"actor":"maher","start":55.464,"text":{"en":"Giving a safety rule.","ar":"إعطاء قاعدة أمان."},"id":"L011"},{"actor":"maher","start":58.094,"text":{"en":"Ask me if you are not sure. What is it for?","ar":"اسألني إذا لم تكن متأكّداً. ما الغرض منها؟"},"subHold":10.018,"id":"L012"},{"actor":"maher","start":68.112,"text":{"en":"Offering help and support.","ar":"عرض المساعدة والدعم."},"id":"L013"},{"actor":"maher","start":70.982,"text":{"en":"Before you listen. What does a manager say on the first day?","ar":"قبل أن تستمع. ماذا يقول المدير في اليوم الأوّل؟"},"subHold":11.569,"id":"L014"},{"actor":"maher","start":82.551,"text":{"en":"He welcomes the new worker and gives the safety rules.","ar":"يرحّب بالعامل الجديد ويعطي قواعد الأمان."},"id":"L015"},{"actor":"maher","start":86.597,"text":{"en":"Good morning, Tarek. Welcome to Cham Motors.","ar":"صباح الخير يا طارق. أهلاً بك في شام موتورز."},"id":"L016"},{"actor":"","start":91.579,"text":{"en":"Nice to meet you. Have you worked in a garage before?","ar":"تشرّفنا. هل عملت في كراج من قبل؟"},"speaker":"Nabil","id":"L017"},{"actor":"tarek","start":96.561,"text":{"en":"A little. I helped my uncle.","ar":"قليلاً. ساعدت عمّي."},"id":"L018"},{"actor":"maher","start":100.439,"text":{"en":"Good. This week, you watch Nabil and learn.","ar":"جيّد. هذا الأسبوع، تشاهد نبيل وتتعلّم."},"id":"L019"},{"actor":"","start":105.277,"text":{"en":"Always wear your safety glasses and gloves in the workshop,","ar":"ارتدِ دائماً نظّارات الأمان والقفّازات في الورشة،"},"speaker":"Nabil","id":"L020"},{"actor":"","start":109.515,"text":{"en":"and keep your area clean.","ar":"وحافظ على مكانك نظيفاً."},"speaker":"Nabil","id":"L021"},{"actor":"tarek","start":112.433,"text":{"en":"Yes, Ustaz.","ar":"نعم يا أستاذ."},"id":"L022"},{"actor":"maher","start":115.159,"text":{"en":"If you are not sure, ask us. We work as a team here.","ar":"إذا لم تكن متأكّداً، اسألنا. نعمل هنا كفريق."},"id":"L023"},{"actor":"tarek","start":120.525,"text":{"en":"Thank you. I am happy to be here.","ar":"شكراً. أنا سعيد بوجودي هنا."},"id":"L024"},{"actor":"maher","start":124.691,"text":{"en":"Now answer three questions.","ar":"الآن أجب عن ثلاثة أسئلة."},"id":"L025"},{"actor":"maher","start":127.585,"text":{"en":"What is Tarek doing this week?","ar":"ماذا يفعل طارق هذا الأسبوع؟"},"subHold":7.381,"id":"L026"},{"actor":"maher","start":134.966,"text":{"en":"He is watching Nabil and learning.","ar":"إنّه يشاهد نبيل ويتعلّم."},"id":"L027"},{"actor":"maher","start":138.148,"text":{"en":"What safety rule does Nabil give?","ar":"ما قاعدة الأمان التي يعطيها نبيل؟"},"subHold":7.773,"id":"L028"},{"actor":"maher","start":145.921,"text":{"en":"Always wear safety glasses and gloves, and keep the area clean.","ar":"ارتدِ دائماً نظّارات الأمان والقفّازات، وحافظ على المكان نظيفاً."},"id":"L029"},{"actor":"maher","start":150.615,"text":{"en":"What should Tarek do if he is not sure?","ar":"ماذا يجب أن يفعل طارق إذا لم يكن متأكّداً؟"},"subHold":8.318,"id":"L030"},{"actor":"maher","start":158.933,"text":{"en":"Ask the team.","ar":"أن يسأل الفريق."},"id":"L031"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d151f5932f8958b3","bytes":19296,"sha":"dfbb827359f21582","address":"lines/d151f5932f8958b3.mp3"},{"key":"f1c2ccfa9de7d37e","bytes":21744,"sha":"efc2fd8f1a9a102d","address":"lines/f1c2ccfa9de7d37e.mp3"},{"key":"ff13deb2e272d552","bytes":30672,"sha":"8c313926c0ec2e74","address":"lines/ff13deb2e272d552.mp3"},{"key":"f8ce7e6dc03354c9","bytes":18000,"sha":"f2b99d23718af59c","address":"lines/f8ce7e6dc03354c9.mp3"},{"key":"5deee41992803559","bytes":18576,"sha":"01181da968fe937c","address":"lines/5deee41992803559.mp3"},{"key":"1218f2b7baab001d","bytes":24624,"sha":"6893b0e5e64af9b7","address":"lines/1218f2b7baab001d.mp3"},{"key":"89baf7c0d357f49f","bytes":13536,"sha":"af67a292f26eead1","address":"lines/89baf7c0d357f49f.mp3"},{"key":"eefcfa39b0c2e9da","bytes":26928,"sha":"6d2be68ae4a16592","address":"lines/eefcfa39b0c2e9da.mp3"},{"key":"8d2bf7a46e9b07cc","bytes":14256,"sha":"873bc7975a1d2ec4","address":"lines/8d2bf7a46e9b07cc.mp3"},{"key":"8a8af3a92bdc1036","bytes":28224,"sha":"c0a4af33e856a587","address":"lines/8a8af3a92bdc1036.mp3"},{"key":"55839ee7501f5841","bytes":13680,"sha":"95f899a06bcf77d5","address":"lines/55839ee7501f5841.mp3"},{"key":"838e83cc04d27697","bytes":26928,"sha":"839419c201992420","address":"lines/838e83cc04d27697.mp3"},{"key":"d723f8e773c7cbc1","bytes":15120,"sha":"54bdef0222fa957b","address":"lines/d723f8e773c7cbc1.mp3"},{"key":"35d3e7c843110fef","bytes":30240,"sha":"4a64cc0e248eda36","address":"lines/35d3e7c843110fef.mp3"},{"key":"9d85a9d4db26af8c","bytes":22176,"sha":"56759e69d7b1abfa","address":"lines/9d85a9d4db26af8c.mp3"},{"key":"869228648f58b442","bytes":27792,"sha":"475e6c036d8f484c","address":"lines/869228648f58b442.mp3"},{"key":"843eda6ce8bc1ed4","