dur":5.328},{"i":1,"at":57.568,"dur":5.4},{"i":1,"at":69.615,"dur":5.928},{"i":0,"at":76.843,"dur":5.328}],"speech":[{"actor":"maher","start":0.45,"text":{"en":"Now let us check. Answer in the quiet, then I will tell you.","ar":"الآن لنتحقّق. أجب في الصمت، ثمّ سأخبرك."},"id":"L001"},{"actor":"maher","start":6.958,"text":{"en":"What does the battery do?","ar":"ماذا تفعل البطارية؟"},"id":"L002"},{"actor":"maher","start":13.709,"text":{"en":"It stores electricity to start the car.","ar":"تخزّن الكهرباء لتشغيل السيارة."},"id":"L003"},{"actor":"maher","start":18.417,"text":{"en":"Where does a mechanic work?","ar":"أين يعمل الميكانيكي؟"},"id":"L004"},{"actor":"maher","start":25.357,"text":{"en":"In the workshop.","ar":"في الورشة."},"id":"L005"},{"actor":"maher","start":28.649,"text":{"en":"What is a job card?","ar":"ما هي بطاقة العمل؟"},"id":"L006"},{"actor":"maher","start":34.903,"text":{"en":"A paper that lists the work to do.","ar":"ورقة تذكر العمل المطلوب."},"id":"L007"},{"actor":"tarek","start":39.083,"text":{"en":"Fill the gap. The blank stores electricity to start the car.","ar":"املأ الفراغ. الـــ تخزّن الكهرباء لتشغيل السيارة."},"id":"L008"},{"actor":"tarek","start":50.94,"text":{"en":"The battery. The battery stores electricity to start the car.","ar":"البطارية. البطارية تخزّن الكهرباء."},"id":"L009"},{"actor":"tarek","start":57.568,"text":{"en":"And this one. The service advisor writes a blank for each car.","ar":"وهذا. مستشار الخدمة يكتب الـــ لكلّ سيارة."},"id":"L010"},{"actor":"tarek","start":69.615,"text":{"en":"A job card. The service advisor writes a job card for each car.","ar":"بطاقة عمل. مستشار الخدمة يكتب بطاقة عمل لكلّ سيارة."},"id":"L011"},{"actor":"maher","start":76.843,"text":{"en":"Good work. Say each word once more before you go into the bay.","ar":"عمل جيّد. قل كلّ كلمة مرّة أخرى قبل أن تدخل الورشة."},"id":"L012"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audi