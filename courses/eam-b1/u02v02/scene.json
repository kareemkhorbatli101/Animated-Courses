xt":{"en":"What does the battery do?","ar":"ماذا تفعل البطارية؟"},"subHold":6.775,"id":"L005"},{"actor":"nabil","start":32.625,"text":{"en":"It stores electricity to start the car.","ar":"تخزّن الكهرباء لتشغيل السيارة."},"id":"L006"},{"actor":"nabil","start":36.167,"text":{"en":"What does the radiator do?","ar":"ماذا يفعل الراديتير؟"},"subHold":6.977,"id":"L007"},{"actor":"nabil","start":43.144,"text":{"en":"It holds coolant and lets heat escape.","ar":"يحمل سائل التبريد ويسمح للحرارة بالخروج."},"id":"L008"},{"actor":"nabil","start":46.47,"text":{"en":"What does the alternator do?","ar":"ماذا يفعل الدينامو؟"},"subHold":7.095,"id":"L009"},{"actor":"nabil","start":53.565,"text":{"en":"It makes electricity while the engine runs.","ar":"يولّد الكهرباء أثناء دوران المحرّك."},"id":"L010"},{"actor":"nabil","start":57.299,"text":{"en":"What is a belt?","ar":"ما هو السير؟"},"subHold":5.872,"id":"L011"},{"actor":"nabil","start":63.171,"text":{"en":"A rubber loop that turns parts in the engine.","ar":"حلقة مطّاطية تُدوّر أجزاء في المحرّك."},"id":"L012"},{"actor":"nabil","start":66.761,"text":{"en":"What is a hose?","ar":"ما هو الخرطوم؟"},"subHold":6.016,"id":"L013"},{"actor":"nabil","start":72.777,"text":{"en":"A rubber pipe that carries a fluid.","ar":"أنبوب مطّاطي ينقل سائلاً."},"id":"L014"},{"actor":"nabil","start":75.959,"text":{"en":"What do you use a dipstick for?","ar":"لماذا تستخدم مقياس الزيت؟"},"subHold":7.296,"id":"L015"},{"actor":"nabil","start":83.255,"text":{"en":"You use it to check the oil level.","ar":"تستخدمه لفحص مستوى الزيت."},"id":"L016"},{"actor":"nabil","start":86.269,"text":{"en":"What does the air filter do?","ar":"ماذا يفعل فلتر الهواء؟"},"subHold":7.071,"id":"L017"},{"actor":"nabil","start":93.34,"text":{"en":"It cleans the air going into the engine.","ar":"ينظّف الهواء الداخل إلى المحرّك."},"id":"L018"},{"actor":"tarek","start":96.762,"text":{"en":"One meaning was not needed: a tool for turning nuts and bolts. That is a spanner.","ar":"معنى واحد لم يكن مطلوباً: أداة لفكّ الصواميل والبراغي. ذلك مفتاح الربط."},"id":"L019"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"083824c8d6aad25b","bytes":38016,"sha":"74f8de2430dfa199","address":"lines/083824c8d6aad25b.mp3"},{"key":"f1ed239afe1351f4","bytes":40320,"sha":"9bc216831d559275","address":"lines/f1ed239afe1351f4.mp3"},{"key":"8b8601137ba1437b","bytes":30672,"sha":"fe33244232faba3a","address":"lines/8b8601137ba1437b.mp3"},{"key":"21d548f3b36d3aa4","bytes":34992,"sha":"e942194e0af3e50b","address":"lines/21d548f3b36d3aa4.mp3"},{"key":"922fa3d46d3fc3e0","bytes":13824,"sha":"49f6ac43d41a8b0c","address":"lines/922fa3d46d3fc3e0.mp3"},{"key":"8349aaa33fce33ea","bytes":19152,"sha":"32fddf766f86c13f","address":"lines/8349aaa33fce33ea.mp3"},{"key":"9404c3b88040d391","bytes":14688,"sha":"872e2816d60988e8","address":"lines/9404c3b88040d391.mp3"},{"key":"b907873c46de426b","bytes":17856,"sha":"572bd07b11daa945","address":"lines/b907873c46de426b.mp3"},{"key":"726f159dbb96a50b","bytes":14688,"sha":"f9b1eca6b7083632","address":"lines/726f159dbb96a50b.mp3"},{"key":"d258f4bc2c92e986","bytes":20304,"sha":"b4da1da2a8af4522","address":"lines/d258f4bc2c92e986.mp3"},{"key":"b4bf537b6babdcfd","bytes":11232,"sha":"d9e42ee0aed52767","address":"lines/b4bf537b6babdcfd.mp3"},{"key":"4878938b4e780af3","bytes":19440,"sha":"9781203bc57204ae","address":"lines/4878938b4e780af3.mp3"},{"key":"cee2526f857343d5","bytes":12096,"sha":"3848623158e3125f","address":"lines/cee2526f857343d5.mp3"},{"key":"10bc1c0e39f6497b","bytes":16992,"sha":"160113075fda5abf","address":"lines/10bc1c0e39f6497b.mp3"},{"key":"2638dfa0ddc3c29e","bytes":14832,"sha":"83cb60a1a60478a4","address":"lines/2638dfa0ddc3c29e.mp3"},{"key":"ad36bb179ae497c1","bytes":15984,"sha":"c08e8985c5e47515","address":"lines/ad36bb179ae497c1.mp3"},{"key":"710780abe39c5509","bytes":14544,"sha":"5dffc3c49dbf0dbe","address":"line