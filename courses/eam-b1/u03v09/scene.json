,"dur":2.256},{"i":0,"at":54.604,"dur":3.216},{"i":0,"at":58.17,"dur":2.544},{"i":0,"at":65.185,"dur":2.184},{"i":0,"at":67.719,"dur":3.096},{"i":0,"at":76.109,"dur":2.064},{"i":1,"at":78.523,"dur":8.16}],"speech":[{"actor":"tarek","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1. This is Unit 3, Tools and Safe Working.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الثالثة، العُدّة والعمل الآمن."},"id":"L001"},{"actor":"tarek","start":7.904,"text":{"en":"This is Part 3, Where Are the Tools? You will listen to a trainee find the tools, then answer questions.","ar":"هذا الجزء الثالث، أين العُدّة؟ ستستمع إلى متدرّب يجد العُدّة، ثمّ تجيب عن أسئلة."},"id":"L002"},{"actor":"tarek","start":16.054,"text":{"en":"Before you listen: where does a workshop keep its tools?","ar":"قبل أن تستمع: أين تحفظ الورشة عُدّتها؟"},"id":"L003"},{"actor":"tarek","start":20.556,"text":{"en":"Ustaz, where is the torque wrench?","ar":"أستاذ، أين مفتاح العزم؟"},"id":"L004"},{"actor":"nabil","start":24.002,"text":{"en":"It's on the wall, next to the socket set.","ar":"إنّه على الحائط، بجانب طقم المفاتيح."},"id":"L005"},{"actor":"tarek","start":27.52,"text":{"en":"And the trolley jack?","ar":"والرافعة المتحرّكة؟"},"id":"L006"},{"actor":"nabil","start":30.054,"text":{"en":"It's in the corner. But first, put on your gloves.","ar":"إنّها في الزاوية. لكن أوّلاً، ارتدِ قفّازيك."},"id":"L007"},{"actor":"tarek","start":35.252,"text":{"en":"Yes. And the axle stands?","ar":"نعم. وحوامل المحور؟"},"id":"L008"},{"actor":"nabil","start":39.346,"text":{"en":"Under the bench. Always use two. Remember: chock the wheels first, then raise the car.","ar":"تحت الطاولة. استخدم اثنين دائماً. تذكّر: ضع صادّات العجلات أوّلاً، ثمّ ارفع السيارة."},"id":"L009"},{"actor":"tarek","start":47.76,"text":{"en":"Where is the torque wrench?","ar":"أين مفتاح العزم؟"},"subHold":6.844,"id":"L010"},{"actor":"tarek","start":54.604,"text":{"en":"On the wall, next to the socket set.","ar":"على الحائط، بجانب طقم المفاتيح."},"id":"L011"},{"actor":"tarek","start":58.17,"text":{"en":"What must Tarek do first?","ar":"ماذا يجب أن يفعل طارق أوّلاً؟"},"subHold":7.015,"id":"L012"},{"actor":"tarek","start":65.185,"text":{"en":"Put on his gloves.","ar":"أن يرتدي قفّازيه."},"id":"L013"},{"actor":"tarek","start":67.719,"text":{"en":"What must he do before raising the car?","ar":"ماذا يجب أن يفعل قبل رفع السيارة؟"},"subHold":8.39,"id":"L014"},{"actor":"tarek","start":76.109,"text":{"en":"Chock the wheels.","ar":"أن يضع صادّات العجلات."},"id":"L015"},{"actor":"nabil","start":78.523,"text":{"en":"Useful phrases: Where is? It's next to, in the corner, under. First, then.","ar":"عبارات مفيدة: أين؟ إنّه بجانب، في الزاوية، تحت. أوّلاً، ثمّ."},"id":"L016"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"73fef84227e46faf","bytes":42624,"sha":"b06d16a4676ec523","address":"lines/73fef84227e46faf.mp3"},{"key":"7f347bb8bc124b4e","bytes":46800,"sha":"64de764f54b81f80","address":"lines/7f347bb8bc124b4e.mp3"},{"key":"afac3ffa25aa9a78","bytes":24912,"sha":"8ac6f3e0f3deb915","address":"lines/afac3ffa25aa9a78.mp3"},{"key":"8a66549f4cefa02a","bytes":18576,"sha":"0763a29fe5b0ee8b","address":"lines/8a66549f4cefa02a.mp3"},{"key":"34ae317ae82bbde6","bytes":19008,"sha":"78e17fc44a296870","address":"lines/34ae317ae82bbde6.mp3"},{"key":"8133932a22e95be1","bytes":13104,"sha":"bcebfb8a8adbac2b","address":"lines/8133932a22e95be1.mp3"},{"key":"a48f806df4db94a5","bytes":29088,"sha":"f701c7e09a46ebc4","address":"lines/a48f806df4db94a5.mp3"},{"key":"d237f182dd290a98","bytes":22464,"sha":"8d7d2585675946c1","address":"lines/d237f182dd290a98.mp3"},{"key":"7fb30602bb8634b1","bytes":48384,"sha":"a2265acbc7519797","address":"lines/7fb30602bb8634b1.mp3"},{"key":"56f5fc109854a95c","bytes":13536,"sha":"797de9a5aa354b3b","address":"lines/56f5fc109854a95c.mp3"},{"key":"e546af430f1ab147","bytes":19296,"sh