"dur":4.44},{"i":0,"at":62.162,"dur":4.68},{"i":1,"at":73.518,"dur":2.424},{"i":1,"at":81.01,"dur":3.648},{"i":0,"at":87.974,"dur":2.328},{"i":0,"at":90.652,"dur":6.264},{"i":0,"at":104.387,"dur":5.88},{"i":0,"at":110.617,"dur":5.304},{"i":0,"at":116.271,"dur":3.84},{"i":0,"at":120.461,"dur":3.624}],"speech":[{"actor":"maher","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل."},"id":"L001"},{"actor":"maher","start":4.016,"text":{"en":"This is Unit 1, Introduction to the Vehicle.","ar":"هذه الوحدة الأولى، مقدّمة إلى المركبة."},"id":"L002"},{"actor":"maher","start":7.99,"text":{"en":"This is Part 7, the Management File. It is optional.","ar":"هذا الجزء السابع، ملفّ الإدارة. إنّه اختياري."},"id":"L003"},{"actor":"maher","start":13.452,"text":{"en":"Put the steps in order, then listen to a briefing.","ar":"رتّب الخطوات، ثمّ استمع إلى إحاطة."},"id":"L004"},{"actor":"maher","start":17.354,"text":{"en":"A manager's first day with a new worker has five steps.","ar":"لليوم الأوّل للمدير مع عامل جديد خمس خطوات."},"id":"L005"},{"actor":"maher","start":21.664,"text":{"en":"Here is an example. Saying welcome is step one.","ar":"هذا مثال. الترحيب هو الخطوة الأولى."},"id":"L006"},{"actor":"maher","start":26.766,"text":{"en":"Put the other four steps in order.","ar":"رتّب الخطوات الأربع الأخرى."},"subHold":7.784,"id":"L007"},{"actor":"maher","start":34.55,"text":{"en":"Introduce the team, show the workshop, give the safety rules, then a small task.","ar":"عرّفه على الفريق، أرِه الورشة، أعطِه قواعد الأمان، ثمّ مهمّة صغيرة."},"id":"L008"},{"actor":"maher","start":40.276,"text":{"en":"Number one. Say welcome.","ar":"رقم واحد. رحّب."},"id":"L009"},{"actor":"maher","start":44.274,"text":{"en":"Number two. Introduce the team.","ar":"رقم اثنان. عرّفه على الفريق."},"id":"L010"},{"actor":"maher","start":48.68,"text":{"en":"Number three. Show the workshop.","ar":"رقم ثلاثة. أرِه الورشة."},"id":"L011"},{"actor":"maher","start":52.894,"text":{"en":"Number four. Give the safety rules.","ar":"رقم أربعة. أعطِه قواعد الأمان."},"id":"L012"},{"actor":"maher","start":57.372,"text":{"en":"Number five. Give the first small task.","ar":"رقم خمسة. أعطِه المهمّة الصغيرة الأولى."},"id":"L013"},{"actor":"maher","start":62.162,"text":{"en":"Now a briefing: Nabil is the foreman, and Tarek is the apprentice.","ar":"الآن إحاطة: نبيل رئيس العمّال، وطارق المتدرّب."},"id":"L014"},{"actor":"","start":67.192,"text":{"en":"Welcome, Tarek. First, always wear your safety glasses.","ar":"أهلاً يا طارق. أوّلاً، ارتدِ نظّارات الأمان دائماً."},"speaker":"Nabil","id":"L015"},{"actor":"tarek","start":73.518,"text":{"en":"OK, Ustaz.","ar":"حسناً يا أستاذ."},"id":"L016"},{"actor":"","start":76.292,"text":{"en":"Keep your area clean, and ask me before you use a machine.","ar":"حافظ على مكانك نظيفاً، واسألني قبل أن تستخدم آلة."},"speaker":"Nabil","id":"L017"},{"actor":"tarek","start":81.01,"text":{"en":"Yes. What do I do first?","ar":"نعم. ماذا أفعل أوّلاً؟"},"id":"L018"},{"actor":"","start":85.008,"text":{"en":"Today, watch me and learn.","ar":"اليوم، شاهدني وتعلّم."},"speaker":"Nabil","id":"L019"},{"actor":"maher","start":87.974,"text":{"en":"Now, a harder one.","ar":"الآن، واحدة أصعب."},"id":"L020"},{"actor":"maher","start":90.652,"text":{"en":"The apprentice wants to work under a car alone on day one. Say no, politely.","ar":"المتدرّب يريد العمل تحت سيارة وحده في اليوم الأوّل. قل لا بلطف."},"subHold":13.735,"id":"L021"},{"actor":"maher","start":104.387,"text":{"en":"You can say: Not today, Tarek. It is not safe alone on day one.","ar":"يمكنك أن تقول: ليس اليوم يا طارق. ليس آمناً وحدك في اليوم الأوّل."},"id":"L022"},{"actor":"maher","start":110.617,"text":{"en":"Last, you are Maher. Write a short welcome note to Tarek.","ar":"أخيراً، أنت ماهر. اكتب رسالة ترحيب قصيرة إلى طارق."},"id":"L023"},{"actor":"maher","start":116.271,"text":{"en":"Give his plan for the first week, and one safety rule.","ar":"اكتب خطّته للأسبوع الأوّل، وقاعدة أمان واحدة."},"id":"L024"},{"actor":"maher","start":120.461,"text":{"en":"Pause the video, and write fifty to eighty words.","ar":"أوقف الفيديو، واكتب من خمسين إلى ثمانين كلمة."},"id":"L025"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"d151f5932f8958b3","bytes":19296,"sha":"dfbb827359f21582","address":"lines/d151f5932f8958b3.mp3"},{"key":"f1c2ccfa9de7d37e","bytes":21744,"sha":"efc2fd8f1a9a102d","address":"lines/f1c2ccfa9de7d37e.mp3"},{"key":"ff13deb2e272d552","bytes":30672,"sha":"8c313926c0ec2e74","address":"lines/ff13deb2e272d552.mp3"},{"key":"f512a7e8e81552ae","bytes":21312,"sha":"0c140b2173f32d7c","address":"lines/f512a7e8e81552ae.mp3"},{"key":"9a5b092bf639ecec","bytes":23760,"sha":"b7af5481d68dbc13","address":"lines/9a5b092bf639ecec.mp3"},{"key":"cc7127b0bf4d7ea6","bytes":28512,"sha":"05b45005e07ac6b8","address":"lines/cc7127b0bf4d7ea6.mp3"},{"key":"9eb6c86c265d6cc7","bytes":16704,"sha":"5d329639329009a7","address":"lines/9eb6c86c265d6cc7.mp3"},{"key":"cd6ce1a0ac1839ef","bytes":32256,"sha":"e3e9f30b5c69c262","address":"lines/cd6ce1a0ac1839ef.mp3"},{"key":"1b27411f66439d48","bytes":21888,"sha":"5d06aaa7aaa8c2c4","address":"lines/1b27411f66439d48.mp3"},{"key":"b752546eb0d02a39","bytes":24336,"sha":"35b5feaaf138b15b","address":"lines/b752546eb0d02a39.mp3"},{"key":"3e6c709da466b779","bytes":23184,"sha":"85e9f264ec7504f7","address":"lines/3e6c709da466b779.mp3"},{"key":"f44ca9c520974cf8","bytes":24768,"sha":"0b8a2b9a587278e6","address":"lines/f44ca9c520974cf8.mp3"},{"key":"3dab1b182a525cc9","bytes":26640,"sha":"c5900de2fbb65862","address":"lines/3dab1b182a525cc9.mp3"},{"key":"c5cf45f858c94b82","bytes":28080,"sha":"eb3d7cbc5a8a8c9f","address":"lines/c5cf45f858c94b82.mp3"},{"key":"e4d910db3510c970","bytes":35856,"sha":"bb7e8835e2c08cfc","address":"lines/e4d910db3510c970.mp3"},{"key":"ab5ea05f295d4b99","bytes":14544,"sha":"c7ee9129d2d4