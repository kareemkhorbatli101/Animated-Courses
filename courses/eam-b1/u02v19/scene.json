"i":1,"at":99.862,"dur":4.104},{"i":0,"at":104.316,"dur":7.992},{"i":0,"at":112.658,"dur":6.48},{"i":0,"at":127.138,"dur":7.32}],"speech":[{"actor":"rana","start":0.45,"text":{"en":"Welcome to Auto Maintenance, Book 1. This is Unit 2, Under the Bonnet.","ar":"أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الثانية، تحت غطاء المحرّك."},"id":"L001"},{"actor":"rana","start":6.704,"text":{"en":"This is Part 9, a Local Case Study. You will hear an honest piece of advice, then decide yourself.","ar":"هذا الجزء التاسع، دراسة حالة محلّية. ستسمع نصيحة صادقة، ثمّ تقرّر بنفسك."},"id":"L002"},{"actor":"rana","start":14.158,"text":{"en":"Before you read: when a car needs a part, what two choices does a customer often have in Syria?","ar":"قبل أن تقرأ: عندما تحتاج سيارة قطعة، ما الخياران اللذان غالباً ما يكونان أمام الزبون في سوريا؟"},"id":"L003"},{"actor":"rana","start":20.724,"text":{"en":"A customer, Mr Aboud, came to Cham Motors for a service. His car needed a new air filter and a belt.","ar":"جاء زبون، السيّد عبود، إلى شام موتورز للصيانة. احتاجت سيارته فلتر هواء جديداً وسيراً."},"id":"L004"},{"actor":"rana","start":28.562,"text":{"en":"I explained that there were two choices. There were genuine parts from the carmaker, which cost more but lasted a long time.","ar":"شرحتُ أنّ هناك خيارين. هناك قطع أصليّة من صانع السيارة، تكلّف أكثر لكنّها تدوم وقتاً طويلاً."},"id":"L005"},{"actor":"rana","start":36.76,"text":{"en":"There were also cheaper parts, which cost less but sometimes wore out sooner.","ar":"وهناك أيضاً قطع أرخص، تكلّف أقلّ لكنّها تتلف أسرع أحياناً."},"id":"L006"},{"actor":"rana","start":42.006,"text":{"en":"In Syria, genuine parts are not always in the shop, and they can be expensive to import.","ar":"في سوريا، القطع الأصليّة ليست دائماً في المحل، وقد يكون استيرادها مكلفاً."},"id":"L007"},{"actor":"rana","start":48.14,"text":{"en":"I was honest. I said the genuine belt was the safest choice for a part that is very important, but for the air filter, a good cheaper part was fine.","ar":"كنتُ صادقة. قلتُ إنّ السير الأصلي هو الخيار الأكثر أماناً لقطعة مهمّة جدّاً، أمّا فلتر الهواء فقطعة أرخص جيّدة تكفي."},"id":"L008"},{"actor":"aboud","start":57.73,"text":{"en":"I trusted her advice and I was happy. Honest advice brings customers back.","ar":"وثقتُ بنصيحتها وكنتُ سعيداً. النصيحة الصادقة تعيد الزبائن."},"id":"L009"},{"actor":"aboud","start":64.584,"text":{"en":"What did Mr Aboud's car need?","ar":"ماذا احتاجت سيارة السيّد عبود؟"},"subHold":7.562,"id":"L010"},{"actor":"aboud","start":72.146,"text":{"en":"A new air filter and a belt.","ar":"فلتر هواء جديداً وسيراً."},"id":"L011"},{"actor":"aboud","start":75.76,"text":{"en":"What two choices did Rana explain?","ar":"أيّ خيارين شرحتهما رنا؟"},"subHold":8.024,"id":"L012"},{"actor":"aboud","start":83.784,"text":{"en":"Genuine parts, which cost more and last long, or cheaper parts, which cost less and wear sooner.","ar":"قطع أصليّة تكلّف أكثر وتدوم طويلاً، أو قطع أرخص تكلّف أقلّ وتتلف أسرع."},"id":"L013"},{"actor":"aboud","start":91.934,"text":{"en":"What did Rana advise for the belt?","ar":"بماذا نصحت رنا بشأن السير؟"},"subHold":7.928,"id":"L014"},{"actor":"aboud","start":99.862,"text":{"en":"The genuine belt - the safest choice for an important part.","ar":"السير الأصلي - الخيار الأكثر أماناً لقطعة مهمّة."},"id":"L015"},{"actor":"rana","start":104.316,"text":{"en":"Now your decision. A customer wants the cheapest parts for everything, even the brakes. What should the advisor do?","ar":"الآن قرارك. زبون يريد أرخص القطع لكلّ شيء، حتّى الفرامل. ماذا ينبغي أن يفعل المستشار؟"},"id":"L016"},{"actor":"rana","start":112.658,"text":{"en":"Sell only cheap parts, explain the difference and advise honestly, or refuse to serve the customer?","ar":"أن يبيع القطع الرخيصة فقط، أم يشرح الفرق وينصح بصدق، أم يرفض خدمة الزبون؟"},"subHold":14.48,"id":"L017"},{"actor":"rana","start":127.138,"text":{"en":"Explain the difference and advise honestly. For important parts like brakes, the safest choice is best.","ar":"أن يشرح الفرق وينصح بصدق. للقطع المهمّة مثل الفرامل، الخيار الأكثر أماناً هو الأفضل."},"id":"L018"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"8de7bf4a5083966f","bytes":35424,"sha":"c703d4edde5446a8","address":"lines/8de7bf4a5083966f.mp3"},{"key":"9a0fb5d65ec5ad81","bytes":42624,"sha":"20a19ddfd0821113","address":"lines/9a0fb5d65ec5ad81.mp3"},{"key":"d2b31304485200c0","bytes":37296,"sha":"0f1bdf906ea62bdb","address":"lines/d2b31304485200c0.mp3"},{"key":"c91df6b12731d1bf","bytes":44928,"sha":"c3691c62fe75d65e","address":"lines/c91df6b12731d1bf.mp3"},{"key":"39c53701990c6145","bytes":47088,"sha":"7828ce53d26c5a43","address":"lines/39c53701990c6145.mp3"},{"key":"562ce4593dfd87ff","bytes":29376,"sha":"b2e92a44065185e4","address":"lines/562ce4593dfd87ff.mp3"},{"key":"8913c0b62a5847bc","bytes":34704,"sha":"f4784109d2ba3b59","address":"lines/8913c0b62a5847bc.mp3"},{"key":"ceb5da9835cf9474","bytes":55440,"sha":"cbd2bd4fbcedf512","address":"lines/ceb5da9835cf9474.mp3"},{"key":"fa7387581d101e22","bytes":39024,"sha":"8745222c1443b4ed","address":"lines/fa7387581d101e22.mp3"},{"key":"f3e059d21d81c20d","bytes":17136,"sha":"41a668900940e023","address":"lines/f3e059d21d81c20d.mp3"},{"key":"9d54f5195eecc465","bytes":19584,"sha":"29c6483e1bc6bd99","address":"lines/9d54f5195eecc465.mp3"},{"key":"e62ecdc4f99551f0","bytes":18144,"sha":"cdf58bbf39e412bc","address":"lines/e62ecdc4f99551f0.mp3"},{"key":"6356ebd8afc9dffc","bytes":46800,"sha":"b923ade0eb448761","address":"lines/6356ebd8afc9dffc.mp3"},{"key":"e48e49ce94138437","bytes":17568,"sha":"f587eba07a0050c7","address":"lines/e48e49ce94138437.mp3"},{"key":"a95ab651866fc828","bytes":24624,"sha":"e2593a6230c2882c","address":"lines/a95ab651866fc828.mp3"},{"key":"f9d48d976d93cb16","bytes":47952,"sha":"63e7da01aa38c188","address":"lines/f9d48d976d93cb16.mp3"},{"key":"91a9961d306fcb92","bytes":38880,"sh