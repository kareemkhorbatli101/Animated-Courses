2.57,"text":{"en":"True or False. Nabil works in a bakery.","ar":"صح أم خطأ؟ نبيل يعمل في مخبز."},"id":"L006"},{"actor":"tarek","start":52.448,"text":{"en":"False. Nabil works in a workshop, at Cham Motors.","ar":"خطأ. نبيل يعمل في ورشة، في شام موتورز."},"id":"L007"},{"actor":"tarek","start":59.124,"text":{"en":"True or False. Nabil is changing the oil right now.","ar":"صح أم خطأ؟ نبيل يغيّر الزيت الآن."},"id":"L008"},{"actor":"tarek","start":70.236,"text":{"en":"True. He said, right now, I am changing the oil.","ar":"صح. قال: الآن، أنا أغيّر الزيت."},"id":"L009"},{"actor":"tarek","start":76.96,"text":{"en":"True or False. Nabil works alone.","ar":"صح أم خطأ؟ نبيل يعمل وحده."},"id":"L010"},{"actor":"tarek","start":86.173,"text":{"en":"False. He works with Tarek today.","ar":"خطأ. هو يعمل مع طارق اليوم."},"id":"L011"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"6c9a59e2c2d68c61","bytes":42048,"sha":"d72bbeda231f5c0e","address":"lines/6c9a59e2c2d68c61.mp3"},{"key":"fe19eb0b3c875769","bytes":30384,"sha":"070d3e00e5f66aa4","address":"lines/fe19eb0b3c875769.mp3"},{"key":"69b45c0084122ecb","bytes":31536,"sha":"c40f3de0c8febd72","address":"lines/69b45c0084122ecb.mp3"},{"key":"6515ae6506b63fd8","bytes":33264,"sha":"305f43702ea054ff","address":"lines/6515ae6506b63fd8.mp3"},{"key":"8fb3ab98a8048f2b","bytes":36288,"sha":"69cc23efe087a0bd","address":"lines/8fb3ab98a8048f2b.mp3"},{"key":"9d9bdd1a7e337c07","bytes":27504,"sha":"60c873ce2395a1e9","address":"lines/9d9bdd1a7e337c07.mp3"},{"key":"fa6704b84d1213e4","bytes":32256,"sha":"96df967d6777fc4d","address":"lines/fa6704b84d1213e4.mp3"},{"key":"0331ca67ebd95e80","bytes":30672,"sha":"67c670fa89797294","address":"lines/0331ca67ebd95e80.mp3"},{"key":"f7d2e1321da0f591","bytes":32544,"sha":"848a7f8fab577e79","address":"lines/f7d2e1321da0f591.mp3"},{"key":"750edecf1b26a150","bytes":25632,"sha":"5ec681401cf7f