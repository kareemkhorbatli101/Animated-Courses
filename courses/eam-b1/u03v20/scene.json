loves and glasses is called what?","ar":"معدّات الوقاية مثل القفّازات والنظّارات تُسمّى ماذا؟"},"subHold":9.576,"id":"L006"},{"actor":"maher","start":44.437,"text":{"en":"PPE.","ar":"معدّات الوقاية الشخصية."},"id":"L007"},{"actor":"maher","start":46.659,"text":{"en":"Blank your safety glasses. Which word, as an instruction?","ar":"فراغ نظّارات أمانك. أيّ كلمة، كتعليم؟"},"subHold":11.537,"id":"L008"},{"actor":"maher","start":58.196,"text":{"en":"Wear. Wear your safety glasses.","ar":"Wear. ارتدِ نظّارات أمانك."},"id":"L009"},{"actor":"maher","start":62.362,"text":{"en":"To show the last step, which word do we use?","ar":"لإظهار الخطوة الأخيرة، أيّ كلمة نستخدم؟"},"subHold":9.02,"id":"L010"},{"actor":"maher","start":71.382,"text":{"en":"Finally.","ar":"Finally. أخيراً."},"id":"L011"},{"actor":"maher","start":73.604,"text":{"en":"And from Unit 2: the fluid that keeps the engine cool is what?","ar":"ومن الوحدة الثانية: السائل الذي يبقي المحرّك بارداً هو ماذا؟"},"subHold":10.895,"id":"L012"},{"actor":"maher","start":84.499,"text":{"en":"Coolant.","ar":"سائل التبريد."},"id":"L013"},{"actor":"tarek","start":86.721,"text":{"en":"Five from five, and the last one came back from Unit 2. The words return, so they stay.","ar":"خمس من خمس، والأخيرة عادت من الوحدة الثانية. الكلمات تعود، فتبقى."},"id":"L014"},{"actor":"tarek","start":94.535,"text":{"en":"Now, quick! Name each thing.","ar":"الآن، بسرعة! سمِّ كلّ شيء."},"id":"L015"},{"actor":"tarek","start":98.917,"text":{"en":"What do you use to turn nuts and bolts?","ar":"بماذا تفكّ الصواميل والبراغي؟"},"subHold":8.342,"id":"L016"},{"actor":"tarek","start":107.259,"text":{"en":"A spanner.","ar":"مفتاح الربط."},"id":"L017"},{"actor":"tarek","start":109.361,"text":{"en":"And what is this box of round tool heads?","ar":"وما هذا الصندوق ذو الرؤوس المستديرة؟"},"subHold":8.7,"id":"L018"},{"actor":"tarek","start":118.061,"text":{"en":"A socket set.","ar":"طقم المفاتيح."},"id":"L019"},{"actor":"tarek","start":120.427,"text":{"en":"Which tool tightens a bolt to the exact level?","ar":"أيّ أداة تشدّ البرغي إلى الحدّ المضبوط؟"},"subHold":9.186,"id":"L020"},{"actor":"tarek","start":129.613,"text":{"en":"A torque wrench.","ar":"مفتاح العزم."},"id":"L021"},{"actor":"tarek","start":131.955,"text":{"en":"And what lifts the car?","ar":"وما الذي يرفع السيارة؟"},"subHold":6.609,"id":"L022"},{"actor":"tarek","start":138.564,"text":{"en":"A trolley jack.","ar":"الرافعة المتحرّكة."},"id":"L023"},{"actor":"tarek","start":140.978,"text":{"en":"What stops a wheel from rolling?","ar":"ما الذي يمنع العجلة من التدحرج؟"},"subHold":7.474,"id":"L024"},{"actor":"tarek","start":148.452,"text":{"en":"A wheel chock.","ar":"صادّ العجلة."},"id":"L025"},{"actor":"tarek","start":150.698,"text":{"en":"And what do you use to put out a fire?","ar":"وبماذا تُخمد الحريق؟"},"subHold":8.164,"id":"L026"},{"actor":"tarek","start":158.862,"text":{"en":"A fire extinguisher.","ar":"طفّاية الحريق."},"id":"L027"},{"actor":"tarek","start":161.588,"text":{"en":"Well done. You know the ten words of Unit 3.","ar":"أحسنت. أنت تعرف كلمات الوحدة الثالثة العشر."},"id":"L028"}],"subtitles":{"enabled":true,"langs":"en,ar","show":null,"lang":{}},"badgePlacement":{"x":"0.016","y":"0.016","width":"0.205"},"audio":{"master":"audio.m4a","lines":[{"key":"7e857b71e44102e2","bytes":39600,"sha":"314c489b22d0a336","address":"lines/7e857b71e44102e2.mp3"},{"key":"3e5db5c9eef4a102","bytes":45072,"sha":"1f0685d5c10d72f9","address":"lines/3e5db5c9eef4a102.mp3"},{"key":"bb5200b2107d5a9c","bytes":41904,"sha":"dfb190773f7fb423","address":"lines/bb5200b2107d5a9c.mp3"},{"key":"743ea292d1e826b5","bytes":22320,"sha":"f8765f9ee780c522","address":"lines/743ea292d1e826b5.mp3"},{"key":"ff1ef70c7a3a3b7f","bytes":12816,"sha":"465f7817afe4154b","address":"lines/ff1ef70c7a3a3b7f.mp3"},{"key":"5ac80b9f5bc77f3d","bytes":21456,"sha":"83e473ca8a0be735","address":"lines/5ac80b9f5bc77f3d.mp3"},{"key":"0b1efb134b437acc","bytes":11232,"sha":"90d1252fc0ace87d","address":"lines/0b1efb134b437acc