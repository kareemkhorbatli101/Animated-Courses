__pycache__/
*.pyc

# Delivery bundles. Each one is a zip of chapter .docx files that are already
# tracked individually, so committing it would put the same 36 documents in
# the repository twice. Rebuild one with:
#   zip CMA_Book1_Handouts_Ch01-18.zip CMA_B1_Ch*_Handouts.docx
CMA_Book1_Handouts_Ch01-18.zip
CMA_Book1_AnswerKeys_Ch01-18.zip

# Delivery bundles for Book 2 as well.
CMA_Book2_Handouts_Ch01-18.zip
CMA_Book2_AnswerKeys_Ch01-18.zip

# Delivery bundles for Book 3 as well.
CMA_Book3_Handouts_Ch01-18.zip
CMA_Book3_AnswerKeys_Ch01-18.zip

# And the one bundle that carries all four books at once. Same reason:
# the four whole-book .docx and the 72 per-chapter ones inside it are
# each tracked already. Rebuild it from those files; README.txt inside
# it says what it holds.
CMA_Part_1_Summary_Handouts.zip

# Rendered figures, keyed by the hash of the SVG that produced them. Every
# one is reproducible from the generator, and the directory is tens of
# megabytes, so it is a build artefact rather than source.
cma/wsart_cache/
cma/CMA_Summaries_*.docx
