   {
    "start": 0.45,
    "dur": 6.288,
    "en": "Nabil, let’s check the stock before the customers arrive. How much oil do we have?",
    "ar": "نبيل، لنتفقّد المخزون قبل وصول الزبائن. كم لدينا من الزيت؟"
   },
   {
    "start": 8.068,
    "dur": 3.336,
    "en": "There is plenty of oil, about ten litres.",
    "ar": "يوجد الكثير من الزيت — نحو عشرة لترات."
   },
   {
    "start": 12.734,
    "dur": 4.032,
    "en": "Good. How many oil filters are there?",
    "ar": "جيد. كم فلتر زيت يوجد؟"
   },
   {
    "start": 18.096,
    "dur": 2.376,
    "en": "There are only two left.",
    "ar": "لم يبقَ سوى اثنين."
   },
   {
    "start": 21.802,
    "dur": 6.6,
    "en": "That isn’t many. We have five services today. Please order ten.",
    "ar": "هذا قليل. لدينا خمس صيانات اليوم. من فضلك اطلب عشرة."
   },
   {
    "start": 29.732,
    "dur": 3.48,
    "en": "And there isn’t much coolant, only one bottle.",
    "ar": "وسائل التبريد قليل — زجاجة واحدة فقط."
   },
   {
    "start": 34.542,
    "dur": 5.736,
    "en": "Order some coolant too. We can’t service a car without the right parts.",
    "ar": "اطلب بعض سائل التبريد أيضاً. لا يمكننا صيانة سيارة دون القطع المناسبة."
   }
  ]
 },
