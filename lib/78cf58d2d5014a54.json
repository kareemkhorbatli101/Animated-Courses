   {
    "start": 0.45,
    "dur": 6.696,
    "en": "Welcome to English for Furniture Designers. This is Unit 4, Measuring and Dimensions.",
    "ar": "أهلاً بكم في الإنجليزية لمصمّمي الأثاث. هذه الوحدة الرابعة، القياس والأبعاد."
   },
   {
    "start": 7.496,
    "dur": 6.36,
    "en": "This is Part 1, Shapes Check. You will name four shapes and complete four sentences.",
    "ar": "هذا الجزء الأوّل، مراجعة الأشكال. ستسمّي أربعة أشكال وتكمل أربع جمل."
   },
   {
    "start": 14.206,
    "dur": 4.536,
    "en": "Four shapes first. Match each with its description.",
    "ar": "أربعة أشكال أوّلاً. طابِق كلّ واحد مع وصفه."
   },
   {
    "start": 19.092,
    "dur": 3.192,
    "en": "A square. Which description?",
    "ar": "المربّع. أيّ وصف؟"
   },
   {
    "start": 26.931,
    "dur": 2.136,
    "en": "Four equal sides.",
    "ar": "أربعة أضلاع متساوية."
   },
   {
    "start": 29.417,
    "dur": 3.384,
    "en": "A rectangle. Which description?",
    "ar": "المستطيل. أيّ وصف؟"
   },
   {
    "start": 37.625,
    "dur": 3.312,
    "en": "Two long sides and two short sides.",
    "ar": "ضلعان طويلان وضلعان قصيران."
   },
   {
    "start": 41.287,
    "dur": 3.168,
    "en": "A circle. Which description?",
    "ar": "الدائرة. أيّ وصف؟"
   },
   {
    "start": 49.102,
    "dur": 2.016,
    "en": "Perfectly round.",
    "ar": "مستديرة تماماً."
   },
   {
    "start": 51.468,
    "dur": 3.096,
    "en": "An oval. Which description?",
    "ar": "الشكل البيضوي. أيّ وصف؟"
   },
   {
    "start": 59.152,
    "dur": 2.136,
    "en": "Round, like an egg.",
    "ar": "مستدير، كالبيضة."
   },
   {
    "start": 61.638,
    "dur": 4.152,
    "en": "One description was not needed: three straight sides.",
    "ar": "بقي وصف لم نحتجه: ثلاثة أضلاع مستقيمة."
   },
   {
    "start": 66.14,
    "dur": 3.456,
    "en": "That is a triangle, and we rarely build one.",
    "ar": "ذاك مثلّث، ونادراً ما نصنع واحداً."
   },
   {
    "start": 69.946,
    "dur": 2.232,
    "en": "Now three questions.",
    "ar": "الآن ثلاثة أسئلة."
   },
   {
    "start": 72.528,
    "dur": 3.408,
    "en": "How many millimetres are in one centimetre?",
    "ar": "كم ميليمتراً في السنتيمتر الواحد؟"
   },
   {
    "start": 81.465,
    "dur": 1.872,
    "en": "D. Ten.",
    "ar": "د. عشرة."
   },
   {
    "start": 83.687,
    "dur": 2.904,
    "en": "What do we use to measure furniture?",
    "ar": "ماذا نستخدم لقياس الأثاث؟"
   },
   {
    "start": 91.709,
    "dur": 2.376,
    "en": "C. A measuring tape.",
    "ar": "ج. شريط قياس."
   },
   {
    "start": 94.435,
    "dur": 2.208,
    "en": "What is a cutting list?",
    "ar": "ما هي قائمة القصّ؟"
   },
   {
    "start": 100.996,
    "dur": 3.096,
    "en": "A. A list of pieces and their sizes.",
    "ar": "أ. قائمة بالقطع ومقاساتها."
   },
   {
    "start": 104.442,
    "dur": 3.024,
    "en": "Last, four sentences to complete.",
    "ar": "أخيراً، أربع جمل لإكمالها."
   },
   {
    "start": 107.816,
    "dur": 4.008,
    "en": "The blank of the sofa are two hundred by ninety by eighty.",
    "ar": "ـــ الكنبة مئتان في تسعين في ثمانين."
   },
   {
    "start": 118.236,
    "dur": 4.992,
    "en": "Dimensions. The dimensions of the sofa are those three numbers.",
    "ar": "الأبعاد. أبعاد الكنبة هي تلك الأرقام الثلاثة."
   },
   {
    "start": 123.578,
    "dur": 4.968,
    "en": "The blank of the table is one hundred and twenty, from side to side.",
    "ar": "ـــ الطاولة مئة وعشرون، من جانب إلى جانب."
   },
   {
    "start": 135.546,
    "dur": 4.656,
    "en": "Width. The width of the table is one hundred and twenty.",
    "ar": "العرض. عرض الطاولة مئة وعشرون."
   },
   {
    "start": 140.552,
    "dur": 4.416,
    "en": "The blank of the wardrobe is two hundred, from floor to top.",
    "ar": "ـــ الخزانة مئتان، من الأرض إلى الأعلى."
   },
   {
    "start": 151.497,
    "dur": 4.248,
    "en": "Height. The height of the wardrobe is two hundred.",
    "ar": "الارتفاع. ارتفاع الخزانة مئتان."
   },
   {
    "start": 156.095,
    "dur": 3.216,
    "en": "The carpenter writes every piece on the blank.",
    "ar": "يكتب النجّار كلّ قطعة على ـــ."
   },
   {
    "start": 165.017,
    "dur": 4.488,
    "en": "Cutting list. He writes every piece on the cutting list.",
    "ar": "قائمة القصّ. يكتب كلّ قطعة على قائمة القصّ."
   },
   {
    "start": 169.855,
    "dur": 5.376,
    "en": "Good. Now write two or three sentences about one piece at home.",
    "ar": "جيّد. الآن اكتب جملتين أو ثلاثاً عن قطعة في البيت."
   },
   {
    "start": 175.581,
    "dur": 2.448,
    "en": "Use two measurement words.",
    "ar": "استخدم كلمتي قياس."
   }
  ]
