   },
   {
    "start": 7.99,
    "dur": 5.112,
    "en": "This is Part 7, the Management File. It is optional.",
    "ar": "هذا الجزء السابع، ملفّ الإدارة. إنّه اختياري."
   },
   {
    "start": 13.452,
    "dur": 3.0,
    "en": "A manager welcomes a new apprentice.",
    "ar": "مدير يرحّب بمتدرّب جديد."
   },
   {
    "start": 16.802,
    "dur": 3.096,
    "en": "First, four things a manager says.",
    "ar": "أوّلاً، أربعة أشياء يقولها المدير."
   },
   {
    "start": 20.248,
    "dur": 4.104,
    "en": "Welcome to the team. What is it for?",
    "ar": "أهلاً بك في الفريق. ما الغرض منها؟"
   },
   {
    "start": 29.47,
    "dur": 2.256,
    "en": "Greeting a new worker.",
    "ar": "الترحيب بعامل جديد."
   },
   {
    "start": 32.076,
    "dur": 4.488,
    "en": "Let me show you the workshop. What is it for?",
    "ar": "دعني أريك الورشة. ما الغرض منها؟"
   },
   {
    "start": 42.211,
    "dur": 2.376,
    "en": "Showing someone around.",
    "ar": "أخذ شخص في جولة."
   },
   {
    "start": 44.937,
    "dur": 4.704,
    "en": "Always wear your safety glasses. What is it for?",
    "ar": "ارتدِ نظّارات الأمان دائماً. ما الغرض منها؟"
   },
   {
    "start": 55.464,
    "dur": 2.28,
    "en": "Giving a safety rule.",
    "ar": "إعطاء قاعدة أمان."
   },
   {
    "start": 58.094,
    "dur": 4.488,
    "en": "Ask me if you are not sure. What is it for?",
    "ar": "اسألني إذا لم تكن متأكّداً. ما الغرض منها؟"
   },
   {
    "start": 68.112,
    "dur": 2.52,
    "en": "Offering help and support.",
    "ar": "عرض المساعدة والدعم."
   },
   {
    "start": 70.982,
    "dur": 5.04,
    "en": "Before you listen. What does a manager say on the first day?",
    "ar": "قبل أن تستمع. ماذا يقول المدير في اليوم الأوّل؟"
   },
   {
    "start": 82.551,
    "dur": 3.696,
    "en": "He welcomes the new worker and gives the safety rules.",
    "ar": "يرحّب بالعامل الجديد ويعطي قواعد الأمان."
   },
   {
    "start": 86.597,
    "dur": 4.632,
    "en": "Good morning, Tarek. Welcome to Cham Motors.",
    "ar": "صباح الخير يا طارق. أهلاً بك في شام موتورز."
   },
   {
    "start": 91.579,
    "dur": 4.632,
    "en": "Nice to meet you. Have you worked in a garage before?",
    "ar": "تشرّفنا. هل عملت في كراج من قبل؟"
   },
   {
    "start": 96.561,
    "dur": 3.528,
    "en": "A little. I helped my uncle.",
    "ar": "قليلاً. ساعدت عمّي."
   },
   {
    "start": 100.439,
    "dur": 4.488,
    "en": "Good. This week, you watch Nabil and learn.",
    "ar": "جيّد. هذا الأسبوع، تشاهد نبيل وتتعلّم."
   },
   {
    "start": 105.277,
    "dur": 3.888,
    "en": "Always wear your safety glasses and gloves in the workshop,",
    "ar": "ارتدِ دائماً نظّارات الأمان والقفّازات في الورشة،"
   },
   {
    "start": 109.515,
    "dur": 2.568,
    "en": "and keep your area clean.",
    "ar": "وحافظ على مكانك نظيفاً."
   },
   {
    "start": 112.433,
    "dur": 2.376,
    "en": "Yes, Ustaz.",
    "ar": "نعم يا أستاذ."
   },
   {
    "start": 115.159,
    "dur": 5.016,
    "en": "If you are not sure, ask us. We work as a team here.",
    "ar": "إذا لم تكن متأكّداً، اسألنا. نعمل هنا كفريق."
   },
   {
    "start": 120.525,
    "dur": 3.816,
    "en": "Thank you. I am happy to be here.",
    "ar": "شكراً. أنا سعيد بوجودي هنا."
   },
   {
    "start": 124.691,
    "dur": 2.544,
    "en": "Now answer three questions.",
    "ar": "الآن أجب عن ثلاثة أسئلة."
   },
   {
    "start": 127.585,
    "dur": 2.616,
    "en": "What is Tarek doing this week?",
    "ar": "ماذا يفعل طارق هذا الأسبوع؟"
   },
   {
    "start": 134.966,
    "dur": 2.832,
    "en": "He is watching Nabil and learning.",
    "ar": "إنّه يشاهد نبيل ويتعلّم."
   },
   {
    "start": 138.148,
    "dur": 2.832,
    "en": "What safety rule does Nabil give?",
    "ar": "ما قاعدة الأمان التي يعطيها نبيل؟"
   },
   {
    "start": 145.921,
    "dur": 4.344,
    "en": "Always wear safety glasses and gloves, and keep the area clean.",
    "ar": "ارتدِ دائماً نظّارات الأمان والقفّازات، وحافظ على المكان نظيفاً."
   },
   {
    "start": 150.615,
    "dur": 3.024,
    "en": "What should Tarek do if he is not sure?",
    "ar": "ماذا يجب أن يفعل طارق إذا لم يكن متأكّداً؟"
   },
   {
    "start": 158.933,
    "dur": 1.968,
    "en": "Ask the team.",
    "ar": "أن يسأل الفريق."
   }
  ]
