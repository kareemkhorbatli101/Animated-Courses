  "cues": [
   {
    "start": 0.45,
    "dur": 3.216,
    "en": "Welcome to Auto Maintenance, Book 1.",
    "ar": "أهلاً بكم في صيانة السيارات، الكتاب الأوّل."
   },
   {
    "start": 4.016,
    "dur": 3.624,
    "en": "This is Unit 1, Introduction to the Vehicle.",
    "ar": "هذه الوحدة الأولى، مقدّمة إلى المركبة."
   },
   {
    "start": 7.99,
    "dur": 2.76,
    "en": "This is Part 5, Reading.",
    "ar": "هذا الجزء الخامس، القراءة."
   },
   {
    "start": 11.1,
    "dur": 3.408,
    "en": "Match the words, then say true or false.",
    "ar": "طابِق الكلمات، ثمّ قل صحيح أم خطأ."
   },
   {
    "start": 14.858,
    "dur": 3.912,
    "en": "First, match four words from the reading with their meanings.",
    "ar": "أوّلاً، طابِق أربع كلمات من القراءة مع معانيها."
   },
   {
    "start": 19.12,
    "dur": 3.624,
    "en": "Service. Which meaning is it?",
    "ar": "Service. أيّ معنى هو؟"
   },
   {
    "start": 27.45,
    "dur": 3.552,
    "en": "E. The regular check and care a car needs.",
    "ar": "هـ. الفحص والعناية المنتظمة التي تحتاجها السيارة."
   },
   {
    "start": 31.352,
    "dur": 3.72,
    "en": "Job card. Which meaning is it?",
    "ar": "Job card. أيّ معنى هو؟"
   },
   {
    "start": 39.837,
    "dur": 3.168,
    "en": "B. The paper that lists the work to do.",
    "ar": "ب. الورقة التي تذكر العمل المطلوب."
   },
   {
    "start": 43.355,
    "dur": 3.624,
    "en": "Workshop. Which meaning is it?",
    "ar": "Workshop. أيّ معنى هو؟"
   },
   {
    "start": 51.743,
    "dur": 3.336,
    "en": "A. The room where mechanics work on cars.",
    "ar": "أ. المكان الذي يعمل فيه الميكانيكيون على السيارات."
   },
   {
    "start": 55.429,
    "dur": 4.2,
    "en": "Diagnostic machine. Which meaning is it?",
    "ar": "Diagnostic machine. أيّ معنى هو؟"
   },
   {
    "start": 64.982,
    "dur": 2.928,
    "en": "D. A computer that finds faults.",
    "ar": "د. حاسوب يجد الأعطال."
   },
   {
    "start": 68.26,
    "dur": 4.032,
    "en": "One meaning is not needed. Which one?",
    "ar": "معنى واحد غير مطلوب. أيّ واحد؟"
   },
   {
    "start": 77.469,
    "dur": 2.928,
    "en": "C. A mirror for seeing behind.",
    "ar": "ج. مرآة للرؤية إلى الخلف."
   },
   {
    "start": 80.747,
    "dur": 2.544,
    "en": "Here are the words in the text.",
    "ar": "هذه هي الكلمات في النصّ."
   },
   {
    "start": 83.641,
    "dur": 2.568,
    "en": "Now, Cars in Syria.",
    "ar": "الآن، السيارات في سوريا."
   },
   {
    "start": 86.559,
    "dur": 5.592,
    "en": "Before you read. Why do people in Syria keep cars for many years?",
    "ar": "قبل أن تقرأ. لماذا يحتفظ الناس في سوريا بسياراتهم سنوات طويلة؟"
   },
   {
    "start": 98.974,
    "dur": 3.36,
    "en": "New cars are expensive and hard to import.",
    "ar": "السيارات الجديدة غالية وصعبة الاستيراد."
   },
   {
    "start": 102.684,
    "dur": 6.984,
    "en": "Here is an example. People in Syria keep cars for many years. True.",
    "ar": "هذا مثال. الناس في سوريا يحتفظون بسياراتهم سنوات طويلة. صحيح."
   },
   {
    "start": 110.018,
    "dur": 5.592,
    "en": "New cars are cheap and easy to import in Syria. True or false?",
    "ar": "السيارات الجديدة رخيصة وسهلة الاستيراد في سوريا. صحيح أم خطأ؟"
   },
   {
    "start": 122.257,
    "dur": 5.208,
    "en": "That is false. New cars are expensive and hard to import.",
    "ar": "هذا خطأ. السيارات الجديدة غالية وصعبة الاستيراد."
   },
   {
    "start": 127.815,
    "dur": 5.544,
    "en": "Dusty roads mean cars need regular servicing. True or false?",
    "ar": "الطرق المغبرّة تعني أنّ السيارات تحتاج صيانة منتظمة. صحيح أم خطأ؟"
   },
   {
    "start": 139.889,
    "dur": 5.664,
    "en": "True. Roads can be rough and dusty, so cars need regular servicing.",
    "ar": "صحيح. الطرق وعرة ومغبرّة، لذلك تحتاج السيارات صيانة منتظمة."
   },
   {
    "start": 145.903,
    "dur": 5.304,
    "en": "Old cars can still run well with good care. True or false?",
    "ar": "السيارات القديمة تعمل جيّداً مع العناية. صحيح أم خطأ؟"
   },
   {
    "start": 157.619,
    "dur": 5.28,
    "en": "True. Some cars in Syria are very old but still run well.",
    "ar": "صحيح. بعض السيارات في سوريا قديمة جدّاً لكنّها تعمل جيّداً."
   },
   {
    "start": 163.249,
    "dur": 5.064,
    "en": "Well done. Good care keeps a car running for many years.",
    "ar": "أحسنت. العناية الجيّدة تُبقي السيارة تعمل سنوات طويلة."
   }
  ]
 },
