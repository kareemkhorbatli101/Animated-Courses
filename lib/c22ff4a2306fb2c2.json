  "cues": [
   {
    "start": 0.45,
    "dur": 6.744,
    "en": "Welcome to Auto Maintenance, Book 1. This is Unit 1, Introduction to the Vehicle.",
    "ar": "أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الأولى، مقدّمة إلى المركبة."
   },
   {
    "start": 7.544,
    "dur": 6.528,
    "en": "This is the Warm Up. You will meet the workshop and learn the names of the main parts of a car.",
    "ar": "هذا هو التمهيد. ستتعرّف على الورشة وتتعلّم أسماء الأجزاء الرئيسية في السيارة."
   },
   {
    "start": 14.422,
    "dur": 4.512,
    "en": "Welcome to Cham Motors. This is our workshop.",
    "ar": "أهلاً بك في شام موتورز. هذه ورشتنا."
   },
   {
    "start": 19.284,
    "dur": 5.664,
    "en": "Today you will learn ten words. Look at each thing before I say its name.",
    "ar": "اليوم ستتعلّم عشر كلمات. انظر إلى كلّ شيء قبل أن أقول اسمه."
   },
   {
    "start": 25.298,
    "dur": 4.32,
    "en": "This is the engine. It makes the car move.",
    "ar": "هذا المحرّك. هو يجعل السيارة تتحرّك."
   },
   {
    "start": 29.968,
    "dur": 5.544,
    "en": "This is the battery. It stores electricity to start the car.",
    "ar": "هذه البطارية. تخزّن الكهرباء لتشغيل السيارة."
   },
   {
    "start": 35.862,
    "dur": 4.752,
    "en": "This is the radiator. It keeps the engine cool.",
    "ar": "هذا الراديتير. يبقي المحرّك بارداً."
   },
   {
    "start": 40.964,
    "dur": 5.208,
    "en": "This is the bonnet. In American English, we say hood.",
    "ar": "هذا غطاء المحرّك. في الإنجليزية الأمريكية نقول hood."
   },
   {
    "start": 46.522,
    "dur": 3.336,
    "en": "This is the boot, at the back of the car.",
    "ar": "هذا صندوق السيارة، في الخلف."
   },
   {
    "start": 50.208,
    "dur": 5.616,
    "en": "This is the job card. The service advisor writes it for every car.",
    "ar": "هذه بطاقة العمل. يكتبها مستشار الخدمة لكلّ سيارة."
   },
   {
    "start": 56.174,
    "dur": 5.016,
    "en": "A person who repairs and checks cars. What is the word?",
    "ar": "شخص يصلح ويفحص السيارات. ما الكلمة؟"
   },
   {
    "start": 67.425,
    "dur": 4.752,
    "en": "A mechanic. A mechanic repairs and checks cars.",
    "ar": "ميكانيكي. الميكانيكي يصلح ويفحص السيارات."
   },
   {
    "start": 72.527,
    "dur": 4.488,
    "en": "The car comes in for this every year. What is it?",
    "ar": "تأتي السيارة من أجله كلّ سنة. ما هو؟"
   },
   {
    "start": 82.898,
    "dur": 4.896,
    "en": "A service. The car comes in for a service every year.",
    "ar": "صيانة. تأتي السيارة للصيانة كلّ سنة."
   },
   {
    "start": 88.144,
    "dur": 2.4,
    "en": "Who writes the job card?",
    "ar": "من يكتب بطاقة العمل؟"
   },
   {
    "start": 94.956,
    "dur": 3.336,
    "en": "The service advisor writes the job card.",
    "ar": "مستشار الخدمة يكتب بطاقة العمل."
   },
   {
    "start": 98.642,
    "dur": 5.256,
    "en": "Good. Today, find the engine and the battery on one car.",
    "ar": "جيّد. اليوم، جد المحرّك والبطارية على سيارة واحدة."
   }
  ]
 },
