   },
   {
    "start": 4.016,
    "dur": 3.624,
    "en": "This is Unit 1, Introduction to the Vehicle.",
    "ar": "هذه الوحدة الأولى، مقدّمة إلى المركبة."
   },
   {
    "start": 7.99,
    "dur": 2.688,
    "en": "This is Part 6, Writing.",
    "ar": "هذا الجزء السادس، الكتابة."
   },
   {
    "start": 11.028,
    "dur": 2.568,
    "en": "Watch what each sentence does.",
    "ar": "شاهد ما تفعله كلّ جملة."
   },
   {
    "start": 13.946,
    "dur": 3.936,
    "en": "Part 6 asks you to describe your job, or a car.",
    "ar": "الجزء السادس يطلب منك أن تصف عملك أو سيارة."
   },
   {
    "start": 18.232,
    "dur": 2.856,
    "en": "Use fifty to seventy words.",
    "ar": "استخدم من خمسين إلى سبعين كلمة."
   },
   {
    "start": 21.438,
    "dur": 3.168,
    "en": "Here is a model I wrote from the book's plan.",
    "ar": "هذا نموذج كتبته من خطّة الكتاب."
   },
   {
    "start": 24.956,
    "dur": 2.88,
    "en": "I am a mechanic at Cham Motors.",
    "ar": "أنا ميكانيكي في شام موتورز."
   },
   {
    "start": 28.186,
    "dur": 2.76,
    "en": "The first sentence says who I am.",
    "ar": "الجملة الأولى تقول من أنا."
   },
   {
    "start": 31.296,
    "dur": 3.408,
    "en": "Every day, I service five or six cars.",
    "ar": "كلّ يوم، أصون خمس أو ستّ سيارات."
   },
   {
    "start": 35.054,
    "dur": 4.92,
    "en": "Every day, I service cars. Which tense is this?",
    "ar": "كلّ يوم، أصون السيارات. أيّ زمن هذا؟"
   },
   {
    "start": 45.739,
    "dur": 4.152,
    "en": "The present simple. It is a routine.",
    "ar": "المضارع البسيط. إنّه عمل يومي."
   },
   {
    "start": 50.241,
    "dur": 2.832,
    "en": "First, I read the job card.",
    "ar": "أوّلاً، أقرأ بطاقة العمل."
   },
   {
    "start": 53.423,
    "dur": 3.792,
    "en": "Then I check the engine, the battery and the tyres.",
    "ar": "ثمّ أفحص المحرّك والبطارية والإطارات."
   },
   {
    "start": 57.565,
    "dur": 3.12,
    "en": "First and then put the steps in order.",
    "ar": "«أوّلاً» و«ثمّ» ترتّبان الخطوات."
   },
   {
    "start": 61.035,
    "dur": 3.744,
    "en": "Right now, I am changing the oil in a small car.",
    "ar": "الآن، أغيّر الزيت في سيارة صغيرة."
   },
   {
    "start": 65.129,
    "dur": 5.064,
    "en": "Right now, I am changing the oil. Which tense is this?",
    "ar": "الآن، أغيّر الزيت. أيّ زمن هذا؟"
   },
   {
    "start": 76.369,
    "dur": 4.656,
    "en": "The present continuous. It is happening now.",
    "ar": "المضارع المستمر. يحدث الآن."
   },
   {
    "start": 81.375,
    "dur": 3.528,
    "en": "I like my job because I help people every day.",
    "ar": "أحبّ عملي لأنّي أساعد الناس كلّ يوم."
   },
   {
    "start": 85.253,
    "dur": 2.376,
    "en": "Which word gives the reason?",
    "ar": "أيّ كلمة تعطي السبب؟"
   },
   {
    "start": 92.276,
    "dur": 1.728,
    "en": "Because.",
    "ar": "لأنّ (because)."
   },
   {
    "start": 94.354,
    "dur": 4.728,
    "en": "That is fifty-one words, with one routine and one sentence about now.",
    "ar": "هذه إحدى وخمسون كلمة، فيها عمل يومي وجملة عن الآن."
   },
   {
    "start": 99.432,
    "dur": 2.184,
    "en": "Now it is your turn.",
    "ar": "الآن دورك."
   },
   {
    "start": 101.966,
    "dur": 3.84,
    "en": "Pause the video, and write about your job or a car.",
    "ar": "أوقف الفيديو، واكتب عن عملك أو عن سيارة."
   },
   {
    "start": 106.156,
    "dur": 3.0,
    "en": "The book has three more tasks for you.",
    "ar": "في الكتاب ثلاث مهامّ أخرى لك."
   },
   {
    "start": 109.506,
    "dur": 5.016,
    "en": "Why good servicing matters, a note to the mechanic, and a car in your family.",
    "ar": "لماذا الصيانة الجيّدة مهمّة، ورسالة إلى الميكانيكي، وسيارة في عائلتك."
   }
  ]
 },
