  "cues": [
   {
    "start": 0.45,
    "dur": 6.336,
    "en": "Welcome to Auto Maintenance, Book 1. This is Unit 2, Under the Bonnet.",
    "ar": "أهلاً بكم في صيانة السيارات، الكتاب الأوّل. هذه الوحدة الثانية، تحت غطاء المحرّك."
   },
   {
    "start": 7.136,
    "dur": 6.336,
    "en": "This is Part 1, Check What You Know. You will match the fluids and answer questions.",
    "ar": "هذا الجزء الأوّل، تحقّق ممّا تعرفه. ستطابق السوائل وتجيب عن أسئلة."
   },
   {
    "start": 13.822,
    "dur": 5.4,
    "en": "Now check what you know. Five fluids, and what each one does.",
    "ar": "الآن تحقّق ممّا تعرفه. خمسة سوائل، وماذا يفعل كلّ واحد."
   },
   {
    "start": 19.572,
    "dur": 2.256,
    "en": "What does engine oil do?",
    "ar": "ماذا يفعل زيت المحرّك؟"
   },
   {
    "start": 26.24,
    "dur": 3.312,
    "en": "It keeps the engine parts moving smoothly.",
    "ar": "يحافظ على حركة أجزاء المحرّك بسلاسة."
   },
   {
    "start": 29.902,
    "dur": 2.064,
    "en": "What does coolant do?",
    "ar": "ماذا يفعل سائل التبريد؟"
   },
   {
    "start": 36.201,
    "dur": 3.096,
    "en": "It stops the engine getting too hot.",
    "ar": "يمنع المحرّك من السخونة الشديدة."
   },
   {
    "start": 39.647,
    "dur": 2.448,
    "en": "What does brake fluid do?",
    "ar": "ماذا يفعل زيت الفرامل؟"
   },
   {
    "start": 46.566,
    "dur": 2.352,
    "en": "It makes the brakes work.",
    "ar": "يجعل الفرامل تعمل."
   },
   {
    "start": 49.268,
    "dur": 2.472,
    "en": "What does washer fluid do?",
    "ar": "ماذا يفعل سائل غسل الزجاج؟"
   },
   {
    "start": 56.269,
    "dur": 2.376,
    "en": "It cleans the windscreen.",
    "ar": "ينظّف الزجاج الأمامي."
   },
   {
    "start": 58.995,
    "dur": 2.688,
    "en": "What does the engine do with fuel?",
    "ar": "ماذا يفعل المحرّك بالوقود؟"
   },
   {
    "start": 66.683,
    "dur": 2.808,
    "en": "The engine burns it to make power.",
    "ar": "يحرقه المحرّك لتوليد القدرة."
   },
   {
    "start": 69.841,
    "dur": 6.144,
    "en": "What does the alternator do: makes electricity, cools the engine, or cleans the oil?",
    "ar": "ماذا يفعل الدينامو: يولّد الكهرباء، أم يبرّد المحرّك، أم ينظّف الزيت؟"
   },
   {
    "start": 83.926,
    "dur": 3.432,
    "en": "It makes electricity while the engine runs.",
    "ar": "يولّد الكهرباء أثناء دوران المحرّك."
   },
   {
    "start": 87.708,
    "dur": 2.568,
    "en": "What do you use a dipstick for?",
    "ar": "لماذا تستخدم مقياس الزيت؟"
   },
   {
    "start": 95.1,
    "dur": 2.376,
    "en": "To check the oil level.",
    "ar": "لفحص مستوى الزيت."
   },
   {
    "start": 97.826,
    "dur": 2.256,
    "en": "And what does coolant do?",
    "ar": "وماذا يفعل سائل التبريد؟"
   },
   {
    "start": 104.553,
    "dur": 3.048,
    "en": "It stops the engine getting too hot.",
    "ar": "يمنع المحرّك من السخونة الشديدة."
   },
   {
    "start": 107.951,
    "dur": 6.816,
    "en": "Last, four sentences. Choose oil, coolant, filter, or battery.",
    "ar": "أخيراً، أربع جمل. اختر الزيت أو سائل التبريد أو الفلتر أو البطارية."
   },
   {
    "start": 115.117,
    "dur": 2.88,
    "en": "Check the engine blank with the dipstick.",
    "ar": "افحص فراغ المحرّك بمقياس الزيت."
   },
   {
    "start": 123.408,
    "dur": 4.152,
    "en": "Oil. Check the engine oil with the dipstick.",
    "ar": "الزيت. افحص زيت المحرّك بمقياس الزيت."
   },
   {
    "start": 127.91,
    "dur": 2.688,
    "en": "The blank keeps the engine cool.",
    "ar": "الفراغ يبقي المحرّك بارداً."
   },
   {
    "start": 135.481,
    "dur": 2.76,
    "en": "The coolant keeps the engine cool.",
    "ar": "سائل التبريد يبقي المحرّك بارداً."
   },
   {
    "start": 138.591,
    "dur": 3.696,
    "en": "The air blank cleans the air going into the engine.",
    "ar": "فراغ الهواء ينظّف الهواء الداخل إلى المحرّك."
   },
   {
    "start": 148.287,
    "dur": 3.72,
    "en": "The air filter cleans the air going into the engine.",
    "ar": "فلتر الهواء ينظّف الهواء الداخل إلى المحرّك."
   },
   {
    "start": 152.357,
    "dur": 3.48,
    "en": "The blank stores electricity to start the car.",
    "ar": "الفراغ يخزّن الكهرباء لتشغيل السيارة."
   },
   {
    "start": 161.543,
    "dur": 3.552,
    "en": "The battery stores electricity to start the car.",
    "ar": "البطارية تخزّن الكهرباء لتشغيل السيارة."
   }
  ]
